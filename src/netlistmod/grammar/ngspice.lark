// ngspice overlay on core.lark (M2): opaque statements and blocks, the ngspice dot-name set, and
// the syntax only ngspice has (M8 decision 3): the "\\" continuation, the comma separator, RKM
// values, the keyword and model forms of R, C and L, and the forms recognised only to be rejected.
// %ignore is not carried by %import, so it is declared again here. Every core rule and terminal
// used by this dialect is imported by name, which keeps tree and token names unprefixed.

%import .core (start, first_line, line, body_line, statement, top_statement, title_stmt)
%import .core (unknown_stmt, rest, line_rest, end_stmt, trailer)
%import .core (WS, LINE_END, CONT, NL, TITLE_KW, TITLE_ARG, TITLE_TEXT, COMMENT_LINE)
%import .core (TRAILING_COMMENT, TEXT, QUOTED, END_KW, DOT_NAME)
%import .core (resistor, capacitor, inductor, mutual_coupling, voltage_source, current_source)
%import .core (diode, subckt_instance, x_node, x_last, x_name, x_param, eol, node, value, param)
%import .core (r_value, c_value, model, flag)
%import .core (inductor_ref, dc_spec, dc_after, dc_keyword, ac_spec, charge)
%import .core (_s0, _sd, _sam, _sa, _sdam, _sda, _sf, _sfd, _sfa, _sfam, _sfdam, _sfda, _line_end)
%import .core (_source_fn, stimulus, pwl_stimulus, fn_param, fn_list, fn_first, fn_arg, FN_PARAM_KW)
%import .core (SEP, CSEP, EQ, WORD, NUMBER, _MICRO)
%import .core (BRACE_FORMULA, QUOTE_FORMULA, STRING_VALUE, OFF_KW, R_NAME)
%import .core (C_NAME, L_NAME, K_NAME, L_REF, V_NAME)
%import .core (I_NAME, DC_KW, AC_KW, D_NAME, X_NAME, Q_KW)
%import .core (t_name, t_number, t_area, FIELD_NUMBER, Q_NAME, M_NAME, J_NAME, Z_NAME)
%import .core (ctl_ref, sw_state, ON_KW, E_NAME, G_NAME, F_NAME, H_NAME, S_NAME, W_NAME)
%import .core (PULSE_KW, EXP_KW, SFFM_KW, SIN_KW, PWL_KW)
%import .core (param_stmt, param_def, param_value, PARAM_KW, PARAM_NAME)
%import .core (model_stmt, model_paren, model_param_first, rparen, MODEL_KW, LPAR, RPAR)
%import .core (model_flag, model_flag_first, model_text, PCHAN_KW, NCHAN_KW, DOTTED_VALUE)
%import .core (subckt_def, subckt_header, subckt_port, subckt_item, not_in_subckt, ends_line)
%import .core (SUBCKT_KW, ENDS_KW, ZERO_PORT)
%import .core (tran_stmt, uic, TRAN_KW, UIC_KW, ac_stmt, ac_variation, DOT_AC_KW, DEC_KW)
%import .core (OCT_KW, LIN_KW, dc_stmt, dc_sweep, DOT_DC_KW, op_stmt, OP_KW)
%import .core (options_stmt, option_item, OPTIONS_KW, OPTION_KW, temp_stmt, TEMP_KW)
%import .core (ic_stmt, nodeset_stmt, node_condition, IC_KW, NODESET_KW, V_OPEN)
%import .core (save_stmt, output_vector, SAVE_KW, voltage_vector)
%import .core (current_vector, VOLTAGE_OPEN, CURRENT_OPEN)
%import .core (meas_stmt, meas_analysis, meas_body, MEAS_KW, MEASURE_KW, TRAN_ANALYSIS_KW)
%import .core (global_stmt, GLOBAL_KW)

%ignore WS
%ignore CONT

// Element lines of the phase 1 letters (M3, decision 0004); other letters stay errors. They
// extend `body_line` directly rather than `statement`, which saves a unit reduction per line.
// spec: NG-STR-001
%extend body_line: resistor
                 | capacitor
                 | inductor
                 | mutual_coupling
                 | voltage_source
                 | current_source
                 | diode
                 | subckt_instance

// .include and .lib cannot be continued (manual §2.4.5): they end with LINE_END, not NL.
// A .lib line opens an opaque block when it has one field and an .endl follows before the next
// one-field .lib or .end (decision 0012). A two-field .lib may stand in the body, and any other
// .lib stays lib_stmt. The body is never read, so its lines are not topology. A "+" line is an
// ignored continuation, so one line of the body may hold several texts.
// spec: NG-OPA-002
%extend statement: include_stmt
                 | lib_stmt
                 | lib_block
include_stmt: INCLUDE_KW line_rest LINE_END
lib_stmt: LIB_KW line_rest LINE_END
lib_block: LIB_BLOCK_KW BLOCK_TEXT? NL lib_line* ENDL_KW BLOCK_TEXT? NL
lib_line: (BLOCK_DOT_NAME | BLOCK_TEXT) BLOCK_TEXT* NL
        | LINE_END

// A .control block is top-level only; inside a subcircuit it is recognised and rejected
// (decision 0005). An .if block may stand in a subcircuit body.
// spec: NG-OPA-001
%extend top_statement: control_block
%extend statement: if_block
%extend not_in_subckt: control_block
control_block: CONTROL_KW BLOCK_TEXT? NL control_line* ENDC_KW BLOCK_TEXT? NL
control_line: BLOCK_DOT_NAME BLOCK_TEXT? NL
            | BLOCK_TEXT NL
            | LINE_END
if_block: IF_KW BLOCK_TEXT? NL if_line* ENDIF_KW BLOCK_TEXT? NL
if_line: BLOCK_DOT_NAME BLOCK_TEXT? NL
       | BLOCK_TEXT NL
       | LINE_END
       | if_block

// spec: NG-OPA-002
INCLUDE_KW.4: ".include"i
LIB_KW.4: ".lib"i
LIB_BLOCK_KW.5: /\.lib(?=[ \t]+[^ \t\r\n;$]+[ \t]*(?:(?:[;$]|\/\/)[^\r\n]*)?\r?\n(?:(?![ \t]*\.(?:end(?![a-z0-9_-])|lib[ \t]+[^ \t\r\n;$]+[ \t]*(?:(?:[;$]|\/\/)[^\r\n]*)?\r?\n))(?:[^\r\n]|\r(?!\r?\n))*\r?\n)*?[ \t]*\.endl(?![a-z0-9_-]))/i
ENDL_KW.4: ".endl"i

// spec: NG-OPA-001
CONTROL_KW.4: ".control"i
ENDC_KW.4: ".endc"i
IF_KW.4: ".if"i
ENDIF_KW.4: ".endif"i
BLOCK_DOT_NAME.4: /\.[a-z][a-z0-9_-]*/i
BLOCK_TEXT.2: /[^ \t\r\n](?:[^\r\n]|\r(?!\r?\n))*/

// Outside a block, a block delimiter name is not a directive: a stray .endc, .endif, .else,
// .elseif or .ends at the top level must be a syntax error. Inside a subcircuit body .ends is
// ENDS_KW, which DOT_NAME then no longer shadows.
// spec: NG-DIR-001
%override DOT_NAME.4: /\.(?!(?:endc|endif|else|elseif|ends)(?![a-z0-9_-]))[a-z][a-z0-9_-]*/i

// Backslash continuation (manual §2.4.5): "\\" immediately before LF or CRLF. The lookahead
// requires the next line to start with statement text, so a blank line, a comment line, a "+"
// line or an end-of-line comment after "\\" is an error. TEXT never consumes these backslashes.
// BS_CONT is a token, not an ignored terminal, so it is recognised only inside a continuable
// statement; a line holding only "\\" is a syntax error, not silently dropped. It is a gap token,
// and so is the comma (CSEP), so each field rule below gains them.
// spec: NG-CNT-001
BS_CONT.7: /\\\\\r?\n(?=[ \t]*(?![*+;$]|\/\/)[^ \t\r\n])/

// spec: NG-TXT-001
%override rest: (TEXT | QUOTED | TRAILING_COMMENT | BS_CONT)*

// End-of-line comments start at ";", "$" or "//", with or without whitespace before them, and
// run to the end of the line, so quotes inside a comment are plain text. TEXT stops before any
// of the three markers; a single "/" (as in a path) is ordinary text. TEXT also stops before a
// "\\" that ends the line (BS_CONT); other backslashes, and "\\" followed by spaces, are text.
// spec: NG-TXT-001
%override TRAILING_COMMENT.3: /(?:[;$]|\/\/)(?:[^\r\n]|\r(?!\r?\n))*/
%override TEXT.2: /(?:[^ \t\r\n;$'"\/\\]|\/(?!\/)|\\(?!\\\r?\n))(?:[^\r\n;$'"\/\\]|\/(?!\/)|\\(?!\\\r?\n)|\r(?!\r?\n))*/

// spec: NG-FLD-001
%extend eol: BS_CONT (NL | eol)

// The characters the manual excludes from node names (= % ( ) , [ ] < > ~ { } '), the comment
// starters ; $ and //, a double quote and a backslash are not name characters. A "/" is allowed
// when another name character follows it, so "//" always starts a comment and a name cannot end
// in "/". Lark inlines sub-terminals at import, so each name terminal is overridden, not _WUNIT.
// spec: NG-NOD-001
_NG_CHAR: /[^ \t\r\n=%(),\[\]<>~{}'";$\\\/]/
_NG_UNIT: _NG_CHAR | "/" _NG_CHAR
%override WORD.2: _NG_UNIT+
%extend node: (CSEP | BS_CONT) WORD
            | BS_CONT node

// RKM notation (IEC 60062): digits, a code letter in place of the decimal point, digits; for R
// also a leading R or L (R47). E is not a code letter, so 4E7 stays an exponent. RKM_R_MEGA
// (uppercase M on R) and RKM_C_FARAD (F on C) are the forms ngspice reads differently from the
// standard. RKM_R_MILLI (lowercase m on R) is always rejected, with a hint to use L. Whether RKM
// is accepted is the parser option rkm, applied by the transformer; the grammar does not change.
// spec: NG-NUM-003
RKM_R.4: /[0-9]+[RrKkGgTtLl][0-9]+|[RrLl][0-9]+/
RKM_R_MEGA.4: /[0-9]+M[0-9]+/
RKM_R_MILLI.4: /[0-9]+m[0-9]+/
RKM_C.4: /[0-9]+/ (/[pPnNuUmM]/ | _MICRO) /[0-9]+/
RKM_C_FARAD.4: /[0-9]+[fF][0-9]+/
%extend r_value: SEP (RKM_R | RKM_R_MEGA | RKM_R_MILLI)
               | (CSEP | BS_CONT) (NUMBER | RKM_R | RKM_R_MEGA | RKM_R_MILLI | BRACE_FORMULA | QUOTE_FORMULA)
               | BS_CONT r_value
%extend c_value: SEP (RKM_C | RKM_C_FARAD)
               | (CSEP | BS_CONT) (NUMBER | RKM_C | RKM_C_FARAD | BRACE_FORMULA | QUOTE_FORMULA)
               | BS_CONT c_value

// spec: NG-VAL-001
%extend value: (CSEP | BS_CONT) (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
             | BS_CONT value

// spec: NG-PAR-001
%extend param: (CSEP | BS_CONT) WORD EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
             | BS_CONT param
%extend model: (CSEP | BS_CONT) WORD
             | BS_CONT model
%extend flag: (CSEP | BS_CONT) OFF_KW
            | BS_CONT flag

// spec: NG-RES-001
%override R_NAME.4: /[Rr]/ _NG_UNIT*
%extend resistor: R_NAME node node r_value model param* (NL | eol)
                | R_NAME node node model param* (NL | eol)
                | R_NAME node node r_keyword_value param* (NL | eol)
r_keyword_value: (SEP | CSEP | BS_CONT) (R_KW | RESISTANCE_KW) EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
               | (SEP | TRAILING_COMMENT | BS_CONT) r_keyword_value
R_KW.2: "r"i
RESISTANCE_KW.2: "resistance"i

// spec: NG-CAP-001
%override C_NAME.4: /[Cc]/ _NG_UNIT*
%extend capacitor: C_NAME node node c_value model param* (NL | eol)
                 | C_NAME node node model param* (NL | eol)
                 | C_NAME node node c_keyword_value param* (NL | eol)
c_keyword_value: (SEP | CSEP | BS_CONT) (C_KW | CAPACITANCE_KW) EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
               | (SEP | TRAILING_COMMENT | BS_CONT) c_keyword_value
C_KW.2: "c"i
CAPACITANCE_KW.2: "capacitance"i

// spec: NG-IND-001
%override L_NAME.4: /[Ll]/ _NG_UNIT*
%extend inductor: L_NAME node node value model param* (NL | eol)
                | L_NAME node node model param* (NL | eol)
                | L_NAME node node l_keyword_value param* (NL | eol)
l_keyword_value: (SEP | CSEP | BS_CONT) (L_KW | INDUCTANCE_KW) EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
               | (SEP | TRAILING_COMMENT | BS_CONT) l_keyword_value
L_KW.2: "l"i
INDUCTANCE_KW.2: "inductance"i

// spec: NG-MUT-001
%override K_NAME.4: /[Kk]/ _NG_UNIT*
%override L_REF.4: /[Ll]/ _NG_UNIT*
%extend inductor_ref: (CSEP | BS_CONT) L_REF
                    | BS_CONT inductor_ref

// spec: NG-SRC-001
%override V_NAME.4: /[Vv]/ _NG_UNIT*
%override I_NAME.4: /[Ii]/ _NG_UNIT*
%extend dc_keyword: (CSEP | BS_CONT) DC_KW
                  | BS_CONT dc_keyword
%extend ac_spec: (CSEP | BS_CONT) AC_KW value
               | BS_CONT ac_spec

// spec: NG-SUB-001
%override X_NAME.4: /[Xx]/ _NG_UNIT*
%extend x_last: x_name x_param* params_keyword
%extend x_name: (CSEP | BS_CONT) WORD
              | BS_CONT x_name
%extend x_param: (CSEP | BS_CONT) WORD EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA | STRING_VALUE)
               | BS_CONT x_param

// A line may end in distortion inputs, and a V line in RF port parameters, written with a blank or
// "=" (manual §4.1, §4.1.11). A distortion input's magnitude and phase are optional, and each is a
// plain value after its keyword. The rules are right-linear, as for the rest of a source line.
// spec: NG-FUN-001
%override voltage_source: V_NAME node node _s0{fn_param, _ng_end}
%override current_source: I_NAME node node _s0{fn_param, _ng_end}
%override FN_PARAM_KW.2: /(?:r|td|m)(?=[ \t]*=)/i
%extend fn_param: (CSEP | BS_CONT) FN_PARAM_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
                | BS_CONT fn_param
%extend stimulus: SEP (AM_KW | TRNOISE_KW | TRRANDOM_KW | SINE_KW) fn_list
                | (CSEP | BS_CONT) (PULSE_KW | EXP_KW | SFFM_KW | SIN_KW | AM_KW | TRNOISE_KW | TRRANDOM_KW | SINE_KW) fn_list
                | BS_CONT stimulus
%extend fn_list: BS_CONT fn_list
%extend fn_first: BS_CONT fn_first
%extend fn_arg: BS_CONT (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
              | BS_CONT fn_arg

// A PWL takes r= and td= after its list (manual §4.1.4). fn_param reaches any function, and the
// transformer reports r=, td= or m= on the wrong one.
// spec: NG-FUN-005
%extend pwl_stimulus: (CSEP | BS_CONT) PWL_KW fn_list
                    | BS_CONT pwl_stimulus

// SINE is not in the manual; ngspice 47 reads it as SIN. The one exception to decision 0002's rule
// that solver behaviour does not widen the manual (decision 0013).
// spec: NG-FUN-003
SINE_KW.2: "sine"i

// spec: NG-FUN-007
AM_KW.2: "am"i

// spec: NG-FUN-008
TRNOISE_KW.2: "trnoise"i

// spec: NG-FUN-009
TRRANDOM_KW.2: "trrandom"i

// EXTERNAL takes no list, and an optional m= (manual §4.1.9).
// spec: NG-FUN-010
%extend _source_fn: external_kw
external_kw: (SEP | CSEP | BS_CONT) EXTERNAL_KW
           | (SEP | TRAILING_COMMENT | BS_CONT) external_kw
EXTERNAL_KW.2: "external"i

// spec: NG-FUN-011
_ng_end: distof1_kw _dm1 | distof2_kw _dm2 | _ng_port
_dm1: value _dp1 | _dt1
_dp1: value _dt1 | _dt1
_dt1: distof2_kw _dm2 | _ng_port
_dm2: value _dp2 | _ng_port
_dp2: value _ng_port | _ng_port
distof1_kw: (SEP | CSEP | BS_CONT) DISTOF1_KW
          | (SEP | TRAILING_COMMENT | BS_CONT) distof1_kw
distof2_kw: (SEP | CSEP | BS_CONT) DISTOF2_KW
          | (SEP | TRAILING_COMMENT | BS_CONT) distof2_kw
DISTOF1_KW.2: "distof1"i
DISTOF2_KW.2: "distof2"i

// The transformer reports these on an I line: the manual gives them to VSRC only.
// spec: NG-FUN-012
_ng_port: port_param _ng_port | _line_end
port_param: (SEP | CSEP | BS_CONT) PORT_KW (EQ | SEP) (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
          | (SEP | TRAILING_COMMENT | BS_CONT) port_param
PORT_KW.2: /portnum|z0/i

// Forms recognised only to be rejected: the charge form of a behavioral capacitor
// (UnsupportedConstruct), and the HSPICE "params:" keyword on a subcircuit call or definition
// (ParseError). Their arguments are statement text up to the line end.
// spec: NG-UNS-001
%extend charge: (CSEP | BS_CONT) Q_KW EQ rest NL
              | BS_CONT charge
params_keyword: (SEP | CSEP | BS_CONT) PARAMS_KW rest NL
              | (SEP | TRAILING_COMMENT | BS_CONT) params_keyword
PARAMS_KW.2: "params:"i

// A bare expression is recognised (BARE_EXPR, the lowest priority, tried after every value
// terminal) only to be rejected with a hint to use braces: in place of a value, glued to a number
// (a+1k, 1k+a), or as a field after a value (123 * 3). The reserved names time, temper and hertz
// are rejected. Names may hold ! # % [ ] (§2.11.1).
// spec: NG-PRM-001
%extend param_stmt: PARAM_KW param_def+ bare_tail
%extend param_def: SEP (TIME_KW | TEMPER_KW | HERTZ_KW) EQ param_value
                 | BS_CONT (PARAM_NAME | TIME_KW | TEMPER_KW | HERTZ_KW) EQ param_value
                 | BS_CONT param_def
%extend param_value: BARE_EXPR -> bare_value
                   | NUMBER BARE_EXPR -> bare_value
bare_tail: (SEP | BS_CONT) BARE_EXPR rest NL
         | (SEP | TRAILING_COMMENT | BS_CONT) bare_tail
%override PARAM_NAME.2: /[A-Za-z][A-Za-z0-9_!#%\[\]]*/
TIME_KW.2: "time"i
TEMPER_KW.2: "temper"i
HERTZ_KW.2: "hertz"i
BARE_EXPR.1: /(?:[^ \t\r\n;$\\\/'"{}]|\/[^ \t\r\n;$\\\/'"{}])+/

// spec: NG-DIO-001
%override D_NAME.4: /[Dd]/ _NG_UNIT*

// spec: NG-XTR-001
%extend body_line: bjt
                 | mosfet
                 | jfet
                 | mesfet
%extend t_name: (CSEP | BS_CONT) WORD
              | BS_CONT t_name
%extend t_number: (CSEP | BS_CONT) FIELD_NUMBER
                | BS_CONT t_number
%extend t_area: (CSEP | BS_CONT) (FIELD_NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
              | BS_CONT t_area
ic_param: (SEP | CSEP | BS_CONT) IC_PARAM_KW EQ _ic_value (IC_COMMA _ic_value)*
        | (SEP | TRAILING_COMMENT | BS_CONT) ic_param
_ic_value: NUMBER | BRACE_FORMULA | QUOTE_FORMULA
IC_PARAM_KW.3: /ic(?=[ \t]*=)/i
// A comma before another value of the list; a comma before a name separates the next field.
IC_COMMA.12: /[ \t]*,[ \t]*(?=[-+.0-9{'])/

// Q: 3 to 5 nodes (substrate, then VBIC's junction temperature node); the area is named, as
// area=, areab= and areac= (§7.3.1). The last three alternatives read a number after the model,
// a positional area that ngspice 47 runs, only so that the transformer refuses it with one
// message (decision 0014 item 5; review R2).
// spec: NG-BJT-001
bjt: Q_NAME node node node t_name _ng_ttail
   | Q_NAME node node node (t_name | t_number) t_name _ng_ttail
   | Q_NAME node node node (t_name | t_number) (t_name | t_number) t_name _ng_ttail
   | Q_NAME node node node t_name t_number _ng_ttail
   | Q_NAME node node node (t_name | t_number) t_name t_number _ng_ttail
   | Q_NAME node node node (t_name | t_number) (t_name | t_number) t_name t_number _ng_ttail
_ng_ttail: (param | ic_param | flag)* (NL | eol)
%override Q_NAME.4: /[Qq]/ _NG_UNIT*

// M: 3 to 5 nodes (VDMOS 3, MOSFET 4, VDMOS with its thermal nodes 5); VDMOS's thermal flag
// (§7.6.1, §7.6.3).
// spec: NG-MOS-001
mosfet: M_NAME node node node t_name _ng_mtail
      | M_NAME node node node (t_name | t_number) t_name _ng_mtail
      | M_NAME node node node (t_name | t_number) (t_name | t_number) t_name _ng_mtail
_ng_mtail: (param | ic_param | flag | thermal_flag)* (NL | eol)
thermal_flag: (SEP | CSEP | BS_CONT) THERMAL_KW
            | (SEP | TRAILING_COMMENT | BS_CONT) thermal_flag
THERMAL_KW.2: "thermal"i
%override M_NAME.4: /[Mm]/ _NG_UNIT*

// J: 3 nodes, then a positional area (§7.4.1).
// spec: NG-JFT-001
jfet: J_NAME node node node t_name t_area? _ng_ttail
%override J_NAME.4: /[Jj]/ _NG_UNIT*

// Z: 3 nodes, then a positional area (§7.5.1).
// spec: NG-MES-001
mesfet: Z_NAME node node node t_name t_area? _ng_ttail
%override Z_NAME.4: /[Zz]/ _NG_UNIT*

// Linear dependent sources and switches (§4.2, §3.3.15; decision 0015). The gain is one value;
// F and G take m= (§4.2.1, §4.2.3), E and H nothing. The nonlinear forms of §5 (vol=, cur=,
// VALUE, TABLE, POLY) are recognised after the output nodes only to be reported as unsupported
// (M15); their text runs to the line end.
// spec: NG-CTL-001
%extend body_line: vcvs
                 | vccs
                 | cccs
                 | ccvs
                 | vswitch
                 | cswitch
%extend ctl_ref: (CSEP | BS_CONT) WORD
               | BS_CONT ctl_ref
%extend sw_state: (CSEP | BS_CONT) (ON_KW | OFF_KW)
                | BS_CONT sw_state
ctl_m: (SEP | CSEP | BS_CONT) CTL_M_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
     | (SEP | TRAILING_COMMENT | BS_CONT) ctl_m
CTL_M_KW.3: /m(?=[ \t]*=)/i
nonlinear_form: (SEP | CSEP | BS_CONT) (VC_FORM_KW | CC_FORM_KW) rest NL
              | (SEP | TRAILING_COMMENT | BS_CONT) nonlinear_form
cc_form: (SEP | CSEP | BS_CONT) CC_FORM_KW rest NL
       | (SEP | TRAILING_COMMENT | BS_CONT) cc_form
VC_FORM_KW.3: /(?:vol|cur|value)[ \t]*(?==)|table[ \t]*(?=[{'])/i
CC_FORM_KW.3: /poly[ \t]*(?=\()/i
// Gain forms that ngspice runs and the library refuses, recognised only so that each gets its own
// message (decision 0015 item 6): gain= in the gain's place, and a second value after the gain.
gain_keyword: (SEP | CSEP | BS_CONT) GAIN_KW rest NL
            | (SEP | TRAILING_COMMENT | BS_CONT) gain_keyword
second_value: (SEP | CSEP | BS_CONT) (NUMBER | BRACE_FORMULA | QUOTE_FORMULA) rest NL
            | (SEP | TRAILING_COMMENT | BS_CONT) second_value
GAIN_KW.3: /gain[ \t]*(?==)/i

// spec: NG-VCV-001
vcvs: E_NAME node node node node value (NL | eol)
    | E_NAME node node node node value second_value
    | E_NAME node node node node gain_keyword
    | E_NAME node node nonlinear_form
%override E_NAME.4: /[Ee]/ _NG_UNIT*

// spec: NG-VCC-001
vccs: G_NAME node node node node value ctl_m? (NL | eol)
    | G_NAME node node node node value second_value
    | G_NAME node node node node gain_keyword
    | G_NAME node node nonlinear_form
%override G_NAME.4: /[Gg]/ _NG_UNIT*

// spec: NG-CCC-001
cccs: F_NAME node node ctl_ref value ctl_m? (NL | eol)
    | F_NAME node node ctl_ref value second_value
    | F_NAME node node ctl_ref gain_keyword
    | F_NAME node node cc_form
%override F_NAME.4: /[Ff]/ _NG_UNIT*

// spec: NG-CCV-001
ccvs: H_NAME node node ctl_ref value (NL | eol)
    | H_NAME node node ctl_ref value second_value
    | H_NAME node node ctl_ref gain_keyword
    | H_NAME node node cc_form
%override H_NAME.4: /[Hh]/ _NG_UNIT*

// S: four nodes, the model, then ON or OFF (§3.3.15).
// spec: NG-SWV-001
vswitch: S_NAME node node node node model sw_state? (NL | eol)
%override S_NAME.4: /[Ss]/ _NG_UNIT*

// spec: NG-SWC-001
cswitch: W_NAME node node ctl_ref model sw_state? (NL | eol)
%override W_NAME.4: /[Ww]/ _NG_UNIT*

// spec: NG-MOD-001
%extend model_paren: BS_CONT model_paren
%extend model_param_first: BS_CONT model_param_first
%extend rparen: BS_CONT rparen
%extend model_flag: (CSEP | BS_CONT) (PCHAN_KW | NCHAN_KW)
                  | BS_CONT model_flag
%extend model_flag_first: BS_CONT model_flag_first
%extend model_text: (CSEP | BS_CONT) WORD EQ DOTTED_VALUE
                  | BS_CONT model_text

// "params:" is rejected as on an X line.
// spec: NG-SBD-001
%extend subckt_header: SUBCKT_KW x_name subckt_port+ x_param* params_keyword
%extend subckt_port: (CSEP | BS_CONT) (WORD | ZERO_PORT)
                   | BS_CONT subckt_port

// spec: NG-TRN-001
%extend uic: (CSEP | BS_CONT) UIC_KW
           | BS_CONT uic

// spec: NG-ACA-001
%extend ac_variation: (CSEP | BS_CONT) (DEC_KW | OCT_KW | LIN_KW)
                    | BS_CONT ac_variation

// spec: NG-OPT-001
%extend option_item: (CSEP | BS_CONT) WORD (EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA | WORD))?
                   | BS_CONT option_item

// .nodeset also takes all=value (§11.2.1).
// spec: NG-ICN-001
%extend nodeset_stmt: NODESET_KW nodeset_all (NL | eol)
%extend node_condition: (CSEP | BS_CONT) V_OPEN WORD RPAR EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
                      | BS_CONT node_condition
nodeset_all: (SEP | CSEP | BS_CONT) ALL_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
           | (SEP | TRAILING_COMMENT | BS_CONT) nodeset_all
ALL_KW.2: "all"i

// .save vectors (§11.6.1) also take @dev[param] or a name (which includes src#branch and all).
// Each vector is one token, kept as text. Alternatives are tried in order, so the bracketed forms
// are matched before a plain name.
// spec: NG-SAV-001
%extend output_vector: SEP OUTPUT_VECTOR
                     | (CSEP | BS_CONT) (OUTPUT_VECTOR | voltage_vector | current_vector)
                     | BS_CONT output_vector
OUTPUT_VECTOR.2: "@" _NG_UNIT+ "[" _NG_UNIT+ "]" | _NG_UNIT+

// The AC variants of §11.6.2: VR, VI, VM, VP and VDB. The function and "(" are one token, at a
// higher priority than the plain name, so "vm(" is a function while "vm" alone is a name. The I
// variants (IR, II, IM, IP, IDB) are "not yet implemented" (§11.6.2): recognised only to be
// rejected.
// spec: NG-SAV-001
%override VOLTAGE_OPEN.3: /(?:v|vr|vi|vm|vp|vdb)\(/i
%extend current_vector: CURRENT_VARIANT_OPEN WORD (CSEP WORD)? RPAR
CURRENT_VARIANT_OPEN.3: /i(?:r|i|m|p|db)\(/i

// spec: NG-MEA-001
%extend meas_analysis: SEP SP_KW
                     | (CSEP | BS_CONT) (DC_KW | AC_KW | TRAN_ANALYSIS_KW | SP_KW)
                     | BS_CONT meas_analysis
%extend meas_body: (CSEP | BS_CONT) (TEXT | QUOTED) rest
                 | BS_CONT meas_body
SP_KW.2: "sp"i
