// LTspice overlay on core.lark (M8, decision 0009): the LTspice forms of the phase 1 constructs.
// %ignore is not carried by %import, so it is declared again here. Every core rule and terminal
// used by this dialect is imported by name, which keeps tree and token names unprefixed. Lark
// inlines sub-terminals at import, so a terminal built from one is overridden whole.
//
// What differs from ngspice, each with its evidence in docs/grammars/ltspice/discrepancies.md:
// no "\\" continuation and almost no comma separators; ";" and " $ " comments; the embedded decimal
// in every value slot; a closed list of dot-commands; closed instance parameter lists per letter.

%import .core (start, first_line, line, body_line, statement, top_statement, title_stmt)
%import .core (unknown_stmt, rest, line_rest, end_stmt, trailer)
%import .core (WS, LINE_END, CONT, NL, TITLE_KW, TITLE_ARG, TITLE_TEXT, COMMENT_LINE)
%import .core (TRAILING_COMMENT, TEXT, QUOTED, END_KW, DOT_NAME)
%import .core (resistor, capacitor, inductor, mutual_coupling, voltage_source, current_source)
%import .core (diode, subckt_instance, x_node, x_last, x_name, x_param, eol, node, value, param)
%import .core (r_value, c_value, model, flag)
%import .core (inductor_ref, dc_spec, dc_after, dc_keyword, ac_spec, c_charge)
%import .core (_sf, _sfd, _sfa, _sfam, _sfdam, _sfda, _line_end)
%import .core (_source_fn, stimulus, pwl_stimulus, fn_param, fn_list, fn_first, fn_arg, FN_PARAM_KW)
%import .core (SEP, CSEP, EQ, WORD, NUMBER)
%import .core (BRACE_FORMULA, QUOTE_FORMULA, STRING_VALUE, OFF_KW, R_NAME)
%import .core (C_NAME, L_NAME, K_NAME, L_REF, V_NAME)
%import .core (I_NAME, DC_KW, AC_KW, D_NAME, X_NAME, Q_KW)
%import .core (t_name, t_number, t_area, FIELD_NUMBER, Q_NAME, M_NAME, J_NAME, Z_NAME)
%import .core (ctl_ref, sw_state, ON_KW, E_NAME, G_NAME, F_NAME, H_NAME, S_NAME, W_NAME)
%import .core (B_NAME)
%import .core (PULSE_KW, EXP_KW, SFFM_KW, SIN_KW, PWL_KW)
%import .core (param_stmt, param_def, param_value, PARAM_KW, PARAM_NAME)
%import .core (model_stmt, model_paren, model_param_first, rparen, MODEL_KW, LPAR, RPAR)
%import .core (model_flag, model_flag_first, model_text, PCHAN_KW, NCHAN_KW, DOTTED_VALUE)
%import .core (subckt_def, subckt_header, subckt_port, subckt_item, not_in_subckt, ends_line)
%import .core (SUBCKT_KW, ENDS_KW, ZERO_PORT)
%import .core (tran_stmt, uic, TRAN_KW, UIC_KW, ac_stmt, ac_variation, DOT_AC_KW, DEC_KW)
%import .core (OCT_KW, LIN_KW, dc_stmt, dc_sweep, DOT_DC_KW, op_stmt, OP_KW)
%import .core (options_stmt, option_item, OPTIONS_KW, OPTION_KW, temp_stmt, TEMP_KW)
%import .core (ic_stmt, nodeset_stmt, node_condition, IC_KW, NODESET_KW, V_OPEN)
%import .core (save_stmt, output_vector, SAVE_KW, voltage_vector)
%import .core (current_vector, VOLTAGE_OPEN, CURRENT_OPEN)
%import .core (meas_stmt, meas_analysis, meas_body, MEAS_KW, MEASURE_KW, TRAN_ANALYSIS_KW)
%import .core (global_stmt, GLOBAL_KW)

%ignore WS
%ignore CONT

// Element lines of the phase 1 letters; other letters stay errors (devices.md).
// spec: LT-STR-001
%extend body_line: resistor
                 | capacitor
                 | inductor
                 | mutual_coupling
                 | voltage_source
                 | current_source
                 | diode
                 | subckt_instance

// .end takes an end-of-line comment: the reference allows ";" anywhere on a line. Decision 0009:
// .end stays required, with only blank lines after it.
// spec: LT-END-001
%override END_KW.4: /\.end(?![a-z0-9_-])/i
%extend end_stmt: END_KW TRAILING_COMMENT LINE_END trailer* -> end
                | END_KW TRAILING_COMMENT -> end

// A comment line starts with "*" or ";" (a "$" line is an error in LTspice 26.1.1).
// spec: LT-COM-001
%override COMMENT_LINE.3: /[*;](?:[^\r\n]|\r(?!\n))*/

// An end-of-line comment starts at ";", anywhere, or at "$" with a space on both sides: LTspice
// 26.1.1 reads "1k $ c" as a comment but fails on "1k$ c", "1k $c", "1k $" and on a tab next to the
// "$" (probe, M8 T3). A "$" elsewhere is a name character ("$G_x", "a$b"). "//" is not a comment.
// spec: LT-COM-002
%override TRAILING_COMMENT.3: /(?:;|(?<= )\$ )(?:[^\r\n]|\r(?!\n))*/

// Statement text runs up to a comment or a quote. "/" and "\" are ordinary text here.
// spec: LT-TXT-001
%override TEXT.2: /[^ \t\r\n;'"](?:[^\r\n;'"$]|(?<! )\$|\$(?! )|\r(?!\n))*/

// A name is any string without blanks (reference, Node Naming); LTspice 26.1.1 refuses these
// characters in one: = ( ) , { } ' " | (and ";", which starts a comment). Blanks and "=" end it.
// Each name terminal is overridden because sub-terminals are inlined at import.
// spec: LT-NOD-001
_LT_CHAR: /[^ \t\r\n=(),{}'"|;]/
%override WORD.2: _LT_CHAR+
%override R_NAME.4: /[Rr]/ _LT_CHAR*
%override C_NAME.4: /[Cc]/ _LT_CHAR*
%override L_NAME.4: /[Ll]/ _LT_CHAR*
%override K_NAME.4: /[Kk]/ _LT_CHAR*
%override L_REF.4: /[Ll]/ _LT_CHAR*
%override V_NAME.4: /[Vv]/ _LT_CHAR*
%override I_NAME.4: /[Ii]/ _LT_CHAR*
%override D_NAME.4: /[Dd]/ _LT_CHAR*
%override X_NAME.4: /[Xx]/ _LT_CHAR*

// A number: as in core, then any letters (Unicode included: 1kOhm, 1kΩ, 1µ, 1μ). LTspice ignores
// the letters after a multiplier.
// spec: LT-NUM-001
%override NUMBER.3: /[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?[^\W\d_]*/

// The embedded decimal (decision 6): digits, a multiplier in place of the decimal point, digits.
// 6K34 is 6.34K; M is milli, so 1M0 is 1m. R is unit (2R2 is 2.2; observed, not in the reference's
// multiplier table). It is accepted in every value slot; the node records notation="rkm".
// spec: LT-NUM-003
EMBEDDED.4: /[0-9]+(?:meg|mil|[tgkmunpfr]|µ|μ)[0-9]+/i
%extend value: SEP EMBEDDED

// Comment markers differ from ngspice, so a formula's character classes do too.
// spec: LT-VAL-001
%override BRACE_FORMULA.3: /\{(?:[^{}\r\n;$\/]|\/[^{}\r\n;\/]|\$(?! ))+\}/
%override QUOTE_FORMULA.3: /'[^'\r\n;]+'/

// Open-name parameters: .model only here, since each element letter has a closed list. A comma may
// stand before one (observed). Only mfg and type, as in LTspice's own libraries, take a quoted string
// or a bare word, kept verbatim and never read as a formula or a reference (review R8). LTspice reads
// a bare word in any other parameter as a parameter reference, so MODEL_BARE is recognised only to be
// rejected, with a hint to use braces. It has the highest priority and refuses a whole number, so a
// number stays a number: its lookahead fails when a number or embedded decimal ends the field.
// spec: LT-MOD-001
%extend param: SEP WORD EQ (EMBEDDED | MODEL_BARE)
             | CSEP WORD EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA | MODEL_BARE)
             | (SEP | CSEP) MODEL_TEXT_KW EQ (STRING_VALUE | WORD)
%extend model_param_first: WORD EQ (EMBEDDED | MODEL_BARE)
                         | MODEL_TEXT_KW EQ (STRING_VALUE | WORD)
MODEL_TEXT_KW.3: /(?:mfg|type)(?=[ \t]*=)/i
MODEL_BARE.5: /(?![+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:e[+-]?[0-9]+)?(?:[^\W\d_]*|(?:meg|mil|[tgkmunpfr]|µ|μ)[0-9]+)(?:[ \t\r\n,)]|$))[^ \t\r\n=(),{}'"|;]+/i
%extend model_stmt: MODEL_KW x_name model_ako x_name (param | model_flag | model_text)* (NL | eol)
                  | MODEL_KW x_name model_ako x_name model_paren (NL | eol)
%extend model_flag: CSEP (PCHAN_KW | NCHAN_KW)
                  | (SEP | CSEP) _ltra_flag
%extend model_flag_first: _ltra_flag
%extend model_text: CSEP WORD EQ DOTTED_VALUE
// LTRA's flags (ngspice manual §6.2.1) are recognised only so that they get their own message:
// the reference lists none (decision 0019).
_ltra_flag: NOSTEPLIMIT_KW | STEPLIMIT_KW | NOCONTROL_KW | LININTERP_KW | MIXEDINTERP_KW
          | TRUNCNR_KW | TRUNCDONTCUT_KW
NOSTEPLIMIT_KW.2: "nosteplimit"i
STEPLIMIT_KW.2: "steplimit"i
NOCONTROL_KW.2: "nocontrol"i
LININTERP_KW.2: "lininterp"i
MIXEDINTERP_KW.2: "mixedinterp"i
TRUNCNR_KW.2: "truncnr"i
TRUNCDONTCUT_KW.2: "truncdontcut"i
model_ako: SEP AKO_REF
         | (SEP | TRAILING_COMMENT) model_ako
AKO_REF.3: /ako:[^ \t\r\n=(),{}'"|;]+/i

// R, C and L take a value and a closed list of parameters: LTspice stops at any other name
// ("Unknown parameter"). They have no model form (no R, C or L .model type) and no keyword form. A
// bare name in the value's place is recognised only to be rejected (LTspice reads it as a model:
// "Undefined model"), with a hint. The lists hold the reference's names and, observed, the names
// LTspice's own component database writes (M8 review R1). A name's "=" is part of its terminal's
// lookahead, so m never matches the start of mfg.
// spec: LT-RES-001
%override resistor: R_NAME node node r_value (r_param | tc_param | noiseless_flag)* (NL | eol)
                  | R_NAME node node bare_name
%extend r_value: SEP EMBEDDED
r_param: SEP R_PARAM_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
       | SEP R_TEXT_KW EQ (STRING_VALUE | WORD)
       | (SEP | TRAILING_COMMENT) r_param
tc_param: SEP TC_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA) (CSEP (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA))*
        | (SEP | TRAILING_COMMENT) tc_param
bare_name: SEP WORD rest NL
         | (SEP | TRAILING_COMMENT) bare_name
noiseless_flag: SEP NOISELESS_KW (EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA))?
              | (SEP | TRAILING_COMMENT) noiseless_flag
R_PARAM_KW.2: /(?:temp|tol|pwr|tc1|tc2|m)(?=[ \t]*=)/i
R_TEXT_KW.2: /(?:mfg|pn)(?=[ \t]*=)/i
TC_KW.2: /tc(?=[ \t]*=)/i
NOISELESS_KW.2: "noiseless"i

// spec: LT-CAP-001
%override capacitor: C_NAME node node c_value (c_param | noiseless_flag)* (NL | eol)
                   | C_NAME node node c_charge (BRACE_FORMULA | QUOTE_FORMULA) _c_tail
                   | C_NAME node node c_charge B_PIECE _c_more
                   | C_NAME node node bare_name
%extend c_value: SEP EMBEDDED
c_param: SEP C_PARAM_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
       | SEP C_TEXT_KW EQ (STRING_VALUE | WORD)
       | (SEP | TRAILING_COMMENT) c_param
C_PARAM_KW.2: /(?:ic|rser|lser|rpar|cpar|rlshunt|temp|irms|v|m)(?=[ \t]*=)/i
C_TEXT_KW.2: /(?:mfg|pn|type)(?=[ \t]*=)/i
// Q= takes an expression in braces, in quotes, or bare (as B's), then the capacitor's parameters
// (reference C; decision 0016 item 4). x in it is the voltage across the capacitor.
_c_tail: (c_param | noiseless_flag)* (NL | eol)
_c_more: _c_tail
       | SEP B_PIECE _c_more

// Flux= takes an expression, as Q= does (x in it is the inductor's current); the hysteretic core
// takes the reference's closed list of parameters and no value (decision 0016 item 4).
// spec: LT-IND-001
%override inductor: L_NAME node node value (l_param | noiseless_flag)* (NL | eol)
                  | L_NAME node node l_flux _x_expression
                  | L_NAME node node hysteretic_param+ (NL | eol)
                  | L_NAME node node bare_name
l_flux: SEP FLUX_KW EQ
      | (SEP | TRAILING_COMMENT) l_flux
hysteretic_param: SEP HYSTERETIC_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
                | (SEP | TRAILING_COMMENT) hysteretic_param
FLUX_KW.3: /flux(?=[ \t]*=)/i
HYSTERETIC_KW.3: /(?:hc|bs|br|lm|lg|a|n)(?=[ \t]*=)/i
l_param: SEP L_PARAM_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
       | SEP L_TEXT_KW EQ (STRING_VALUE | WORD)
       | (SEP | TRAILING_COMMENT) l_param
L_PARAM_KW.2: /(?:ic|rser|rpar|cpar|temp|tc1|tc2|ipk|m)(?=[ \t]*=)/i
L_TEXT_KW.2: /(?:mfg|pn)(?=[ \t]*=)/i

// V: value, then AC with or without "=", then Rser and Cpar. With a function, these mix in any
// order, and a DC value after the function needs its keyword. The trigger parameters need a
// function too, and the trigger expression is text, kept and never read (decision 0013).
//
// As in core, the rules are right-linear. The states starting _q have seen Rser or Cpar before any
// DC or AC part, so they require a function; LTspice reads those forms, but only a function's line
// is documented to mix them.
// spec: LT-SRC-001
%override voltage_source: V_NAME node node _v0
_v0: dc_spec _ld
   | ac_spec _lam
   | _source_fn _sf{_vf, _line_end}
   | v_param _vq
   | _line_end
_vq: v_param _vq
   | dc_spec _qd
   | ac_spec _qam
   | _source_fn _sf{_vf, _line_end}
   | _line_end
_vf: v_param
   | trigger_param
   | fn_param
_ld: ac_spec _ldam | _source_fn _sfd{_vf, _line_end} | v_param _ldq | _line_end
_ldq: v_param _ldq | _source_fn _sfd{_vf, _line_end} | _line_end
_ldam: value _lda | _source_fn _sfda{_vf, _line_end} | v_param _lda | _line_end
_lda: _source_fn _sfda{_vf, _line_end} | v_param _lda | _line_end
_lam: value _la | _source_fn _sfa{_vf, _line_end} | v_param _la | _line_end
_la: _source_fn _sfa{_vf, _line_end} | v_param _la | _line_end
_qd: v_param _qd | ac_spec _qdam | _source_fn _sfd{_vf, _line_end}
_qdam: value _qda | v_param _qda | _source_fn _sfda{_vf, _line_end}
_qda: v_param _qda | _source_fn _sfda{_vf, _line_end}
_qam: value _qa | v_param _qa | _source_fn _sfa{_vf, _line_end}
_qa: v_param _qa | _source_fn _sfa{_vf, _line_end}
%extend ac_spec: SEP AC_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
v_param: SEP V_PARAM_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
       | (SEP | TRAILING_COMMENT) v_param
V_PARAM_KW.2: /(?:rser|cpar)(?=[ \t]*=)/i
trigger_param: SEP TRIGGER_KW EQ TRIGGER_EXPR
             | SEP TRIP_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
             | (SEP | TRAILING_COMMENT) trigger_param
TRIGGER_KW.2: /trigger(?=[ \t]*=)/i
TRIP_KW.2: /(?:tripdv|tripdt)(?=[ \t]*=)/i
TRIGGER_EXPR.2: /[^ \t\r\n;]+/

// I: a value is required ("Missing current value"), or an AC part, or the resistive load R=value.
// "load" is a flag after the value and the AC part, or after a function; it cannot stand before
// one. tbl= is written with no value, and alone (decision 0013).
// spec: LT-SRC-001
%override current_source: I_NAME node node dc_spec _id
                        | I_NAME node node ac_spec _iam
                        | I_NAME node node resistive_load (ac_spec value?)? (NL | eol)
                        | I_NAME node node _i_fn _sf{_if, _line_end}
                        | I_NAME node node table_stimulus _line_end
_id: ac_spec _idam | _i_fn _sfd{_if, _line_end} | load_flag _line_end | _line_end
_idam: value _ida | _i_fn _sfda{_if, _line_end} | load_flag _line_end | _line_end
_ida: _i_fn _sfda{_if, _line_end} | load_flag _line_end | _line_end
_iam: value _ia | _i_fn _sfa{_if, _line_end} | load_flag _line_end | _line_end
_ia: _i_fn _sfa{_if, _line_end} | load_flag _line_end | _line_end
_if: trigger_param
   | load_flag
   | fn_param
_i_fn: _source_fn
     | step_stimulus
load_flag: SEP LOAD_KW (EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA))?
         | (SEP | TRAILING_COMMENT) load_flag
resistive_load: SEP I_R_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
              | (SEP | TRAILING_COMMENT) resistive_load
LOAD_KW.2: "load"i
I_R_KW.2: "r"i

// Transistors (decision 0014). Q takes 3 or 4 nodes and a positional area; M takes 3 or 4 nodes;
// J and Z take 3 nodes and a positional area. Each letter has the reference's closed parameter
// list, and off. Only M takes IC=, a comma list that may have a blank after the comma.
// spec: LT-XTR-001
%extend body_line: bjt
                 | mosfet
                 | jfet
                 | mesfet
%extend t_area: SEP FIELD_EMBEDDED
// A positional number takes the letters this dialect's NUMBER takes, any Unicode letter (1μ, 2Ω):
// LTspice 26.1.1 reads `Q1 c b 0 qm 1μ` as an area of 1e-6, so the field is never a model (M18
// A1-4). It is also POLY's number.
%override FIELD_NUMBER.4: /[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?[^\W\d_]*(?![^ \t\r\n;$,)])/
// An embedded decimal that ends the field, so a model name such as 2N7000_OJ stays a name. It is
// below WORD, so where a name may also follow (Q1 c b e s 2N3904), the field is a name.
FIELD_EMBEDDED.1: /[0-9]+(?:meg|mil|[tgkmunpfr]|µ|μ)[0-9]+(?![^ \t\r\n;])/i
ic_param: SEP IC_PARAM_KW EQ _lt_value (IC_COMMA _lt_value)*
        | (SEP | TRAILING_COMMENT) ic_param
_lt_value: NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA
IC_PARAM_KW.3: /ic(?=[ \t]*=)/i
IC_COMMA.12: /[ \t]*,[ \t]*(?=[-+.0-9{'])/

// spec: LT-BJT-001
bjt: Q_NAME node node node t_name t_area? (q_param | flag)* (NL | eol)
   | Q_NAME node node node (t_name | t_number) t_name t_area? (q_param | flag)* (NL | eol)
q_param: SEP Q_PARAM_KW EQ _lt_value
       | (SEP | TRAILING_COMMENT) q_param
Q_PARAM_KW.3: /temp(?=[ \t]*=)/i
%override Q_NAME.4: /[Qq]/ _LT_CHAR*

// spec: LT-MOS-001
mosfet: M_NAME node node node t_name (m_param | ic_param | flag)* (NL | eol)
      | M_NAME node node node (t_name | t_number) t_name (m_param | ic_param | flag)* (NL | eol)
m_param: SEP M_PARAM_KW EQ _lt_value
       | (SEP | TRAILING_COMMENT) m_param
M_PARAM_KW.3: /(?:nrd|nrs|ad|as|pd|ps|temp|l|w|m)(?=[ \t]*=)/i
%override M_NAME.4: /[Mm]/ _LT_CHAR*

// spec: LT-JFT-001
jfet: J_NAME node node node t_name t_area? (j_param | flag)* (NL | eol)
j_param: SEP J_PARAM_KW EQ _lt_value
       | (SEP | TRAILING_COMMENT) j_param
J_PARAM_KW.3: /temp(?=[ \t]*=)/i
%override J_NAME.4: /[Jj]/ _LT_CHAR*

// spec: LT-MES-001
mesfet: Z_NAME node node node t_name t_area? (z_param | flag)* (NL | eol)
z_param: SEP Z_PARAM_KW EQ _lt_value
       | (SEP | TRAILING_COMMENT) z_param
Z_PARAM_KW.3: /(?:temp|m)(?=[ \t]*=)/i
%override Z_NAME.4: /[Zz]/ _LT_CHAR*

// Linear dependent sources and switches (reference E, G, H, F, S, W; decision 0015). The gain is
// one value, and none of the six takes a parameter. A switch's state may take a value, as other
// LTspice flags may. The forms of decision 0017 (POLY, table=, Laplace=) follow below.
// spec: LT-CTL-001
%extend body_line: vcvs
                 | vccs
                 | cccs
                 | ccvs
                 | vswitch
                 | cswitch
%extend sw_state: SEP (ON_KW | OFF_KW) EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
// Gain forms recognised only so that each gets its own message (decision 0015 item 6): gain=, which
// LTspice runs; a second value; and a word in the gain's place, which LTspice writes for a symbol
// whose value was never set.
gain_keyword: SEP GAIN_KW rest NL
            | (SEP | TRAILING_COMMENT) gain_keyword
second_value: SEP (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA) rest NL
            | (SEP | TRAILING_COMMENT) second_value
unset_gain: SEP WORD rest NL
          | (SEP | TRAILING_COMMENT) unset_gain
GAIN_KW.3: /gain[ \t]*(?==)/i

// spec: LT-NLS-001
// value= on E, F, G and H (decision 0016 item 3): an expression in braces, in quotes, or bare, as
// for B (its pieces stop before a name and "=").
value_form: SEP VALUE_FORM_KW EQ
          | (SEP | TRAILING_COMMENT) value_form
_x_expression: (BRACE_FORMULA | QUOTE_FORMULA) (NL | eol)
             | B_PIECE _x_more
_x_more: (NL | eol)
       | SEP B_PIECE _x_more
VALUE_FORM_KW.3: /value(?=[ \t]*=)/i
// `value` and a blank after the output nodes is the keyword to LTspice: it stops on E and G
// ("Unknown parameter") and reads F and H as the value form. Recognised only so that it gets
// its own message.
value_word: SEP VALUE_WORD_KW rest NL
          | (SEP | TRAILING_COMMENT) value_word
VALUE_WORD_KW.3: /value(?=[ \t]+[^ \t\r\n={'])/i

// table= on E and G (reference E): one parenthesised list of values after the four nodes, with
// or without "=", so the list is a core fn_list. Laplace= takes a transfer function, bare or
// braced, then window=, nfft= and mtol=; B's laplace= is the same clause (decision 0017).
// spec: LT-TBL-001
table_form: SEP TABLE_KW EQ?
          | (SEP | TRAILING_COMMENT) table_form
TABLE_KW.3: /table(?=[ \t]*[=(])/i

// spec: LT-LAP-001
laplace_clause: SEP LAPLACE_KW EQ _lap_expr
              | (SEP | TRAILING_COMMENT) laplace_clause
_lap_expr: (BRACE_FORMULA | QUOTE_FORMULA) _lap_tail
         | B_PIECE _lap_more
_lap_more: _lap_tail
         | SEP B_PIECE _lap_more
_lap_tail: lap_param* (NL | eol)
lap_param: SEP LAP_PARAM_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
         | (SEP | TRAILING_COMMENT) lap_param
LAPLACE_KW.3: /laplace[ \t]*(?==)/i
LAP_PARAM_KW.3: /(?:window|nfft|mtol)(?=[ \t]*=)/i

// POLY(N) and its flat list (reference, "Polynomial (legacy)"): names and values, with commas or
// blanks between them. On E and G, a control pair may be written "(n+,n-)", tight or not; the
// transformer counts the control nodes from the dimension (decision 0017 item 3).
// spec: LT-PLY-001
poly_form: SEP POLY_KW LPAR POLY_DIM rparen
         | (SEP | TRAILING_COMMENT) poly_form
poly_field: (SEP | CSEP) (FIELD_NUMBER | EMBEDDED | WORD | BRACE_FORMULA | QUOTE_FORMULA)
          | (SEP | TRAILING_COMMENT) poly_field
poly_pair: LPAR poly_pn poly_pn rparen
         | (SEP | TRAILING_COMMENT) poly_pair
poly_pn: (FIELD_NUMBER | WORD)
       | (SEP | CSEP | TRAILING_COMMENT) poly_pn
POLY_KW.3: /poly[ \t]*(?=\()/i
POLY_DIM.4: /[^ \t\r\n()]+/

// spec: LT-VCV-001
vcvs: E_NAME node node node node (value (NL | eol) | table_form fn_list (NL | eol) | laplace_clause)
    | E_NAME node node node node (value second_value | gain_keyword | unset_gain)
    | E_NAME node node value_form _x_expression
    | E_NAME node node value_word
    | E_NAME node node poly_form (poly_field | poly_pair)* (NL | eol)
%override E_NAME.4: /[Ee]/ _LT_CHAR*

// spec: LT-VCC-001
vccs: G_NAME node node node node (value (NL | eol) | table_form fn_list (NL | eol) | laplace_clause)
    | G_NAME node node node node (value second_value | gain_keyword | unset_gain)
    | G_NAME node node value_form _x_expression
    | G_NAME node node value_word
    | G_NAME node node poly_form (poly_field | poly_pair)* (NL | eol)
%override G_NAME.4: /[Gg]/ _LT_CHAR*

// spec: LT-CCC-001
cccs: F_NAME node node ctl_ref value (NL | eol)
    | F_NAME node node ctl_ref (value second_value | gain_keyword | unset_gain)
    | F_NAME node node value_form _x_expression
    | F_NAME node node value_word
    | F_NAME node node poly_form poly_field* (NL | eol)
%override F_NAME.4: /[Ff]/ _LT_CHAR*

// spec: LT-CCV-001
ccvs: H_NAME node node ctl_ref value (NL | eol)
    | H_NAME node node ctl_ref (value second_value | gain_keyword | unset_gain)
    | H_NAME node node value_form _x_expression
    | H_NAME node node value_word
    | H_NAME node node poly_form poly_field* (NL | eol)
%override H_NAME.4: /[Hh]/ _LT_CHAR*

// spec: LT-SWV-001
vswitch: S_NAME node node node node model sw_state? (NL | eol)
%override S_NAME.4: /[Ss]/ _LT_CHAR*

// spec: LT-SWC-001
cswitch: W_NAME node node ctl_ref model sw_state? (NL | eol)
%override W_NAME.4: /[Ww]/ _LT_CHAR*

// B: V=, I=, R= or P=, then an expression, then ic=, tripdv=, tripdt=, Rpar= and vprx= (reference
// B; decision 0016 item 2). A bare expression may hold blanks and + continuations, as for ngspice.
// laplace= follows (LT-LAP-001).
// spec: LT-BEH-001
%extend body_line: behavioral
behavioral: B_NAME node node b_quantity (BRACE_FORMULA | QUOTE_FORMULA) _b_tail
          | B_NAME node node b_quantity B_PIECE _b_more
b_quantity: SEP B_QUANTITY_KW EQ
          | (SEP | TRAILING_COMMENT) b_quantity
_b_more: _b_tail
       | SEP B_PIECE _b_more
_b_tail: b_param* ((NL | eol) | laplace_clause | b_second_quantity)
// A second quantity stops LTspice; recognised only so that it gets its own message.
b_second_quantity: SEP B_QUANTITY_KW rest NL
                 | (SEP | TRAILING_COMMENT) b_second_quantity
b_param: SEP B_PARAM_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
       | (SEP | TRAILING_COMMENT) b_param
B_QUANTITY_KW.3: /[virp](?=[ \t]*=)/i
B_PARAM_KW.3: /(?:ic|tripdv|tripdt|rpar|vprx)(?=[ \t]*=)/i
B_PIECE.4: /(?![A-Za-z_][A-Za-z0-9_]*[ \t]*=(?!=))(?!(?:\{[^{}\r\n]*\}|'[^'\r\n]*')[ \t]*(?:\r?\n|$|;|\$ |[A-Za-z_][A-Za-z0-9_]*[ \t]*=(?!=)))(?:(?:[^ \t\r\n;'\"$]|\$(?! ))|[ \t]+(?![A-Za-z_][A-Za-z0-9_]*[ \t]*=(?!=))(?=(?:[^ \t\r\n;'\"$]|\$(?! ))))+/i
%override B_NAME.4: /[Bb]/ _LT_CHAR*
// B's laplace= is the laplace_clause above, after V= or I= (decision 0017 item 4).

// Transmission lines (reference T, O and U; decision 0019). T: four nodes, then Zo= (or Z0=) and
// Td=, the reference's names. F=, NL=, IC=, rel= and abs= run in LTspice and are recognised only so
// that they get their own message.
// spec: LT-TLL-001
%extend body_line: lossless_line
lossless_line: T_NAME node node node node _t_more
_t_more: t_param _t_more
       | NL
       | eol
       | t_unlisted
t_param: SEP T_PARAM_KW EQ (_lt_value | LINE_BARE)
       | (SEP | TRAILING_COMMENT) t_param
t_unlisted: SEP T_UNLISTED_KW rest NL
          | (SEP | TRAILING_COMMENT) t_unlisted
T_PARAM_KW.3: /(?:z0|zo|td)(?=[ \t]*=)/i
T_UNLISTED_KW.3: /(?:f|nl|ic|rel|abs)(?=[ \t]*=)/i
// A bare name or expression in a line's value (Zo=z, L=len), which LTspice reads as a parameter
// reference: recognised only so that it gets its own message, as on every other LTspice element.
LINE_BARE.2: /[A-Za-z_][^ \t\r\n;'"{}=,]*/
T_NAME.4: /[Tt]/ _LT_CHAR*

// O: four nodes and an LTRA model, then nothing. A field after the model (as an `ltline` symbol
// with LTRA left in its Value writes) is recognised only so that it gets its own message.
// spec: LT-LTR-001
%extend body_line: lossy_line
lossy_line: O_NAME node node node node model (NL | eol | line_extra)
line_extra: SEP (WORD | NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA) rest NL
          | (SEP | TRAILING_COMMENT) line_extra
O_NAME.4: /[Oo]/ _LT_CHAR*

// U: three nodes, a URC model, then L= and N= in either order. A bare name in a value is refused,
// as on T.
// spec: LT-URC-001
%extend body_line: rc_line
rc_line: U_NAME node node node model u_param* (NL | eol)
u_param: SEP U_PARAM_KW EQ (_lt_value | LINE_BARE)
       | (SEP | TRAILING_COMMENT) u_param
U_PARAM_KW.3: /[ln](?=[ \t]*=)/i
U_NAME.4: /[Uu]/ _LT_CHAR*

// A: eight nodes, the function, then named parameters (reference "A — Special Functions"; decision
// 0020 items 3 and 7). The function names are the 13 that LTspice's own symbols write, any case;
// another name is recognised only so that it gets its own message. Parameter names are open, and a
// comma may stand before one. A bare name in a value is refused, as on T; a positional value and a
// flag are recognised only so that they get their own message.
// spec: LT-SPF-001
%extend body_line: special_function
special_function: A_NAME node node node node node node node node sf_function _sf_tail
                | A_NAME node node node node node node node node sf_other
sf_function: SEP SF_FUNCTION_KW
           | (SEP | TRAILING_COMMENT) sf_function
sf_other: SEP WORD rest NL
        | (SEP | TRAILING_COMMENT) sf_other
_sf_tail: sf_param* ((NL | eol) | sf_extra)
sf_param: (SEP | CSEP) WORD EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA | LINE_BARE)
        | (SEP | TRAILING_COMMENT) sf_param
sf_extra: (SEP | CSEP) (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA | OFF_KW) rest NL
        | (SEP | TRAILING_COMMENT) sf_extra
SF_FUNCTION_KW.3: /(?:buf|and|or|xor|schmitt|dflop|srflop|varistor|modulator|ota|phasedet|counter|samplehold)(?![^ \t\r\n=(),{}'"|;])/i
A_NAME.4: /[Aa]/ _LT_CHAR*

// @: two nodes, then the zm flag and the reference's named parameters in any order (reference
// "@ — Frequency Response Analyzer"; decision 0020 item 7). flist=, pp=, nmax= and ac= take a list;
// each value after the first is its own field, which the transformer joins to the parameter before
// it. refnode= and intnode= name a net. The value tokens are written out, not `_lt_value`: that
// rule's state is shared with M's ic=, whose comma would then win over the list's. Another name is recognised only so that it gets its own
// message, as is a bare name in a value.
// spec: LT-FRA-001
%extend body_line: frequency_analyzer
frequency_analyzer: FRA_NAME node node (fra_param | fra_net | fra_more | fra_zm)* ((NL | eol) | fra_unlisted)
fra_param: (SEP | CSEP) FRA_PARAM_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA | LINE_BARE)
         | (SEP | TRAILING_COMMENT) fra_param
fra_net: (SEP | CSEP) FRA_NET_KW EQ WORD
       | (SEP | TRAILING_COMMENT) fra_net
fra_more: (SEP | CSEP) (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
        | (SEP | TRAILING_COMMENT) fra_more
fra_zm: (SEP | CSEP) ZM_KW
      | (SEP | TRAILING_COMMENT) fra_zm
fra_unlisted: (SEP | CSEP) FRA_UNLISTED_KW rest NL
            | (SEP | TRAILING_COMMENT) fra_unlisted
FRA_PARAM_KW.4: /(?:delay|fstart|fend|oct|fcoarse|flist|nmax|pp0|pp1|f0|f1|pp|tavgmin|tsettle|rpar|acmag|acphase|ac|enabled)(?=[ \t]*=)/i
FRA_NET_KW.4: /(?:refnode|intnode)(?=[ \t]*=)/i
FRA_UNLISTED_KW.3: /[A-Za-z_][A-Za-z0-9_]*(?=[ \t]*=)/
ZM_KW.2: "zm"i
FRA_NAME.4: /@/ _LT_CHAR*

// &: four nodes and nothing after them (reference "& — Frequency Response Analysis Probe"; decision
// 0020 item 8): the output pair, then the input pair. Its analyzer is the @ of the same suffix.
// spec: LT-FRP-001
%extend body_line: fra_probe
fra_probe: PROBE_NAME node node node node (NL | eol)
PROBE_NAME.4: /&/ _LT_CHAR*

// D: model, optional positional area, then the off flag and m, n, temp, area= and Rpar= in any
// order. A flag may take a value (reference, Element Overview); the text is kept, and the threshold
// is not interpreted.
// spec: LT-DIO-001
%override diode: D_NAME node node model value? (d_param | flag)* (NL | eol)
d_param: SEP D_PARAM_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
       | (SEP | TRAILING_COMMENT) d_param
%extend flag: SEP OFF_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
D_PARAM_KW.2: /(?:temp|area|rpar|m|n)(?=[ \t]*=)/i

// X: nodes, the subcircuit name, then parameters, with or without "params:". A comma may stand
// before a parameter (observed).
// spec: LT-SUB-001
%extend x_last: x_name params_marker x_param* (NL | eol)
%extend x_param: SEP WORD EQ EMBEDDED
               | CSEP WORD EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA | STRING_VALUE)
params_marker: SEP PARAMS_KW
             | (SEP | TRAILING_COMMENT) params_marker
PARAMS_KW.2: "params:"i

// spec: LT-SBD-001
%extend subckt_header: SUBCKT_KW x_name subckt_port+ params_marker x_param* (NL | eol)
%extend not_in_subckt: (STEP_KW | OPT_KW | TOP_DOT_NAME) rest NL

// Source functions. A list may hold embedded decimals, and SINE is the reference's name for SIN.
// spec: LT-FUN-001
%extend stimulus: SEP SINE_KW fn_list
%extend fn_first: EMBEDDED
%extend fn_arg: (SEP | CSEP) EMBEDDED

// spec: LT-FUN-003
SINE_KW.2: "sine"i

// PWL takes a list, a file or a repeat, with its scale factors before any of them. A file's path is
// never read.
// spec: LT-FUN-006
%extend pwl_stimulus: SEP PWL_KW pwl_factor+ fn_list
                    | SEP PWL_KW pwl_factor* pwl_file
pwl_factor: SEP PWL_FACTOR_KW EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
          | (SEP | TRAILING_COMMENT) pwl_factor
pwl_file: SEP PWL_FILE_KW EQ (FILE_PATH | STRING_VALUE)
        | (SEP | TRAILING_COMMENT) pwl_file
PWL_FACTOR_KW.2: /(?:time_scale_factor|value_scale_factor)(?=[ \t]*=)/i
PWL_FILE_KW.2: /file(?=[ \t]*=)/i
FILE_PATH.2: /[^ \t\r\n;"'()=,]+/

// spec: LT-FUN-007
%extend pwl_stimulus: SEP PWL_KW pwl_factor* pwl_repeat fn_list pwl_endrepeat
pwl_repeat: SEP REPEAT_KW SEP FOR_KW SEP (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
          | SEP REPEAT_KW SEP FOREVER_KW
          | (SEP | TRAILING_COMMENT) pwl_repeat
pwl_endrepeat: SEP ENDREPEAT_KW
             | (SEP | TRAILING_COMMENT) pwl_endrepeat
REPEAT_KW.2: "repeat"i
FOR_KW.2: "for"i
FOREVER_KW.2: "forever"i
ENDREPEAT_KW.2: "endrepeat"i

// A wave file's chan= reaches fn_param, and the transformer reports it on any other function.
// spec: LT-FUN-008
%extend _source_fn: wave_stimulus
wave_stimulus: SEP WAVEFILE_KW EQ (FILE_PATH | STRING_VALUE)
             | (SEP | TRAILING_COMMENT) wave_stimulus
%extend fn_param: SEP FN_PARAM_KW EQ EMBEDDED
%override FN_PARAM_KW.2: /chan(?=[ \t]*=)/i
WAVEFILE_KW.2: /wavefile(?=[ \t]*=)/i

// A current source's table and step load.
// spec: LT-FUN-009
table_stimulus: SEP TBL_KW EQ fn_list
              | (SEP | TRAILING_COMMENT) table_stimulus
TBL_KW.2: /tbl(?=[ \t]*=)/i

// spec: LT-FUN-010
step_stimulus: SEP I_STEP_KW fn_list
             | (SEP | TRAILING_COMMENT) step_stimulus
I_STEP_KW.2: "step"i

// Dot-commands form a closed list (decision 0009 item 5). The reference's other commands stay
// UnknownDirective: .backanno and .func may stand in a subcircuit body, the rest only at the top
// level (LTspice stops at them in a body). Any other dot-command is a ParseError.
// spec: LT-DIR-001
%override DOT_NAME.4: /\.(?:backanno|func)(?![a-z0-9_-])/i
%extend top_statement: top_unknown_stmt
top_unknown_stmt: TOP_DOT_NAME rest NL
TOP_DOT_NAME.4: /\.(?:four|noise|tf|fra|wave|net|savebias|savestate|loadstate)(?![a-z0-9_-])/i

// .include, .inc and .lib are opaque and cannot be continued, as in ngspice.
// A .lib line opens an opaque block when it has one field and an .endl follows before the next
// one-field .lib or .end (decision 0012). A two-field .lib may stand in the body, and any other
// .lib stays lib_stmt. The body is never read, so its lines are not topology. A "+" line is an
// ignored continuation, so one line of the body may hold several texts.
// spec: LT-OPA-001
%extend statement: include_stmt
                 | lib_stmt
                 | lib_block
include_stmt: (INCLUDE_KW | INC_KW) line_rest LINE_END
lib_stmt: LIB_KW line_rest LINE_END
lib_block: LIB_BLOCK_KW BLOCK_TEXT? NL lib_line* ENDL_KW BLOCK_TEXT? NL
lib_line: (BLOCK_DOT_NAME | BLOCK_TEXT) BLOCK_TEXT* NL
        | LINE_END
INCLUDE_KW.4: ".include"i
INC_KW.4: ".inc"i
LIB_KW.4: ".lib"i
LIB_BLOCK_KW.5: /\.lib(?=[ \t]+[^ \t\r\n;$]+[ \t]*(?:(?:[;$]|\/\/)[^\r\n]*)?\r?\n(?:(?![ \t]*\.(?:end(?![a-z0-9_-])|lib[ \t]+[^ \t\r\n;$]+[ \t]*(?:(?:[;$]|\/\/)[^\r\n]*)?\r?\n))(?:[^\r\n]|\r(?!\n))*\r?\n)*?[ \t]*\.endl(?![a-z0-9_-]))/i
ENDL_KW.4: ".endl"i

// .machine ... .endmachine is matched as a block only to be reported as unsupported: a named v1
// exclusion (decision 0009 item 5, decision 0020 item 11).
// spec: LT-MCH-001
%extend statement: machine_block
machine_block: MACHINE_KW BLOCK_TEXT? NL machine_line* ENDMACHINE_KW BLOCK_TEXT? NL
machine_line: BLOCK_DOT_NAME BLOCK_TEXT? NL
            | BLOCK_TEXT NL
            | LINE_END
MACHINE_KW.4: ".machine"i
ENDMACHINE_KW.4: ".endmachine"i
BLOCK_DOT_NAME.4: /\.[a-z][a-z0-9_-]*/i
BLOCK_TEXT.2: /[^ \t\r\n](?:[^\r\n]|\r(?!\n))*/

// .param: name=value or name value (L11), separated by blanks or a comma. Names start with a letter
// or "_" and hold letters, digits, "_", "#" and "."; time, temper and hertz are ordinary names. A
// value may be a bare expression, which the reference documents (.param x=2*pi*100). BARE_FORMULA
// has the highest priority of the value terminals and refuses a plain number, so a number stays a
// number: its lookahead fails when a number is followed by the end of the field, not by an operator.
// An expression holds no blank except around an operator or inside parentheses (three levels).
// spec: LT-PRM-001
%override PARAM_NAME.2: /[^\W\d][\w#.]*/
%extend param_def: SEP PARAM_NAME SEP param_value
                 | CSEP PARAM_NAME EQ param_value
%extend param_value: EMBEDDED
                   | BARE_FORMULA
BARE_FORMULA.5: /(?![+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?[^\W\d_]*[0-9]*(?:[ \t]*(?:[\r\n,;]|$)|[ \t]+(?![-+*\/%^&|<>=!])))(?:[<>!=]=|[^ \t\r\n=,;(){}'"]|\((?:[^()\r\n;]|\((?:[^()\r\n;]|\([^()\r\n;]*\))*\))*\))+(?:[ \t]*(?:\*\*|==|!=|<=|>=|[-+*\/%^&|<>])[ \t]*(?:[<>!=]=|[^ \t\r\n=,;(){}'"]|\((?:[^()\r\n;]|\((?:[^()\r\n;]|\([^()\r\n;]*\))*\))*\))+)*/

// .tran [Tstep] Tstop [Tstart [dTmax]], then modifiers (reference); Tstep may be left out.
// spec: LT-TRN-001
%override tran_stmt: TRAN_KW value (value (value value?)?)? (uic | tran_modifier)* (NL | eol)
tran_modifier: SEP TRAN_MODIFIER_KW (EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA | STRING_VALUE))?
             | (SEP | TRAILING_COMMENT) tran_modifier
TRAN_MODIFIER_KW.2: /steady|nodiscard|startup|step|convreport|loadstate|savestatetime|savestate/i

// .ac also takes a list of frequencies or a file.
// spec: LT-ACA-001
%extend ac_stmt: DOT_AC_KW list_keyword value+ (NL | eol)
               | DOT_AC_KW file_argument (NL | eol)
list_keyword: SEP LIST_KW
            | (SEP | TRAILING_COMMENT) list_keyword
file_argument: SEP FILE_KW EQ FILE_NAME
             | (SEP | TRAILING_COMMENT) file_argument
LIST_KW.2: "list"i
FILE_KW.2: "file"i
FILE_NAME.3: /"[^"\r\n]*"|[^ \t\r\n;"]+/

// .dc holds up to three sweeps (a fourth is a syntax error in LTspice), each with its own optional
// variation. The last one may be a list or a file; a list cannot be followed by another sweep here,
// since the fields are not delimited (discrepancies.md). The source may be any name, as in ngspice.
// spec: LT-DCA-001
%override dc_stmt: DOT_DC_KW dc_sweep (dc_sweep dc_sweep?)? (NL | eol)
                 | DOT_DC_KW (dc_sweep dc_sweep?)? dc_list_sweep
%extend dc_sweep: ac_variation x_name value value value
dc_list_sweep: x_name list_keyword value+ (NL | eol)
             | x_name file_argument (NL | eol)

// .temp takes one or more values (a shorthand for .step temp list).
// spec: LT-TMP-001
%extend temp_stmt: TEMP_KW value value+ (NL | eol)

// .options, .option and .opt. Names are not checked: the reference's list is not complete
// (discrepancies.md).
// spec: LT-OPT-001
%extend options_stmt: OPT_KW option_item+ (NL | eol)
%extend option_item: SEP WORD EQ EMBEDDED
                   | CSEP WORD (EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA | WORD))?
OPT_KW.4: ".opt"i

// .ic and .nodeset: V(node)=value items. all= is an error in LTspice, unlike ngspice. .ic also sets
// inductor currents (reference, Tips): I(L...)=value. The grammar keeps out I(R1), which LTspice
// ignores; the name is indexed like .save I(...). .nodeset takes voltages only.
// spec: LT-ICN-001
%extend node_condition: SEP V_OPEN WORD RPAR EQ EMBEDDED
%override ic_stmt: IC_KW (node_condition | current_condition)+ (NL | eol)
current_condition: SEP CURRENT_OPEN L_REF RPAR EQ (NUMBER | EMBEDDED | BRACE_FORMULA | QUOTE_FORMULA)
                 | (SEP | TRAILING_COMMENT) current_condition

// .save: V(...), I(...) and the device currents Id(...), Ib(...) and so on, with wildcards and
// hierarchical names, kept as text; a plain name is an error in LTspice, unlike ngspice. A comma
// may stand before a vector (observed).
// spec: LT-SAV-001
%extend output_vector: CSEP (voltage_vector | current_vector)
%extend current_vector: DEVICE_CURRENT_OPEN WORD RPAR
                      | (CURRENT_OPEN | DEVICE_CURRENT_OPEN) SAVE_PATTERN RPAR
%extend voltage_vector: VOLTAGE_OPEN SAVE_PATTERN RPAR
DEVICE_CURRENT_OPEN.3: /i[dgsbce]\(/i
SAVE_PATTERN.3: /[^ \t\r\n=(),{}'"|;:*?]*[:*?][^ \t\r\n=(),{}'"|;]*/

// .meas: the analysis keyword is optional; NOISE and OP are analyses too; SP is not.
// spec: LT-MEA-001
%extend meas_stmt: (MEAS_KW | MEASURE_KW) x_name meas_body NL
%extend meas_analysis: SEP (NOISE_KW | OP_ANALYSIS_KW)
NOISE_KW.2: "noise"i
OP_ANALYSIS_KW.2: "op"i

// .step [oct|dec|lin] item start end incr, or item list v1 v2 ..., or item file=name (reference).
// The item is "param name", a source name, "temp", or a model type and name(parameter). Numbers
// are plain: LTspice stops at a brace expression here. A list holds at least two values.
// spec: LT-STP-001
%extend top_statement: step_stmt
step_stmt: STEP_KW ac_variation? x_name step_model_ref? step_sweep
         | STEP_KW ac_variation? step_param step_sweep
         | STEP_KW ac_variation? step_temp step_sweep
step_param: SEP STEP_PARAM_KW x_name
          | (SEP | TRAILING_COMMENT) step_param
step_temp: SEP STEP_TEMP_KW
         | (SEP | TRAILING_COMMENT) step_temp
step_model_ref: SEP STEP_MODEL_REF
              | (SEP | TRAILING_COMMENT) step_model_ref
step_sweep: step_value step_value step_value (NL | eol)
          | list_keyword step_value step_value+ (NL | eol)
          | file_argument (NL | eol)
step_value: SEP (NUMBER | EMBEDDED)
          | (SEP | TRAILING_COMMENT) step_value
STEP_KW.4: ".step"i
STEP_PARAM_KW.2: "param"i
STEP_TEMP_KW.2: "temp"i
STEP_MODEL_REF.5: /[^ \t\r\n=(),{}'"|;]+\([^ \t\r\n=(),{}'"|;]+\)/
