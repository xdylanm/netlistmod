// The constructs ngspice and LTspice share (M2, M8 decision 3). Syntax lives here, not in Python
// (P13). A dialect overlay adds what only it has with %extend, and replaces a terminal whose text
// differs with %override: the "\\\\" continuation, RKM values, comma separators and the bare-expression
// rejection are in ngspice.lark; the terminals here (names, comments, text) hold what both dialects
// accept, so this file also compiles on its own. Spec markers name the ngspice entries; each LTspice
// entry lists the shared rules it relies on under core_rules.
//
// Layout:  title line, body lines, a required .end, then blank lines only.
// Each marker `// spec: <ID>` covers the definitions that follow it up to the next blank line.
//
// Lexer techniques (see decision 0003; every priority is deliberate because Lark only
// collision-checks terminals of EQUAL priority):
//  * LINE_END (8) ends the title, comment, blank and .end lines and the lines that cannot be
//    continued (.include, .lib). It outranks CONT (7), so a "+" line after any of those lines is
//    never swallowed as a continuation: it is a syntax error.
//  * NL (5) ends only continuable statements. CONT (7) outranks it, so a "+" line that
//    immediately follows such a statement is ignored (it continues the statement).
//  * WS (9) is ignored everywhere; text terminals never start with whitespace.
//  * Keywords are string terminals at the SAME priority (4) as the generic DOT_NAME regex, so
//    Lark re-types an exact, case-insensitive match to the keyword.
//  * Free text is written with \r(?!\r?\n): a lone CR is ordinary text, CRLF is the terminator.

%ignore WS
%ignore CONT

// spec: NG-STR-001
start: first_line line* end_stmt

// spec: NG-TTL-001
first_line: TITLE_KW TITLE_ARG? LINE_END    -> explicit_title
          | TITLE_TEXT LINE_END             -> implicit_title
          | LINE_END                        -> empty_title

// A line is a body line (allowed at the top level and inside a subcircuit definition) or a
// top-level-only statement (decision 0005): .title, the analysis, option and output directives,
// and (ngspice overlay) .control blocks.
// spec: NG-STR-001
?line: body_line
     | top_statement

// spec: NG-STR-001
?body_line: LINE_END                        -> blank_line
          | COMMENT_LINE LINE_END           -> comment_line
          | statement

// spec: NG-STR-001
?statement: unknown_stmt
          | param_stmt
          | model_stmt
          | subckt_def

// spec: NG-STR-001
?top_statement: title_stmt
              | tran_stmt
              | ac_stmt
              | dc_stmt
              | op_stmt
              | options_stmt
              | temp_stmt
              | ic_stmt
              | nodeset_stmt
              | save_stmt
              | meas_stmt
              | global_stmt

// spec: NG-TTL-001
title_stmt: TITLE_KW TITLE_ARG? LINE_END

// spec: NG-DIR-001
unknown_stmt: DOT_NAME rest NL

// A comment runs to the end of its physical line, so a TEXT or QUOTED after it can only come from
// a continuation line: each line of a continued statement may end in a comment.
// spec: NG-TXT-001
rest: (TEXT | QUOTED | TRAILING_COMMENT)*

// The text of a statement that cannot be continued (.include, .lib; manual §2.4.5). The statement
// ends with LINE_END, which outranks CONT, so a following "+" line is a syntax error.
// spec: NG-TXT-001
line_rest: (TEXT | QUOTED)* TRAILING_COMMENT?

// The newline after .end may be missing at end of input. An empty optional newline would be a
// shift/reduce conflict under strict=True, so the alternatives are spelled out.
// spec: NG-END-001
end_stmt: END_KW LINE_END trailer*          -> end
        | END_KW                            -> end

// spec: NG-END-001
trailer: LINE_END                           -> blank_line

// spec: NG-STR-001
WS.9: /[ \t]+/

// spec: NG-CNT-001
LINE_END.8: /\r?\n/
CONT.7: /\r?\n[ \t]*\+/
NL.5: /\r?\n/

// spec: NG-TTL-001
TITLE_KW.6: /\.title(?![A-Za-z0-9_-])/i
TITLE_ARG.3: /[^ \t\r\n](?:[^\r\n]|\r(?!\r?\n))*/
TITLE_TEXT.2: /(?:[^\r\n]|\r(?!\r?\n))+/

// spec: NG-COM-001
COMMENT_LINE.3: /\*(?:[^\r\n]|\r(?!\r?\n))*/

// An end-of-line comment starts at ";" and runs to the end of the line, so quotes inside it are
// plain text. TEXT stops before it. "$", "/" and "\\" have dialect rules, so this TEXT excludes them
// and each overlay overrides both terminals.
// spec: NG-TXT-001
TRAILING_COMMENT.3: /;(?:[^\r\n]|\r(?!\r?\n))*/
TEXT.2: /[^ \t\r\n;$'"\/\\](?:[^\r\n;$'"\/\\]|\r(?!\r?\n))*/
QUOTED.3: /"[^"\r\n]*"|'[^'\r\n]*'/

// spec: NG-END-001
END_KW.4: ".end"i

// spec: NG-DIR-001
DOT_NAME.4: /\.[a-z][a-z0-9_-]*/i

// ---------------------------------------------------------------------------------------------
// Element lines (M3; decision 0004). Each element is a continuable statement ended by NL.
//
// Separators are tokens, not ignored whitespace. That makes adjacency visible to the parser (a
// value can never be split into two fields), and it keeps lexing context-specific: each field
// rule starts with its own separator, so the field's token is lexed in the state reached by
// shifting that separator, where the contextual lexer offers only the terminals valid at that
// place. If a separate gap rule ended right before a field, its LALR lookaheads would merge
// across all elements, and a node named "1" would then be lexed as a NUMBER.
//
// A field rule is "gap, then field": blanks, "+" continuation lines and the end-of-line comment
// of a continued line, of which the last one is directly before the field. The gap is
// right-recursive (`SEP field`), so the parser shifts every separator and decides at the field
// itself. A field with one separator is one reduction. Only gap tokens and NL follow a field rule,
// and those are lexically uniform. An overlay adds its own gap tokens (a comma, "\\\\") to each rule.
//
// Priorities (decision 0004): EQ.11 and CSEP.11 > SEP.10 > WS.9, so blanks before "=" or ","
// belong to that separator, and a "+" line after an element field is a separator rather than
// the ignored CONT. An overlay's embedded-decimal terminals (4) > NUMBER (3) > WORD (2): a
// digit-leading field in a value position is a value, never a name, and an embedded decimal is
// tried before the standard number that would match only its prefix. Keywords are strings at WORD's priority (2), so Lark re-types an
// exact WORD match only in states where the keyword is valid.

// A field separator: blanks, or a "+" continuation line with the blanks around it. A comma
// separator (CSEP) is a single comma with optional blanks; where an overlay allows it, it is the
// last separator before a field, so a gap holds at most one comma. EQ is "=" with optional blanks.
// An element line ends with NL, or with eol: gap material and then NL.
// spec: NG-FLD-001
SEP.10: /[ \t]*\r?\n[ \t]*\+[ \t]*|[ \t]+/
CSEP.11: /[ \t]*,[ \t]*/
EQ.11: /[ \t]*=[ \t]*/
eol: (SEP | TRAILING_COMMENT) (NL | eol)

// A node, model, subcircuit or parameter name: any characters except blanks, line ends and the
// characters neither dialect allows in a name. Each overlay overrides _WCHAR and _WUNIT with its
// own set; every name terminal is built from _WUNIT.
// spec: NG-NOD-001
_WCHAR: /[^ \t\r\n=%(),\[\]<>~{}'"|;$\\\/]/
_WUNIT: _WCHAR
WORD.2: _WUNIT+
node: SEP WORD
    | (SEP | TRAILING_COMMENT) node

// Numbers: an integer or decimal mantissa with optional sign and exponent, then optional
// letters (scale factors, and the letters the manual says are ignored), all one token. Lark
// inlines a sub-terminal without a group, so an alternation inside one is grouped explicitly.
// spec: NG-NUM-001
_SIGN: /[+-]/
_MANTISSA: /(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)/
_EXPONENT: /[eE][+-]?[0-9]+/
NUMBER.3: _SIGN? _MANTISSA _EXPONENT? _LETTERS?

// spec: NG-NUM-002
_LETTERS: (/[A-Za-z]/ | _MICRO)+

// The micro sign (U+00B5) as a scale factor: not in the manual's table, read as micro by
// ngspice 47 and written by LTspice.
// spec: NG-NUM-004
_MICRO: "µ"

// The value slots of R and C. An overlay adds its own notation (RKM in ngspice, the embedded
// decimal in LTspice).
// spec: NG-NUM-003
r_value: SEP (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
       | (SEP | TRAILING_COMMENT) r_value
c_value: SEP (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
       | (SEP | TRAILING_COMMENT) c_value

// Brace and single-quoted expressions, and a double-quoted string as a subcircuit parameter
// value. Contents are not parsed; braces do not nest. As in statement text (NG-TXT-001), quotes
// protect the comment markers and braces do not: a brace expression containing one is
// unterminated. A "/" inside braces must be followed by another expression character. An overlay
// overrides these where its comment markers differ. `value` is a field holding a number or a formula.
// spec: NG-VAL-001
BRACE_FORMULA.3: /\{(?:[^{}\r\n;$\/]|\/[^{}\r\n;$\/])+\}/
QUOTE_FORMULA.3: /'[^'\r\n]+'/
STRING_VALUE.3: /"[^"\r\n]*"/
value: SEP (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
     | (SEP | TRAILING_COMMENT) value

// Instance parameters name=value, model references and flags (each a field).
// spec: NG-PAR-001
param: SEP WORD EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
     | (SEP | TRAILING_COMMENT) param
model: SEP WORD
     | (SEP | TRAILING_COMMENT) model
flag: SEP OFF_KW
    | (SEP | TRAILING_COMMENT) flag
OFF_KW.2: "off"i

// spec: NG-RES-001
resistor: R_NAME node node r_value param* (NL | eol)
R_NAME.4: /[Rr]/ _WUNIT*

// spec: NG-CAP-001
capacitor: C_NAME node node c_value param* (NL | eol)
         | C_NAME node node c_charge (BRACE_FORMULA | QUOTE_FORMULA) param* (NL | eol)
C_NAME.4: /[Cc]/ _WUNIT*

// spec: NG-IND-001
inductor: L_NAME node node value param* (NL | eol)
L_NAME.4: /[Ll]/ _WUNIT*

// spec: NG-MUT-001
mutual_coupling: K_NAME inductor_ref inductor_ref+ value (NL | eol)
inductor_ref: SEP L_REF
            | (SEP | TRAILING_COMMENT) inductor_ref
K_NAME.4: /[Kk]/ _WUNIT*
L_REF.4: /[Ll]/ _WUNIT*

// Independent sources: an optional DC value, with or without the DC keyword, then an optional AC
// magnitude and phase (a value after the magnitude). A function may stand before or after them,
// with at most one of each; after a function a DC value needs its keyword (decision 0013).
//
// A source line is right-linear: each rule below is one state of what the line has shown so far (D
// a DC value, A an AC part, F a function; "m" means an AC magnitude was just read, so a plain value
// is its phase). Nothing reduces until the line ends, so the parser decides at each field's token,
// as the "gap, then field" comment above explains. p is what may stand after a function, and e is
// the end of the line; the overlays choose both. Each name starts with "_", so the fields arrive
// flat in voltage_source and current_source.
// spec: NG-SRC-001
voltage_source: V_NAME node node _s0{fn_param, _line_end}
current_source: I_NAME node node _s0{fn_param, _line_end}
_s0{p, e}: dc_spec _sd{p, e} | ac_spec _sam{p, e} | _source_fn _sf{p, e} | e
_sd{p, e}: ac_spec _sdam{p, e} | _source_fn _sfd{p, e} | e
_sam{p, e}: value _sa{p, e} | _source_fn _sfa{p, e} | e
_sa{p, e}: _source_fn _sfa{p, e} | e
_sdam{p, e}: value _sda{p, e} | _source_fn _sfda{p, e} | e
_sda{p, e}: _source_fn _sfda{p, e} | e
_sf{p, e}: p _sf{p, e} | dc_after _sfd{p, e} | ac_spec _sfam{p, e} | e
_sfd{p, e}: p _sfd{p, e} | ac_spec _sfdam{p, e} | e
_sfa{p, e}: p _sfa{p, e} | dc_after _sfda{p, e} | e
_sfam{p, e}: value _sfa{p, e} | p _sfa{p, e} | dc_after _sfda{p, e} | e
_sfdam{p, e}: value _sfda{p, e} | p _sfda{p, e} | e
_sfda{p, e}: p _sfda{p, e} | e
_line_end: NL | eol
dc_spec: dc_keyword value
       | value
dc_after: dc_keyword value
dc_keyword: SEP DC_KW
          | (SEP | TRAILING_COMMENT) dc_keyword
ac_spec: SEP AC_KW value
       | (SEP | TRAILING_COMMENT) ac_spec
V_NAME.4: /[Vv]/ _WUNIT*
I_NAME.4: /[Ii]/ _WUNIT*
DC_KW.2: "dc"i
AC_KW.2: "ac"i

// spec: NG-DIO-001
diode: D_NAME node node model (param | flag)* (NL | eol)
D_NAME.4: /[Dd]/ _WUNIT*

// Transistor lines (decision 0014): fixed nodes, then names, the last of which is the model, then
// an area where the dialect writes one positionally, then parameters and flags. Each overlay's
// element rule spells out the name sequences its node counts allow, so the parser classifies a
// name only once it sees what follows it, as for X. A field written as a number is a node before
// the model and the area after it; a model is never a number. FIELD_NUMBER is a number that ends
// the field, so a model name such as 2N3904 stays a name. Where only a name may follow, a number
// is lexed as a WORD; the transformer refuses it as the model at its token.
// spec: NG-XTR-001
t_name: SEP WORD
      | (SEP | TRAILING_COMMENT) t_name
t_number: SEP FIELD_NUMBER
        | (SEP | TRAILING_COMMENT) t_number
t_area: SEP (FIELD_NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
      | (SEP | TRAILING_COMMENT) t_area
FIELD_NUMBER.4: /[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:[A-Za-z]|µ)*(?![^ \t\r\n;$,)])/

// spec: NG-BJT-001
Q_NAME.4: /[Qq]/ _WUNIT*

// spec: NG-MOS-001
M_NAME.4: /[Mm]/ _WUNIT*

// spec: NG-JFT-001
J_NAME.4: /[Jj]/ _WUNIT*

// spec: NG-MES-001
Z_NAME.4: /[Zz]/ _WUNIT*

// Linear dependent sources and switches (decision 0015). E, G and S write four nodes, the output
// pair then the control pair; F, H and W write two nodes and a controlling source (ctl_ref), a
// reference like K's inductors. A switch's initial state is one keyword. Each overlay spells out
// its own lines, including the nonlinear forms it adds (decision 0017).
// spec: NG-CTL-001
ctl_ref: SEP WORD
       | (SEP | TRAILING_COMMENT) ctl_ref
sw_state: SEP (ON_KW | OFF_KW)
        | (SEP | TRAILING_COMMENT) sw_state
ON_KW.2: "on"i

// spec: NG-VCV-001
E_NAME.4: /[Ee]/ _WUNIT*

// spec: NG-VCC-001
G_NAME.4: /[Gg]/ _WUNIT*

// spec: NG-CCC-001
F_NAME.4: /[Ff]/ _WUNIT*

// spec: NG-CCV-001
H_NAME.4: /[Hh]/ _WUNIT*

// spec: NG-SWV-001
S_NAME.4: /[Ss]/ _WUNIT*

// spec: NG-SWC-001
W_NAME.4: /[Ww]/ _WUNIT*

// Behavioural sources (decision 0016). Each overlay spells out its B line: a quantity, then an
// expression in braces, in quotes, or bare (a run of pieces that ends before the line's trailing
// parameters), then those parameters.
// spec: NG-BEH-001
B_NAME.4: /[Bb]/ _WUNIT*

// A subcircuit call: one or more nodes, the subcircuit name, then parameters. The name list is
// right-recursive (x_node, x_last), so a name is classified only once the parser has seen what
// follows it; x_name is the gap and name both share.
// spec: NG-SUB-001
subckt_instance: X_NAME node (x_node | x_last)
x_node: x_name (x_node | x_last)
x_last: x_name x_param* (NL | eol)
x_name: SEP WORD
      | (SEP | TRAILING_COMMENT) x_name
x_param: SEP WORD EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA | STRING_VALUE)
       | (SEP | TRAILING_COMMENT) x_param
X_NAME.4: /[Xx]/ _WUNIT*

// A source function: its name, then a parenthesized list of one or more values, separated by blanks
// or commas (decision 0013). The parentheses are required. An overlay adds its own functions.
// spec: NG-FUN-001
_source_fn: stimulus
          | pwl_stimulus
fn_param: SEP FN_PARAM_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
        | (SEP | TRAILING_COMMENT) fn_param
FN_PARAM_KW.2: /r(?=[ \t]*=)/i
stimulus: SEP (PULSE_KW | EXP_KW | SFFM_KW | SIN_KW) fn_list
        | (SEP | TRAILING_COMMENT) stimulus
fn_list: LPAR fn_first fn_arg* rparen
       | (SEP | TRAILING_COMMENT) fn_list
fn_first: (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
        | (SEP | TRAILING_COMMENT) fn_first
fn_arg: (SEP | CSEP) (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
      | (SEP | TRAILING_COMMENT) fn_arg

// spec: NG-FUN-002
PULSE_KW.2: "pulse"i

// spec: NG-FUN-003
SIN_KW.2: "sin"i

// spec: NG-FUN-004
EXP_KW.2: "exp"i

// spec: NG-FUN-005
pwl_stimulus: SEP PWL_KW fn_list
            | (SEP | TRAILING_COMMENT) pwl_stimulus
PWL_KW.2: "pwl"i

// spec: NG-FUN-006
SFFM_KW.2: "sffm"i

// The charge form of a behavioural capacitor: q= and an expression in quotes or braces, then
// parameters (§3.3.9; decision 0016 item 4).
// spec: NG-CAP-001
c_charge: SEP Q_KW EQ
        | (SEP | TRAILING_COMMENT) c_charge
Q_KW.2: "q"i

// ---------------------------------------------------------------------------------------------
// Statements and directives (M4; decision 0005). Every one is a continuable statement ended by
// NL, and its fields reuse the element field design: each field rule starts with its own gap, so
// the field's token is lexed in a state that offers only the terminals valid there. Keywords are
// strings at DOT_NAME's priority (4), so Lark re-types an exact, case-insensitive DOT_NAME match;
// a dot-command that is not one of them stays an unknown_stmt. Argument keywords (uic, dec, all,
// ...) are strings at WORD's priority (2) and are valid only where the rule names them.

// .param: one or more name=value assignments separated by blanks (manual §2.11.1). A value is a
// number, a brace or single-quoted formula or a double-quoted string. Each overlay overrides
// PARAM_NAME and says what a bare expression is.
// spec: NG-PRM-001
param_stmt: PARAM_KW param_def+ (NL | eol)
param_def: SEP PARAM_NAME EQ param_value
         | (SEP | TRAILING_COMMENT) param_def
?param_value: NUMBER | BRACE_FORMULA | QUOTE_FORMULA | STRING_VALUE
PARAM_KW.4: ".param"i
PARAM_NAME.2: /[A-Za-z][A-Za-z0-9_#]*/

// .model name type, then parameters with or without parentheses (§2.5, §3.2.2). Parameters are
// name=value fields separated by blanks or commas; inside parentheses the first one may follow
// "(" directly. LPAR and RPAR are valid only here and in v(...) (NG-ICN-001); a parenthesis
// anywhere else is still a syntax error.
// spec: NG-MOD-001
model_stmt: MODEL_KW x_name x_name (param | model_flag | model_text)* (NL | eol)
          | MODEL_KW x_name x_name model_paren (NL | eol)
model_paren: LPAR ((model_param_first | model_flag_first) (param | model_flag | model_text)*)? rparen
           | (SEP | TRAILING_COMMENT) model_paren
model_param_first: WORD EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA | DOTTED_VALUE)
                 | (SEP | TRAILING_COMMENT) model_param_first

// A VDMOS model's channel is a bare flag (§7.6.3: `.model mname VDMOS <Pchan> <parameters>`), and
// a version such as `version=3.3.0` is a dotted value, kept as text because it is not a number
// (decision 0014).
// spec: NG-MOD-001
model_flag: SEP (PCHAN_KW | NCHAN_KW)
          | (SEP | TRAILING_COMMENT) model_flag
model_flag_first: PCHAN_KW | NCHAN_KW
                | (SEP | TRAILING_COMMENT) model_flag_first
model_text: SEP WORD EQ DOTTED_VALUE
          | (SEP | TRAILING_COMMENT) model_text
PCHAN_KW.2: "pchan"i
NCHAN_KW.2: "nchan"i
DOTTED_VALUE.6: /[0-9]+(?:\.[0-9]+){2,}/
rparen: RPAR
      | (SEP | TRAILING_COMMENT) rparen
MODEL_KW.4: ".model"i
LPAR: "("
RPAR: ")"

// .subckt name ports [defaults] ... .ends [name] (§2.6.1, §2.6.2, §2.11.3). The block nests by
// recursion: a definition is a statement, so it may stand in another definition's body. A body
// holds body lines only; the top-level-only statements are recognised in a body so that the
// transformer can reject them at their keyword (not_in_subckt). A port named 0 is recognised
// (ZERO_PORT, re-typed from WORD) and rejected. Defaults are subcircuit-call parameters (x_param).
// spec: NG-SBD-001
subckt_def: subckt_header subckt_item* ends_line
subckt_header: SUBCKT_KW x_name subckt_port+ x_param* (NL | eol)
subckt_port: SEP (WORD | ZERO_PORT)
           | (SEP | TRAILING_COMMENT) subckt_port
?subckt_item: body_line
            | not_in_subckt
not_in_subckt: (TITLE_KW | TRAN_KW | DOT_AC_KW | DOT_DC_KW | OP_KW | OPTIONS_KW | OPTION_KW) rest NL
             | (TEMP_KW | IC_KW | NODESET_KW | SAVE_KW | MEAS_KW | MEASURE_KW | END_KW) rest NL
             | GLOBAL_KW rest NL
ends_line: ENDS_KW x_name? (NL | eol)
SUBCKT_KW.4: ".subckt"i
ENDS_KW.4: ".ends"i
ZERO_PORT.2: "0"

// .tran tstep tstop [tstart [tmax]] [uic] (§11.3.10).
// spec: NG-TRN-001
tran_stmt: TRAN_KW value value (value value?)? uic? (NL | eol)
uic: SEP UIC_KW
   | (SEP | TRAILING_COMMENT) uic
TRAN_KW.4: ".tran"i
UIC_KW.2: "uic"i

// .ac dec|oct|lin points fstart fstop (§11.3.1).
// spec: NG-ACA-001
ac_stmt: DOT_AC_KW ac_variation value value value (NL | eol)
ac_variation: SEP (DEC_KW | OCT_KW | LIN_KW)
            | (SEP | TRAILING_COMMENT) ac_variation
DOT_AC_KW.4: ".ac"i
DEC_KW.2: "dec"i
OCT_KW.2: "oct"i
LIN_KW.2: "lin"i

// .dc source start stop increment [source2 start2 stop2 increment2] (§11.3.2). The source is
// any name (a source, a resistor or TEMP); references are resolved in M5.
// spec: NG-DCA-001
dc_stmt: DOT_DC_KW dc_sweep dc_sweep? (NL | eol)
dc_sweep: x_name value value value
DOT_DC_KW.4: ".dc"i

// .op takes no arguments (§11.3.5).
// spec: NG-OPP-001
op_stmt: OP_KW (NL | eol)
OP_KW.4: ".op"i

// .options (or .option) name or name=value items (§11.1). A value is a number, a formula or a
// name (METHOD=name, §11.1.4). Option names are not checked.
// spec: NG-OPT-001
options_stmt: (OPTIONS_KW | OPTION_KW) option_item+ (NL | eol)
option_item: SEP WORD (EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA | WORD))?
           | (SEP | TRAILING_COMMENT) option_item
OPTIONS_KW.4: ".options"i
OPTION_KW.4: ".option"i

// .temp value (§2.14): exactly one value.
// spec: NG-TMP-001
temp_stmt: TEMP_KW value (NL | eol)
TEMP_KW.4: ".temp"i

// .ic and .nodeset: v(node)=value items (§11.2.2, §11.2.1); .nodeset also all=value. The node
// is a name of the element node class (NG-NOD-001).
// spec: NG-ICN-001
ic_stmt: IC_KW node_condition+ (NL | eol)
nodeset_stmt: NODESET_KW node_condition+ (NL | eol)
node_condition: SEP V_OPEN WORD RPAR EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
              | (SEP | TRAILING_COMMENT) node_condition
IC_KW.4: ".ic"i
NODESET_KW.4: ".nodeset"i
V_OPEN.2: /[vV]\(/

// .save vectors (§11.6.1). The forms the dialects share are the bracketed ones, V(N1<,N2>) and
// I(source). The function and "(" are one token. Blanks inside the parentheses are ignored and
// blanks around the comma belong to CSEP. An overlay adds its other forms.
// spec: NG-SAV-001
save_stmt: SAVE_KW output_vector+ (NL | eol)
output_vector: SEP (voltage_vector | current_vector)
             | (SEP | TRAILING_COMMENT) output_vector
SAVE_KW.4: ".save"i

// spec: NG-SAV-001
voltage_vector: VOLTAGE_OPEN WORD (CSEP WORD)? RPAR
current_vector: CURRENT_OPEN WORD (CSEP WORD)? RPAR
VOLTAGE_OPEN.3: /v\(/i
CURRENT_OPEN.3: /i\(/i

// .meas (or .measure) analysis result body (§11.4), typed shallowly: the analysis keyword and
// the result name are fields; the rest of the statement is statement text (NG-TXT-001) and must
// not be empty.
// spec: NG-MEA-001
meas_stmt: (MEAS_KW | MEASURE_KW) meas_analysis x_name meas_body NL
meas_analysis: SEP (DC_KW | AC_KW | TRAN_ANALYSIS_KW)
             | (SEP | TRAILING_COMMENT) meas_analysis
meas_body: SEP (TEXT | QUOTED) rest
         | (SEP | TRAILING_COMMENT) meas_body
MEAS_KW.4: ".meas"i
MEASURE_KW.4: ".measure"i
TRAN_ANALYSIS_KW.2: "tran"i

// .global nodename1 [nodename2 ...] (§2.7): one or more nodes of the element node class
// (NG-NOD-001), top level only (decision 0006); in a subcircuit body it is not_in_subckt.
// spec: NG-GLB-001
global_stmt: GLOBAL_KW node+ (NL | eol)
GLOBAL_KW.4: ".global"i
