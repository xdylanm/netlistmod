// xyce overlay on core.lark (decision 0026; X-M1, decision 0027). The dialect is hidden until X-M8.
// It reads the structure of a netlist ([xyce-ug] §4.1.1 p40, §4.1.3.1 p42–43): the title line,
// comment lines (`*`, or `;`, which may also end any line), blank lines, indented lines (a comment
// to Xyce, decision X-D1), `+` continuation across those lines (§4.1.3.2 p43), the final `.END`;
// the statements X-M1 B2 reads, `.PREPROCESS REPLACEGROUND` and `.GLOBAL`; those of B3,
// `.PARAM`, `.GLOBAL_PARAM` and `.FUNC`; and those of B4, `.SUBCKT`/`.ENDS`, `.MODEL`, the
// includes and `.LIB`. The names and the two number readers of decision 0027 items 3 and 8 are
// defined here for the statements and element lines that use them.
//
// The element lines of B5 are R, C, L, K, V and I (DC and AC parts), D and X. Every other line is
// refused: a dot-command the overlay does not read yet, and the other `.PREPROCESS` forms, raise
// UnsupportedConstruct from the transformer; an element line of another letter has no rule, so the
// loader raises UnsupportedConstruct for its `planned` letter (xyce-devices.json), and A and N,
// which are not Xyce letters, are a ParseError. A `+` line after comment or blank lines
// that follow a refused dot-command joins it, and is refused with it. A `+` line with only the
// title, comments and blank lines before it is a ParseError: the title is a comment, so there is
// no line for it to join.
//
// %ignore is not carried by %import, so it is declared again here. Every core rule and terminal
// used is imported by name, which keeps tree and token names unprefixed.
//
// Lexer priorities (decision 0003; Lark collision-checks only terminals of equal priority):
//  * INDENTED_LINE (10) outranks the ignored WS (9) at the start of a line, so an indented line
//    other than a `*`, `;` or `+` line is one token; a blank line is still WS and LINE_END.
//  * A statement's fields are separated by SEP (10). Its third alternative is the line end of a
//    line that a `+` line joins across blank, comment and indented lines: the lookahead finds the
//    `+` line, so the line end is a separator, not the NL that ends the statement. Each line
//    between is then a TRAILING_COMMENT (12, above SEP), which matches a `*` line or an indented
//    `*` or `;` line only right after a line end (a lookbehind), or an INDENTED_TRAILING (12),
//    which matches any other indented line there. So the comments of a continued statement stay
//    in its trailing_comments and its Line, and an indented line among them is still told apart
//    (decision X-D1). Every gap of a field rule takes all three, and the imported core rules with
//    a gap are extended with INDENTED_TRAILING.
//  * REST_TEXT (2) is the text after a refused dot-command, to the end of the line.

%import .core (end_stmt, trailer, eol, global_stmt)
%import .core (WS, LINE_END, CONT, NL, TITLE_TEXT, COMMENT_LINE, END_KW, DOT_NAME)
%import .core (SEP, TRAILING_COMMENT, WORD, NUMBER, GLOBAL_KW)
%import .core (CSEP, EQ, BRACE_FORMULA, QUOTE_FORMULA, PARAM_KW, RPAR)
%import .core (x_name, ends_line, param, rparen, MODEL_KW, LPAR, SUBCKT_KW, ENDS_KW, ZERO_PORT)
%import .core (value, model, dc_spec, dc_keyword, ac_spec, DC_KW, AC_KW, OFF_KW)
%import .core (TRAN_KW, UIC_KW, DOT_AC_KW, ac_variation, DEC_KW, OCT_KW, LIN_KW, DOT_DC_KW)
%import .core (op_stmt, OP_KW)

%ignore WS
%ignore CONT

// The lines before the first statement are `lead` lines, which a `+` line cannot follow.
// spec: XY-STR-001
start: first_line lead* (statement line*)? end_stmt

// The first line is always the title, even when it is blank or looks like a statement: Xyce has
// no `.TITLE`, so there is no explicit title.
// spec: XY-TTL-001
first_line: TITLE_TEXT LINE_END             -> implicit_title
          | LINE_END                        -> empty_title

// spec: XY-STR-001
?lead: LINE_END                             -> blank_line
     | COMMENT_LINE LINE_END                -> comment_line
     | indented_line

// spec: XY-STR-001
?line: lead
     | statement
     | continuation_line

// A body statement may also stand in a subcircuit body; a top statement only at the top level.
// spec: XY-STR-001
?statement: body_statement
          | top_statement
?body_statement: unsupported_directive
               | preprocess_stmt
               | preprocess_other
               | param_stmt
               | func_stmt
               | subckt_def
               | model_stmt
               | include_line
               | lib_call
               | lib_section
               | resistor
               | capacitor
               | inductor
               | mutual_coupling
               | voltage_source
               | current_source
               | diode
               | subckt_instance
?top_statement: global_stmt
              | global_param_stmt
              | xy_tran_stmt
              | xy_ac_stmt
              | xy_dc_stmt
              | op_stmt
              | xy_step_stmt

// A `*` comment line, and a line that begins with `;`, an in-line comment on a line of its own
// (§4.1.3.1 p43). An end-of-line comment starts at `;`, with or without a blank before it; the
// `*` alternative, and a `*` or `;` line with blanks before it, are lines that a `+` line joins
// across (XY-CNT-001).
// spec: XY-COM-001
%override COMMENT_LINE.3: /[*;](?:[^\r\n]|\r(?!\n))*/
%override TRAILING_COMMENT.12: /;(?:[^\r\n]|\r(?!\n))*|(?<=\n)(?:\*|[ \t]+[*;])(?:[^\r\n]|\r(?!\n))*/

// A `+` line continues the last line that is not a comment, across blank, comment (`*`, `;`) and
// indented lines (§4.1.3.2 p43; decision 0027 item 2).
// spec: XY-CNT-001
%override SEP.10: /[ \t]*\r?\n[ \t]*\+[ \t]*|[ \t]*\r?\n(?=(?:(?:[*;](?:[^\r\n]|\r(?!\n))*|[ \t]+(?:[^ \t\r\n+](?:[^\r\n]|\r(?!\n))*)?)?\r?\n)+[ \t]*\+)|[ \t]+/

// An indented line that is not a `*`, `;` or `+` line: a comment to Xyce ([xyce-ug] §4.1.3.1
// p43, [xyce-ref] §2.1.39.1 p163), read as a node of its own kind (decision X-D1).
// spec: XY-IND-001
indented_line: INDENTED_LINE LINE_END
INDENTED_LINE.10: /[ \t]+[^ \t\r\n+*;](?:[^\r\n]|\r(?!\n))*/

// The same line between a statement and its `+` line (XY-CNT-001): one of the statement's
// trailing comments, which the parser also records as an indented line, so that it is reported
// as one (INDENTED_LINE_IGNORED). The imported core rules with a gap take it too.
// spec: XY-IND-001
INDENTED_TRAILING.12: /(?<=\n)[ \t]+[^ \t\r\n+*;](?:[^\r\n]|\r(?!\n))*/
%extend eol: INDENTED_TRAILING (NL | eol)
%extend value: INDENTED_TRAILING value
%extend param: INDENTED_TRAILING param
%extend model: INDENTED_TRAILING model
%extend x_name: INDENTED_TRAILING x_name
%extend rparen: INDENTED_TRAILING rparen
%extend dc_keyword: INDENTED_TRAILING dc_keyword
%extend ac_spec: INDENTED_TRAILING ac_spec
%extend ac_variation: INDENTED_TRAILING ac_variation

// `.END` may end with a `;` comment, since `;` may end any line (§4.1.3.1 p43); nothing else may
// follow it on its line.
// spec: XY-END-001
%extend end_stmt: END_KW TRAILING_COMMENT LINE_END trailer* -> end
                | END_KW TRAILING_COMMENT -> end

// A dot-command the overlay does not read yet, continued by `+` lines; refused whole. `.ENDS` and
// `.ENDL` are not dot-commands of their own: outside their block they are a syntax error.
// spec: XY-UNS-001
unsupported_directive: DOT_NAME REST_TEXT* NL
%override DOT_NAME.4: /\.(?!(?:ends|endl)(?![a-z0-9_-]))[a-z][a-z0-9_-]*/i

// A `+` line after comment or blank lines that follow a refused dot-command, which joins it.
// spec: XY-UNS-001
continuation_line: PLUS_LINE LINE_END

// spec: XY-UNS-001
REST_TEXT.2: /[^ \t\r\n](?:[^\r\n]|\r(?!\n))*/
// spec: XY-UNS-001
PLUS_LINE.3: /\+(?:[^\r\n]|\r(?!\n))*/

// Names ([xyce-ref] §2.3.2 p184; decision 0027 item 3): printable ASCII except blanks and
// ( ) { } , : ; " ' =. `[` and `]` are name characters. A node field of an element line also
// takes `:`, a node path into an instance (decision X-D2); NODE_WORD is that field's terminal.
// spec: XY-NAM-001
_XY_CHAR: /[!#$%&*+\-.\/0-9<>?@A-Z\[\\\]^_`a-z|~]/
%override WORD.2: _XY_CHAR+
NODE_WORD.2: (_XY_CHAR | ":")+

// .PREPROCESS REPLACEGROUND TRUE|FALSE ([xyce-ref] §2.1.28 p125): one per netlist (the
// transformer refuses a second), allowed in a subcircuit body, and netlist-wide in effect.
// spec: XY-PRE-001
preprocess_stmt: PREPROCESS_KW pp_option pp_value (NL | eol)
pp_option: SEP REPLACEGROUND_KW
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_option
pp_value: SEP (TRUE_KW | FALSE_KW)
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_value
PREPROCESS_KW.4: ".preprocess"i
REPLACEGROUND_KW.2: "replaceground"i
TRUE_KW.2: "true"i
FALSE_KW.2: "false"i

// The other .PREPROCESS forms (REMOVEUNUSED, ADDRESISTORS, ...), refused whole.
// spec: XY-UNS-001
preprocess_other: PREPROCESS_KW pp_word REST_TEXT* NL
pp_word: SEP WORD
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_word

// .GLOBAL node... ([xyce-ref] §2.1.11 p44): top level only, at least one name, no commas.
// spec: XY-GLB-001
%override global_stmt: GLOBAL_KW global_node+ (NL | eol)
global_node: SEP WORD
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) global_node

// ---------------------------------------------------------------------------------------------
// Analyses and sweeps (X-M2 B2; decision 0028 items 3 and 4; xm2-tasks 5.1 points 7 to 17). Each
// is a top statement: in a subcircuit body Xyce silently ignores it, so it is refused there
// (not_in_subckt). Unbraced numbers are the device-field reader's (NUMBER, XY-NUM-001); `.TRAN`,
// `.AC` and `.DC` also take an expression in braces or quotes (`value`), `.STEP` takes none.
// Keywords fold case.

// .TRAN tstep tstop [tstart [tmax]] [NOOP] [UIC] [{schedule(...)}] ([xyce-ref] §2.1.38 p161):
// tstep is required; NOOP and UIC (synonyms) stand after the numbers, in either order, each at
// most once (the transformer refuses a repeat); then at most one schedule, an expression in braces
// or quotes whose head is `schedule(` in any case (blanks may stand around `schedule`, which Xyce
// runs), a field of its own (SCHEDULE_FORMULA outranks BRACE_FORMULA and QUOTE_FORMULA). The
// transformer refuses a schedule in a number's place. No comma, and none of LTspice's modifiers.
// spec: XY-TRN-001
xy_tran_stmt: TRAN_KW value value (value value?)? tran_flag* tran_schedule? (NL | eol)
tran_flag: SEP (NOOP_KW | UIC_KW)
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) tran_flag
tran_schedule: SEP SCHEDULE_FORMULA
             | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) tran_schedule
NOOP_KW.2: "noop"i
SCHEDULE_FORMULA.4: /\{[ \t]*schedule[ \t]*\([^{};\r\n]*\}|'[ \t]*schedule[ \t]*\([^'{};\r\n]*'/i

// .AC LIN|OCT|DEC points fstart fstop, or .AC DATA=table ([xyce-ref] §2.1.1 p24). No `list` and
// no `file=`.
// spec: XY-ACA-001
xy_ac_stmt: DOT_AC_KW ac_variation value value value (NL | eol)
          | DOT_AC_KW data_ref (NL | eol)

// DATA=table on .AC, .DC and .STEP ([xyce-ref] §2.1.1 p24, §2.1.3 p27, §2.1.36 p156): the
// keyword, whose lookahead finds the `=` (so a sweep target named `data` stays a name), blanks
// allowed around the `=`, then the table's name. It stands alone on its line.
// spec: XY-DCA-002
data_ref: SEP DATA_KW EQ WORD
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) data_ref
DATA_KW.4: /data(?=[ \t]*=)/i

// .DC: one or more sweeps, the first innermost ([xyce-ref] §2.1.3 p27–28), each
// `[LIN|DEC|OCT] target start stop step` or `target LIST v1 v2 ...` (at least two values), in
// any order; or DATA=table alone. The sweeps are right-recursive, so that a list's next value and
// the next sweep are told apart by the token after the separator, with nothing to reduce before
// it; the transformer groups the fields into sweeps.
// spec: XY-DCA-001
xy_dc_stmt: DOT_DC_KW _dc_sweeps
          | DOT_DC_KW data_ref (NL | eol)
_dc_sweeps: ac_variation? sweep_target value value value _dc_next
          | sweep_target list_keyword value value _dc_list
_dc_list: value _dc_list
        | _dc_next
_dc_next: _dc_sweeps
        | NL
        | eol
list_keyword: SEP LIST_KW
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) list_keyword
LIST_KW.2: "list"i

// A sweep target of .DC and .STEP: a source or device, `dev:param`, `model:param`, a path into
// an instance (`X1:R5:R`), TEMP or a parameter ([xyce-ref] §2.1.3 p27, §2.1.36 p155), in the
// name class with `:` (NODE_WORD). The transformer refuses a target that reads as a number, and
// an empty part around a `:`.
// spec: XY-STP-002
sweep_target: SEP NODE_WORD
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) sweep_target

// .STEP ([xyce-ref] §2.1.36 p155–158): one sweep per line, `[LIN|DEC|OCT] target start stop
// step`, `target LIST v1 v2 ...` (at least two values) or DATA=table, with plain numbers only.
// There is no `param` keyword: STEP_PARAM_KW, `param` before a name, is recognised with the rest
// of the line only to be refused, and so is a second sweep on the line (step_second), since
// Xyce runs only the last one.
// spec: XY-STP-001
xy_step_stmt: STEP_KW ac_variation? sweep_target step_value step_value step_value _step_end
            | STEP_KW sweep_target list_keyword step_value step_value+ _step_end
            | STEP_KW data_ref _step_end
            | STEP_KW xy_step_param
_step_end: step_second
         | NL
         | eol
step_value: SEP NUMBER
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) step_value
step_second: SEP NODE_WORD REST_TEXT* NL
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) step_second
xy_step_param: SEP STEP_PARAM_KW REST_TEXT* NL
             | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xy_step_param
STEP_KW.4: ".step"i
STEP_PARAM_KW.3: /param(?=[ \t]+[A-Za-z_])/i

// Numbers in a device field ([xyce-ug] Table 4-1 p42; decision 0027 item 8, observed on
// XyceNF 7.10.0): a number, then a scale factor (T, G, Meg, X, K, mil, m, u, n, p, f; `M` is
// milli), then a unit (a, amp, c, f, farad, h, henry, hertz, hy, hz, m, ohm, s, v, vdc, volt), in
// any case. A letter that begins a scale factor is the scale factor, as Xyce reads it: a unit
// without a scale factor may not begin with one, so `1farad` is femto followed by `arad`, refused,
// while `1pfarad` is a picofarad. The longer alternatives come first, and the lookahead makes the
// token end where its word ends, so a letter, digit or `.` after the closed lists is refused
// (`1kk`, `1keg`, `1e`, `2k7`, `µ`). The element lines of X-M1 B5 read their values with it.
// spec: XY-NUM-001
%override NUMBER.3: /[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:(?:meg|mil|[tgxkmunpf])(?:amp|farad|henry|hertz|ohm|vdc|volt|hy|hz|[acfhmsv])?|(?![tgxkmunpf])(?:amp|farad|henry|hertz|ohm|vdc|volt|hy|hz|[acfhmsv]))?(?![a-z0-9.])/i

// Numbers in an expression and a .PARAM value (decision 0027 item 8, observed): the same scale
// factors, then a unit of a, f, h, hz, m, s or v, then an optional `j`, the imaginary part
// ([xyce-ref] §2.2.1 p172). `1kohm` is refused here.
// spec: XY-NUM-002
EXPR_NUMBER.3: /[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:(?:meg|mil|[tgxkmunpf])(?:hz|[afhmsv])?|(?![tgxkmunpf])(?:hz|[afhmsv]))?j?(?![a-z0-9.])/i

// Expressions in braces or single quotes ([xyce-ref] §2.2 p164): the contents are not parsed here
// (formula_xyce.lark finds their names), and exclude only `{`, `}`, `;` and line ends (decision
// 0027 item 11), besides a quote's own delimiter.
// spec: XY-VAL-001
%override BRACE_FORMULA.3: /\{[^{};\r\n]+\}/
%override QUOTE_FORMULA.3: /'[^'{};\r\n]+'/

// A bare expression (decision X-D5, an exception to architecture §6.3 rule 10): in a .PARAM or
// .GLOBAL_PARAM value, an expression without blanks, which ends at a blank, a comma outside
// parentheses, `;` or the line end. Its lookahead refuses a word that begins like a number (a
// number, then letters, digits and dots, up to the end of the field), so a number stays
// EXPR_NUMBER and a number form the readers refuse (`1kohm`, `1kk`) is not taken as an expression.
// Parentheses nest three levels, and hold no blank either; non-ASCII is not an expression
// character. BLANK_TAIL is a blank inside a value, which is recognised only to be refused with a
// hint: blanks followed by something that is neither the next assignment, nor a comma, `;` or
// the line end.
// spec: XY-VAL-001
BARE_FORMULA.5: /(?![+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?[A-Za-z0-9.]*(?:[ \t\r\n,;]|$))(?:[<>!=]=|[^ \t\r\n=,;(){}'"\x80-\U0010ffff]|\((?:[^() \t\r\n;{}'"\x80-\U0010ffff]|\((?:[^() \t\r\n;{}'"\x80-\U0010ffff]|\([^() \t\r\n;{}'"\x80-\U0010ffff]*\))*\))*\))+/
BLANK_TAIL.12: /[ \t]+(?![ \t\r\n,;]|$)(?![A-Za-z_][A-Za-z0-9_.#@`]*(?:\([^()\r\n]*\))?[ \t]*=)(?:[^\r\n]|\r(?!\n))*/
blank_tail: BLANK_TAIL (NL | eol)

// .PARAM name=value, separated by blanks or commas (a comma may stand before a `+` line), and
// function assignments name(args)={body} ([xyce-ref] §2.1.26 p120, §2.1.10 p42). A value is a
// number (EXPR_NUMBER), a braced or quoted expression or a bare one; no strings. A reserved word,
// or a built-in function's name, is recognised only to be refused.
// spec: XY-PRM-001
param_stmt: PARAM_KW (param_def | func_def) (param_def | param_next | func_def | func_next)* _param_end
_param_end: NL | eol | blank_tail
_param_value: EXPR_NUMBER | BRACE_FORMULA | QUOTE_FORMULA | BARE_FORMULA
param_def: SEP PARAM_NAME EQ _param_value
         | SEP RESERVED_NAME EQ _param_value          -> reserved_def
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) param_def
param_next: CSEP PARAM_NAME EQ _param_value
          | CSEP RESERVED_NAME EQ _param_value        -> reserved_def
          | CSEP param_def
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) param_next

// Parameter names (decision 0027 item 9; point 27): a letter or `_`, then letters, digits, `_` and
// `.`. The reserved words ([xyce-ref] §2.1.26 p121, §2.1.10 p42) end where a name would.
// spec: XY-PRM-001
PARAM_NAME.2: /[A-Za-z_][A-Za-z0-9_.]*/
RESERVED_NAME.3: /(?:time|freq|hertz|vt|temp|temper|gmin|pi|exp)(?![A-Za-z0-9_.(])/i

// .GLOBAL_PARAM: as .PARAM, top level only, without functions (the transformer refuses one;
// [xyce-ref] §2.1.12 p45).
// spec: XY-PRM-002
global_param_stmt: GLOBAL_PARAM_KW (param_def | func_def) (param_def | param_next | func_def | func_next)* _param_end
GLOBAL_PARAM_KW.4: ".global_param"i

// A function: its name and `(`, one token, so no blank may stand between them; the arguments; then
// the body in braces or quotes. On .PARAM the `=` is required; on .FUNC it is optional, and
// one .FUNC defines one function ([xyce-ref] §2.1.10 p42–43). Function names may also hold `#`, `@`
// and the backtick. A built-in function or a reserved word ([xyce-ref] Tables 2-33 and 2-34
// p166–171) is recognised as BUILTIN_OPEN only to be refused, and so is a reserved word as an
// argument.
// spec: XY-FUN-001
func_stmt: FUNC_KW func_name func_args func_body (NL | eol)
func_name: SEP (FUNC_OPEN | BUILTIN_OPEN)
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) func_name
func_args: ((PARAM_NAME | RESERVED_NAME) (CSEP (PARAM_NAME | RESERVED_NAME))*)? RPAR
func_body: (BRACE_FORMULA | QUOTE_FORMULA)
         | EQ (BRACE_FORMULA | QUOTE_FORMULA)
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) func_body
func_def: SEP (FUNC_OPEN | BUILTIN_OPEN) func_args EQ (BRACE_FORMULA | QUOTE_FORMULA)
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) func_def
func_next: CSEP (FUNC_OPEN | BUILTIN_OPEN) func_args EQ (BRACE_FORMULA | QUOTE_FORMULA)
         | CSEP func_def
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) func_next
FUNC_KW.4: ".func"i
FUNC_OPEN.3: /[A-Za-z_][A-Za-z0-9_.#@`]*\(/
BUILTIN_OPEN.4: /(?:abs|ceil|ddt|ddx|floor|fmod|if|int|limit|m|min|max|nint|pwr|pow|pwrs|sdt|sgn|sign|stp|sqrt|uramp|table|fasttable|spline|akima|cubic|wodicka|bli|tablefile|db|img|ph|r|re|acos|acosh|arctan|asin|asinh|atan|atanh|atan2|cos|cosh|exp|ln|log|log10|sin|sinh|tan|tanh|agauss|gauss|aunif|unif|rand|spice_exp|spice_pulse|spice_sffm|spice_sin|time|freq|hertz|vt|temp|temper|gmin|pi)\(/i

// .SUBCKT name node+ [PARAMS:] [name=value]* ... .ENDS [name] ([xyce-ref] §2.1.37 p159–160;
// decision 0027 item 7). At least one port, never `0` (ZERO_PORT, re-typed from WORD, is
// recognised to be refused); `PARAMS:` is optional, the defaults take no comma and no bare value.
// A definition is a body statement, so definitions nest, and a nested one is local to its outer
// definition. The top-level-only statements are recognised in a body so that the transformer
// refuses them at their keyword (not_in_subckt). `.ENDS` may name a subcircuit, which Xyce does not
// check (the document layer reports a mismatch). A default's name is a parameter name
// (XY-PRM-001's class) whose lookahead finds the `=`, so a port is never read as one; a reserved
// word there is recognised only to be refused (RESERVED_DEFAULT), and a name outside the class
// (`1x=1`) is a syntax error, since Xyce stops on both (scoping.md S7).
// spec: XY-SBD-001
subckt_def: subckt_header subckt_item* ends_line
subckt_header: SUBCKT_KW x_name subckt_port+ params_marker? subckt_param* (NL | eol)
subckt_port: SEP (WORD | ZERO_PORT)
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) subckt_port
subckt_param: SEP DEFAULT_NAME EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
            | SEP RESERVED_DEFAULT EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA) -> reserved_default
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) subckt_param
?subckt_item: lead
            | body_statement
            | continuation_line
            | not_in_subckt
not_in_subckt: (GLOBAL_KW | GLOBAL_PARAM_KW | END_KW) REST_TEXT* NL
             | (TRAN_KW | DOT_AC_KW | DOT_DC_KW | OP_KW | STEP_KW) REST_TEXT* NL

// `PARAMS:` is one token, above WORD, which holds no `:`.
// spec: XY-SBD-001
params_marker: SEP PARAMS_KW
             | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) params_marker
PARAMS_KW.3: "params:"i
// spec: XY-SBD-001
DEFAULT_NAME.3: /[A-Za-z_][A-Za-z0-9_.]*(?=[ \t]*=)/
RESERVED_DEFAULT.4: /(?:time|freq|hertz|vt|temp|temper|gmin|pi|exp)(?=[ \t]*=)/i

// .MODEL name type, then name=value parameters, without or within one pair of parentheses, with
// no comma ([xyce-ref] §2.1.21 p89; decision 0027 item 7). A value is a number of the device
// reader or an expression in braces or quotes. Binned names (`nch.1`, §2.1.21.2 p90) are names.
// The transformer refuses a parameter written twice, which stops Xyce.
// spec: XY-MOD-001
model_stmt: MODEL_KW x_name x_name param* (NL | eol)
          | MODEL_KW x_name x_name model_paren (NL | eol)
model_paren: LPAR (model_param_first param*)? rparen
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) model_paren
model_param_first: WORD EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
                 | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) model_param_first

// .INC, .INCL and .INCLUDE take one path, in single or double quotes or none ([xyce-ref] §2.1.15
// p49), and may be continued by `+` lines. The statement is kept as opaque text.
// spec: XY-INC-001
include_line: (INC_KW | INCL_KW | INCLUDE_KW) path_field (NL | eol)
path_field: SEP PATH_FIELD
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) path_field
INC_KW.4: ".inc"i
INCL_KW.4: ".incl"i
INCLUDE_KW.4: ".include"i
PATH_FIELD.2: /"[^"\r\n]*"|'[^'\r\n]*'|[^ \t\r\n;'"]+/

// .LIB ([xyce-ref] §2.1.16 p50–51; decision 0027 item 7): with two or more fields, a call (a file
// and its entries), kept as opaque text; with one field, a definition, which opens a block closed
// by `.ENDL` and the same name (the transformer checks the name). The block's lines are never
// read. The opening line ends with its own NL, never the shared eol, so the state after it offers
// only the block's terminals (architecture test of M18 A2-19), and so do the block's lines.
// spec: XY-LIB-001
lib_call: LIB_KW path_field path_field+ (NL | eol)
lib_section: lib_open lib_text* lib_close
lib_open: LIB_KW path_field lib_open_end
lib_open_end: NL
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) lib_open_end
lib_text: (BLOCK_DOT_NAME | BLOCK_TEXT) BLOCK_TEXT* NL
        | LINE_END
lib_close: ENDL_KW path_field? (NL | eol)
LIB_KW.4: ".lib"i
ENDL_KW.4: ".endl"i
BLOCK_DOT_NAME.4: /\.[a-z][a-z0-9_-]*/i
BLOCK_TEXT.2: /[^ \t\r\n](?:[^\r\n]|\r(?!\n))*/

// ---------------------------------------------------------------------------------------------
// Element lines (X-M1 B5; decision 0027 items 5 and 6). Fields follow core.lark's design: each
// field rule is "gap, then field", so its token is lexed in a state that offers only what may
// stand there. A designator is the letter and the name class without `:` (XY-NAM-001); a node
// field takes NODE_WORD, which also holds `:` (decision X-D2). A model or subcircuit name is a
// WORD, which holds no `:`; on X every name is a NODE_WORD until the parser knows which is last,
// so the transformer refuses a `:` in the subcircuit's name. No comma separates fields.
// spec: XY-ELM-001
node: SEP NODE_WORD
    | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) node

// An instance parameter name=value: the name is one token whose lookahead finds the `=`, above
// WORD and NODE_WORD, so a name written before `=` is never a model or a node. Its value is a
// number of the device reader, an expression in braces or quotes, or a bare expression without
// blanks (decision X-D5). X takes any name, since its parameters are the subcircuit's; R, C, L
// and D take only their letter's closed list below, where INST_KEY is a name outside the list.
// spec: XY-ELM-001
inst_param: SEP INST_KEY EQ _inst_value
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) inst_param
_inst_value: NUMBER | BRACE_FORMULA | QUOTE_FORMULA | BARE_FORMULA
INST_KEY.3: /[A-Za-z_]/ _XY_CHAR* /(?=[ \t]*=)/

// The closed instance-parameter lists (xm1-tasks 5.1 point 29), in any case: the names of each
// device's instance-parameter tables in the reference guide, for every level of the device, since
// the level is the model's and the grammar does not see it. R: Table 2-42 (level 1) and Table 2-44
// (level 2, the thermal resistor), §2.3.7 p203–205; C: Table 2-37, §2.3.4 p187; L: Table 2-39,
// §2.3.5 p193; D: Table 2-46 (levels 1 and 2), Table 2-48 (level 200) and Table 2-51 (level
// 2002), §2.3.8 p208–213, without `OFF`, which is d_flag. `TC=` on R, C and L is xy_tc_param,
// and the value keywords `R=`, `C=` and `L=` and the charge `Q=` are XY-RCL-001's. A
// name outside the list is recognised as INST_KEY, with the rest of its line, only to be refused
// (the `*_unlisted` rules), since Xyce stops on it ("Unrecognized parameter"). K, V and I take no
// instance parameter, so a `name=` there is a syntax error.
// spec: XY-IPN-001
r_param: SEP R_PARAM_KW EQ _inst_value
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) r_param
c_param: SEP C_PARAM_KW EQ _inst_value
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) c_param
l_param: SEP L_PARAM_KW EQ _inst_value
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) l_param
d_param: SEP D_PARAM_KW EQ _inst_value
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) d_param
r_unlisted: SEP INST_KEY REST_TEXT* NL
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) r_unlisted
c_unlisted: SEP INST_KEY REST_TEXT* NL
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) c_unlisted
l_unlisted: SEP INST_KEY REST_TEXT* NL
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) l_unlisted
d_unlisted: SEP INST_KEY REST_TEXT* NL
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) d_unlisted
R_PARAM_KW.4: /(?:a|density|dtemp|heatcapacity|l|m|outputintvars|resistivity|tc1|tc2|tce|temp|thermal_a|thermal_heatcapacity|thermal_l|w)(?=[ \t]*=)/i
C_PARAM_KW.4: /(?:age|d|dtemp|ic|l|m|tc1|tc2|temp|w)(?=[ \t]*=)/i
L_PARAM_KW.4: /(?:dtemp|ic|m|tc1|tc2|temp)(?=[ \t]*=)/i
D_PARAM_KW.4: /(?:ab|area|dtemp|ic|lg|ls|m|mult|perim|pj|temp)(?=[ \t]*=)/i

// R, C and L ([xyce-ref] §2.3.7 p201, §2.3.4 p186, §2.3.5 p191; decision 0027 item 5): the nodes,
// the model if any, then the value, then parameters. A word after the nodes is the model, and a
// number is the value (decision 0024 item 7). A word after the value is the ngspice order,
// recognised only to be refused (late_model). `TC=a,b` takes one or two values ([xyce-ref]
// §2.3.7 p202). The value may instead be written as its parameter, `R=`, `C=` or `L=` (Tables
// 2-42, 2-37 and 2-39), and a C's charge as `Q=`: each has its own keyword terminal and rule, so
// the transformer tells them from the other parameters by rule, not by name. Which value forms
// each letter requires (the geometry forms), and that no keyword or parameter is written twice,
// is checked by the transformer.
// spec: XY-RCL-001
resistor: R_NAME node node _r_body
capacitor: C_NAME node node _c_body
inductor: L_NAME node node _l_body
_r_body: model? value? (r_param | r_keyword | xy_tc_param)* (r_unlisted | NL | eol)
       | value late_model
_c_body: model? value? (c_param | c_keyword | q_charge | xy_tc_param)* (c_unlisted | NL | eol)
       | value late_model
_l_body: model? value? (l_param | l_keyword | xy_tc_param)* (l_unlisted | NL | eol)
       | value late_model
xy_tc_param: SEP TC_KW EQ _inst_value (CSEP _inst_value)?
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xy_tc_param
late_model: SEP WORD REST_TEXT* NL
r_keyword: SEP R_VALUE_KW EQ _inst_value
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) r_keyword
c_keyword: SEP C_VALUE_KW EQ _inst_value
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) c_keyword
l_keyword: SEP L_VALUE_KW EQ _inst_value
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) l_keyword
q_charge: SEP Q_KW EQ _inst_value
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) q_charge
R_VALUE_KW.4: /r(?=[ \t]*=)/i
C_VALUE_KW.4: /c(?=[ \t]*=)/i
L_VALUE_KW.4: /l(?=[ \t]*=)/i
Q_KW.4: /q(?=[ \t]*=)/i
TC_KW.4: /tc(?=[ \t]*=)/i
R_NAME.4: /[Rr]/ _XY_CHAR*
C_NAME.4: /[Cc]/ _XY_CHAR*
L_NAME.4: /[Ll]/ _XY_CHAR*

// K ([xyce-ref] §2.3.6 p194; decision 0027 item 6): one or more inductors, the coupling, then an
// optional CORE model. The transformer requires the model for one inductor.
// spec: XY-MUT-001
mutual_coupling: K_NAME inductor_ref+ value model? (NL | eol)
inductor_ref: SEP L_REF
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) inductor_ref
K_NAME.4: /[Kk]/ _XY_CHAR*
L_REF.4: /[Ll]/ _XY_CHAR*

// D ([xyce-ref] §2.3.8 p207): the model, an optional positional area, then flags (`OFF`, or
// `OFF=` and a value) and parameters.
// spec: XY-DIO-001
diode: D_NAME node node model value? (d_param | d_flag)* (d_unlisted | NL | eol)
d_flag: SEP OFF_KW
      | SEP OFF_VALUE_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
      | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) d_flag
OFF_VALUE_KW.4: /off(?=[ \t]*=)/i
D_NAME.4: /[Dd]/ _XY_CHAR*

// V and I, their DC and AC parts ([xyce-ref] §2.3.10 p226, §2.3.9 p221; decision 0027 item 6):
// `[DC] value`, then `AC magnitude [phase]`, in that order, with no comma and no parameter. A bare
// `AC` is recognised only to be refused (ac_bare). A transient function (src_function) is
// recognised with the rest of its line only to be refused whole until X-M3.
// spec: XY-SRC-001
voltage_source: V_NAME node node _xsrc
current_source: I_NAME node node _xsrc
_xsrc: dc_spec? _xsrc_ac
_xsrc_ac: ac_spec value? _xsrc_end
        | ac_bare
        | _xsrc_end
_xsrc_end: src_function | NL | eol
ac_bare: SEP AC_KW (NL | eol)
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) ac_bare
src_function: SEP SRC_FN_KW REST_TEXT* NL
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) src_function
SRC_FN_KW.3: /(?:pulse|sin|exp|pwl|sffm|pat)(?![A-Za-z0-9_])/i
V_NAME.4: /[Vv]/ _XY_CHAR*
I_NAME.4: /[Ii]/ _XY_CHAR*

// X ([xyce-ref] §2.3.33 p803; decision 0027 item 6): nodes, the subcircuit, then `PARAMS:`
// (optional) and parameters, with no comma; `M=` is an ordinary parameter. The name list is right-recursive,
// as in core.lark, so a name is classified once the parser sees what follows it.
// spec: XY-SUB-001
subckt_instance: X_NAME node (x_node | x_last)
x_node: x_name_node (x_node | x_last)
x_last: x_name_node params_marker? inst_param* (NL | eol)
x_name_node: SEP NODE_WORD
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) x_name_node
X_NAME.4: /[Xx]/ _XY_CHAR*
