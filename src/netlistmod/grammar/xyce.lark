// xyce overlay on core.lark (decision 0026; X-M1, decision 0027). The dialect is hidden until X-M8.
// It reads the structure of a netlist ([xyce-ug] §4.1.1 p40, §4.1.3.1 p42–43): the title line,
// comment lines (`*`, or `;`, which may also end any line), blank lines, indented lines (a comment
// to Xyce, decision X-D1), `+` continuation across those lines (§4.1.3.2 p43), the final `.END`;
// the statements X-M1 B2 reads, `.PREPROCESS REPLACEGROUND` and `.GLOBAL`; those of B3,
// `.PARAM`, `.GLOBAL_PARAM` and `.FUNC`; and those of B4, `.SUBCKT`/`.ENDS`, `.MODEL`, the
// includes and `.LIB`. The names and the two number readers of decision 0027 items 3 and 8 are
// defined here for the statements and element lines that use them.
//
// The element lines of B5 are R, C, L, K, V and I (DC and AC parts), D and X; X-M3 adds P and the
// transient functions (decision 0030), X-M4 the transistors Q, J and Z (decision 0031). X-M2
// (decision 0028) reads the directives, and closes the list of dot-commands (B4, decision 0028 item 1): the
// typed ones, the untyped ones read as UnknownDirective (DOT_NAME), and `.PREPROCESS ADDRESISTORS`;
// any other dot-command has no terminal, so the parser stops at its first character and the
// loader raises a ParseError ("not an Xyce dot-command"). `.PREPROCESS REMOVEUNUSED` raises
// UnsupportedConstruct from the transformer; an element line of another letter has no rule, so
// the loader raises UnsupportedConstruct for its `planned` letter (xyce-devices.json), and A and N,
// which are not Xyce letters, are a ParseError. A `+` line after comment or blank lines that
// follow a refused line joins it, and is refused with it. A `+` line with only the title,
// comments and blank lines before it is a ParseError: the title is a comment, so there is no line
// for it to join.
//
// %ignore is not carried by %import, so it is declared again here. Every core rule and terminal
// used is imported by name, which keeps tree and token names unprefixed.
//
// Lexer priorities (decision 0003; Lark collision-checks only terminals of equal priority):
//  * INDENTED_LINE (10) outranks the ignored WS (9) at the start of a line, so an indented line
//    other than a `*`, `;` or `+` line is one token; a blank line is still WS and LINE_END.
//  * A statement's fields are separated by SEP (10). Its third alternative is the line end of a
//    line that a `+` line joins across blank, comment and indented lines: the lookahead finds the
//    `+` line, so the line end is a separator, not the NL that ends the statement. Each line
//    between is then a TRAILING_COMMENT (12, above SEP), which matches a `*` line or an indented
//    `*` or `;` line only right after a line end (a lookbehind), or an INDENTED_TRAILING (12),
//    which matches any other indented line there. So the comments of a continued statement stay
//    in its trailing_comments and its Line, and an indented line among them is still told apart
//    (decision X-D1). Every gap of a field rule takes all three, and the imported core rules with
//    a gap are extended with INDENTED_TRAILING.
//  * REST_TEXT (2) is the text after a refused line's keyword, to the end of the line.

%import .core (end_stmt, trailer, eol, global_stmt)
%import .core (WS, LINE_END, CONT, NL, TITLE_TEXT, COMMENT_LINE, END_KW, DOT_NAME)
%import .core (SEP, TRAILING_COMMENT, WORD, NUMBER, GLOBAL_KW)
%import .core (CSEP, EQ, BRACE_FORMULA, QUOTE_FORMULA, STRING_VALUE, PARAM_KW, RPAR)
%import .core (x_name, ends_line, param, rparen, MODEL_KW, LPAR, SUBCKT_KW, ENDS_KW, ZERO_PORT)
%import .core (value, model, dc_spec, dc_keyword, ac_spec, DC_KW, AC_KW, OFF_KW)
%import .core (TRAN_KW, UIC_KW, DOT_AC_KW, ac_variation, DEC_KW, OCT_KW, LIN_KW, DOT_DC_KW)
%import .core (op_stmt, OP_KW)
%import .core (OPTIONS_KW, OPTION_KW, IC_KW, NODESET_KW, V_OPEN, MEAS_KW, MEASURE_KW)

%ignore WS
%ignore CONT

// The lines before the first statement are `lead` lines, which a `+` line cannot follow.
// spec: XY-STR-001
start: first_line lead* (statement line*)? end_stmt

// The first line is always the title, even when it is blank or looks like a statement: Xyce has
// no `.TITLE`, so there is no explicit title.
// spec: XY-TTL-001
first_line: TITLE_TEXT LINE_END             -> implicit_title
          | LINE_END                        -> empty_title

// spec: XY-STR-001
?lead: LINE_END                             -> blank_line
     | COMMENT_LINE LINE_END                -> comment_line
     | indented_line

// spec: XY-STR-001
?line: lead
     | statement
     | continuation_line

// A body statement may also stand in a subcircuit body; a top statement only at the top level.
// spec: XY-STR-001
?statement: body_statement
          | top_statement

// The closed list of dot-commands (decision 0028 item 1): the statements below are every line the
// dialect reads, besides comments and blank lines. A dot-command that none of them begins with
// matches no terminal at a line start, so the parser stops at its `.` and the loader refuses it
// as not an Xyce dot-command (XY-DIR-002).
// spec: XY-DIR-002
?body_statement: preprocess_stmt
               | preprocess_addresistors
               | preprocess_removeunused
               | preprocess_other
               | param_stmt
               | func_stmt
               | subckt_def
               | model_stmt
               | include_line
               | lib_call
               | lib_section
               | resistor
               | capacitor
               | inductor
               | mutual_coupling
               | voltage_source
               | current_source
               | port_source
               | diode
               | bjt
               | jfet
               | mesfet
               | subckt_instance
               | xy_ic_stmt
               | xy_nodeset_stmt
               | stray_enddata
?top_statement: global_stmt
              | global_param_stmt
              | xy_tran_stmt
              | xy_ac_stmt
              | xy_dc_stmt
              | op_stmt
              | xy_step_stmt
              | xy_options_stmt
              | xy_meas_stmt
              | xy_print_stmt
              | data_block
              | xy_unknown_stmt

// A `*` comment line, and a line that begins with `;`, an in-line comment on a line of its own
// (§4.1.3.1 p43). An end-of-line comment starts at `;`, with or without a blank before it; the
// `*` alternative, and a `*` or `;` line with blanks before it, are lines that a `+` line joins
// across (XY-CNT-001).
// spec: XY-COM-001
%override COMMENT_LINE.3: /[*;](?:[^\r\n]|\r(?!\n))*/
%override TRAILING_COMMENT.12: /;(?:[^\r\n]|\r(?!\n))*|(?<=\n)(?:\*|[ \t]+[*;])(?:[^\r\n]|\r(?!\n))*/

// A `+` line continues the last line that is not a comment, across blank, comment (`*`, `;`) and
// indented lines (§4.1.3.2 p43; decision 0027 item 2).
// spec: XY-CNT-001
%override SEP.10: /[ \t]*\r?\n[ \t]*\+[ \t]*|[ \t]*\r?\n(?=(?:(?:[*;](?:[^\r\n]|\r(?!\n))*|[ \t]+(?:[^ \t\r\n+](?:[^\r\n]|\r(?!\n))*)?)?\r?\n)+[ \t]*\+)|[ \t]+/

// An indented line that is not a `*`, `;` or `+` line: a comment to Xyce ([xyce-ug] §4.1.3.1
// p43, [xyce-ref] §2.1.39.1 p163), read as a node of its own kind (decision X-D1).
// spec: XY-IND-001
indented_line: INDENTED_LINE LINE_END
INDENTED_LINE.10: /[ \t]+[^ \t\r\n+*;](?:[^\r\n]|\r(?!\n))*/

// The same line between a statement and its `+` line (XY-CNT-001): one of the statement's
// trailing comments, which the parser also records as an indented line, so that it is reported
// as one (INDENTED_LINE_IGNORED). The imported core rules with a gap take it too.
// spec: XY-IND-001
INDENTED_TRAILING.12: /(?<=\n)[ \t]+[^ \t\r\n+*;](?:[^\r\n]|\r(?!\n))*/
%extend eol: INDENTED_TRAILING (NL | eol)
%extend value: INDENTED_TRAILING value
%extend param: INDENTED_TRAILING param
%extend model: INDENTED_TRAILING model
%extend x_name: INDENTED_TRAILING x_name
%extend rparen: INDENTED_TRAILING rparen
%extend dc_keyword: INDENTED_TRAILING dc_keyword
%extend ac_spec: INDENTED_TRAILING ac_spec
%extend ac_variation: INDENTED_TRAILING ac_variation

// `.END` may end with a `;` comment, since `;` may end any line (§4.1.3.1 p43); nothing else may
// follow it on its line.
// spec: XY-END-001
%extend end_stmt: END_KW TRAILING_COMMENT LINE_END trailer* -> end
                | END_KW TRAILING_COMMENT -> end

// The closed list's untyped dot-commands (decision 0028 item 1; xm2-tasks 5.1 points 1 and 3;
// `.PRINT` has its own rule since X-M2.1, decision 0029 item 5): the outputs and the further
// analyses, read as UnknownDirective, top level only (in a body Xyce silently ignores them, so
// they are refused there, not_in_subckt), and continued by `+` lines, which Xyce joins. The
// name ends where its word ends (a lookahead), so `.prints` is not one. A field is a run of
// characters other than blanks and `;` (FIELD_TEXT); the statement's text is kept whole.
// `.SAVE` is this, never ngspice's `.save` (it writes an operating point and has no vectors).
// Any other dot-command matches no terminal, so the parser stops at it: the loader refuses it
// as not an Xyce dot-command, with a hint for some (`.TEMP`, `.PROBE`, `.title`, `.opt`), and
// the lines of a would-be block are never read.
// spec: XY-DIR-001
xy_unknown_stmt: (DOT_NAME | XY_SAVE_KW) unknown_field* (NL | eol)
unknown_field: SEP FIELD_TEXT
             | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) unknown_field
%override DOT_NAME.4: /\.(?:four|fft|result|sens|noise|hb|lin|sampling|embeddedsampling|pce)(?![^ \t\r\n;])/i
FIELD_TEXT.2: /[^ \t\r\n;]+/

// .SAVE ([xyce-ref] §2.1.34 p152), one of the untyped commands above, with a terminal of its own:
// it writes the operating point as `.IC` or `.NODESET` lines and has no vectors, so it is never
// ngspice's `.save` (core.lark's save_stmt, which this overlay does not import).
// spec: XY-SAV-001
XY_SAVE_KW.4: /\.save(?![^ \t\r\n;])/i

// A `+` line after comment or blank lines that follow a refused line, which joins it.
// spec: XY-UNS-001
continuation_line: PLUS_LINE LINE_END

// spec: XY-UNS-001
REST_TEXT.2: /[^ \t\r\n](?:[^\r\n]|\r(?!\n))*/
// spec: XY-UNS-001
PLUS_LINE.3: /\+(?:[^\r\n]|\r(?!\n))*/

// Names ([xyce-ref] §2.3.2 p184; decision 0027 item 3): printable ASCII except blanks and
// ( ) { } , : ; " ' =. `[` and `]` are name characters. A node field of an element line also
// takes `:`, a node path into an instance (decision X-D2); NODE_WORD is that field's terminal.
// spec: XY-NAM-001
_XY_CHAR: /[!#$%&*+\-.\/0-9<>?@A-Z\[\\\]^_`a-z|~]/
%override WORD.2: _XY_CHAR+
NODE_WORD.2: (_XY_CHAR | ":")+

// .PREPROCESS REPLACEGROUND TRUE|FALSE ([xyce-ref] §2.1.28 p125): one per netlist (the
// transformer refuses a second), allowed in a subcircuit body, and netlist-wide in effect.
// spec: XY-PRE-001
preprocess_stmt: PREPROCESS_KW pp_option pp_value (NL | eol)
pp_option: SEP REPLACEGROUND_KW
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_option
pp_value: SEP (TRUE_KW | FALSE_KW)
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_value
PREPROCESS_KW.4: ".preprocess"i
REPLACEGROUND_KW.2: "replaceground"i
TRUE_KW.2: "true"i
FALSE_KW.2: "false"i

// .PREPROCESS ADDRESISTORS ONETERMINAL|NODCPATH value ([xyce-ref] §2.1.30 p127; decision 0028
// item 1): it writes another netlist and leaves this run unchanged, so it is an UnknownDirective,
// allowed in a subcircuit body as REPLACEGROUND is; one of each kind per netlist (the transformer
// refuses a second). The value is a plain number of the device-field reader. Another word in the
// kind's place is recognised with the rest of the line only to be refused (pp_bad_kind).
// spec: XY-PRE-002
preprocess_addresistors: PREPROCESS_KW pp_addresistors pp_kind pp_number (NL | eol)
                       | PREPROCESS_KW pp_addresistors pp_bad_kind
pp_addresistors: SEP ADDRESISTORS_KW
               | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_addresistors
pp_kind: SEP (ONETERMINAL_KW | NODCPATH_KW)
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_kind
pp_number: SEP NUMBER
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_number
pp_bad_kind: SEP WORD REST_TEXT* NL
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_bad_kind
ADDRESISTORS_KW.2: "addresistors"i
ONETERMINAL_KW.2: "oneterminal"i
NODCPATH_KW.2: "nodcpath"i

// .PREPROCESS REMOVEUNUSED ([xyce-ref] §2.1.29 p126) deletes devices, so it changes the circuit
// (P4): refused whole as unsupported, until X-M4.
// spec: XY-UNS-001
preprocess_removeunused: PREPROCESS_KW pp_removeunused REST_TEXT* NL
pp_removeunused: SEP REMOVEUNUSED_KW
               | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_removeunused
REMOVEUNUSED_KW.2: "removeunused"i

// Any other word after .PREPROCESS is not one of its forms, recognised with the rest of the line
// only to be refused.
// spec: XY-PRE-002
preprocess_other: PREPROCESS_KW pp_word REST_TEXT* NL
pp_word: SEP WORD
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pp_word

// .GLOBAL node... ([xyce-ref] §2.1.11 p44): top level only, at least one name, no commas.
// spec: XY-GLB-001
%override global_stmt: GLOBAL_KW global_node+ (NL | eol)
global_node: SEP WORD
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) global_node

// ---------------------------------------------------------------------------------------------
// Analyses and sweeps (X-M2 B2; decision 0028 items 3 and 4; xm2-tasks 5.1 points 7 to 17). Each
// is a top statement: in a subcircuit body Xyce silently ignores it, so it is refused there
// (not_in_subckt). Unbraced numbers are the device-field reader's (NUMBER, XY-NUM-001); `.TRAN`,
// `.AC` and `.DC` also take an expression in braces or quotes (`value`), `.STEP` takes none.
// Keywords fold case.

// .TRAN tstep tstop [tstart [tmax]] [NOOP] [UIC] [{schedule(...)}] ([xyce-ref] §2.1.38 p161):
// tstep is required; NOOP and UIC (synonyms) stand after the numbers, in either order, each at
// most once (the transformer refuses a repeat); then at most one schedule, an expression in braces
// or quotes whose head is `schedule(` in any case (blanks may stand around `schedule`, which Xyce
// runs), a field of its own (SCHEDULE_FORMULA outranks BRACE_FORMULA and QUOTE_FORMULA). A
// schedule in tstep's or tstop's place (tran_early_schedule) is recognised with the rest of the
// line only to be refused; in tstart's or tmax's place it is the schedule, and what follows it is
// refused. No comma, and none of LTspice's modifiers.
// spec: XY-TRN-001
xy_tran_stmt: TRAN_KW value value (value value?)? tran_flag* tran_schedule? (NL | eol)
            | TRAN_KW value? tran_early_schedule
tran_early_schedule: SEP SCHEDULE_FORMULA REST_TEXT* NL
                   | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) tran_early_schedule
tran_flag: SEP (NOOP_KW | UIC_KW)
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) tran_flag
tran_schedule: SEP SCHEDULE_FORMULA
             | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) tran_schedule
NOOP_KW.2: "noop"i
SCHEDULE_FORMULA.4: /\{[ \t]*schedule[ \t]*\([^{};\r\n]*\}|'[ \t]*schedule[ \t]*\([^'{};\r\n]*'/i

// .AC LIN|OCT|DEC points fstart fstop, or .AC DATA=table ([xyce-ref] §2.1.1 p24). No `list` and
// no `file=`.
// spec: XY-ACA-001
xy_ac_stmt: DOT_AC_KW ac_variation value value value (NL | eol)
          | DOT_AC_KW data_ref (NL | eol)

// DATA=table on .AC, .DC and .STEP ([xyce-ref] §2.1.1 p24, §2.1.3 p27, §2.1.36 p156): the
// keyword, whose lookahead finds the `=` (so a sweep target named `data` stays a name), blanks
// allowed around the `=`, then the table's name. It stands alone on its line.
// spec: XY-DCA-002
data_ref: SEP DATA_KW EQ WORD
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) data_ref
DATA_KW.4: /data(?=[ \t]*=)/i

// .DC: one or more sweeps, the first innermost ([xyce-ref] §2.1.3 p27–28), each
// `[LIN|DEC|OCT] target start stop step` or `target LIST v1 v2 ...` (at least two values), in
// any order; or DATA=table alone. The sweeps are right-recursive, so that a list's next value and
// the next sweep are told apart by the token after the separator, with nothing to reduce before
// it; the transformer groups the fields into sweeps.
// spec: XY-DCA-001
xy_dc_stmt: DOT_DC_KW _dc_sweeps
          | DOT_DC_KW data_ref (NL | eol)
_dc_sweeps: ac_variation? sweep_target value value value _dc_next
          | sweep_target list_keyword value value _dc_list
_dc_list: value _dc_list
        | _dc_next
_dc_next: _dc_sweeps
        | NL
        | eol
list_keyword: SEP LIST_KW
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) list_keyword
LIST_KW.2: "list"i

// A sweep target of .DC and .STEP: a source or device, `dev:param`, `model:param`, a path into
// an instance (`X1:R5:R`), TEMP or a parameter ([xyce-ref] §2.1.3 p27, §2.1.36 p155), in the
// name class with `:` (NODE_WORD). The transformer refuses a target that reads as a number, and
// an empty part around a `:`.
// spec: XY-STP-002
sweep_target: SEP NODE_WORD
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) sweep_target

// .STEP ([xyce-ref] §2.1.36 p155–158): one sweep per line, `[LIN|DEC|OCT] target start stop
// step`, `target LIST v1 v2 ...` (at least two values) or DATA=table, with plain numbers only.
// There is no `param` keyword: STEP_PARAM_KW, `param` before a name other than LIST, is
// recognised with the rest of the line only to be refused, and so is a second sweep on the line
// (step_second), since Xyce runs only the last one. `.STEP param LIST 1k 2k` sweeps a parameter
// named `param`, as Xyce runs it. The lookahead spells out every word but `list` (a word that
// does not begin with `l`, or that leaves `list` at its second, third, fourth or fifth letter)
// rather than nesting a negative lookahead, so that Lark still checks it for collisions.
// spec: XY-STP-001
xy_step_stmt: STEP_KW ac_variation? sweep_target step_value step_value step_value _step_end
            | STEP_KW sweep_target list_keyword step_value step_value+ _step_end
            | STEP_KW data_ref _step_end
            | STEP_KW xy_step_param
_step_end: step_second
         | NL
         | eol
step_value: SEP NUMBER
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) step_value
step_second: SEP NODE_WORD REST_TEXT* NL
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) step_second
xy_step_param: SEP STEP_PARAM_KW REST_TEXT* NL
             | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xy_step_param
STEP_KW.4: ".step"i
STEP_PARAM_KW.3: /param(?=[ \t]+(?:[a-km-z_]|l(?:[^i]|i(?:[^s]|s(?:[^t]|t[^ \t\r\n;])))))/i

// ---------------------------------------------------------------------------------------------
// Options, initial conditions, measurements and the .DATA block (X-M2 B3; decision 0028 items 2
// and 5 to 8; xm2-tasks 5.1 points 18 to 27). `.OPTIONS`, `.MEAS` and `.DATA` are top statements,
// which Xyce silently ignores in a subcircuit body (not_in_subckt); `.IC`, `.DCVOLT` and
// `.NODESET` are body statements, since Xyce applies them in every instance. Keywords fold case.

// .OPTIONS pkg name=value ... and .OPTION, a full synonym ([xyce-ref] §2.1.25 p96): a package of
// the manual's 21, in any case (OPT_PACKAGE_KW, whose lookahead makes it end where its word
// ends). Another word in its place is recognised only to be refused with the closest package,
// and so is a line without a package (an item or nothing after the keyword), except
// `.OPTION SCALE=v`, singular with one item (§2.1.25.21 p119), which the transformer reads with
// no package. A package with no item is refused too.
// spec: XY-OPT-001
xy_options_stmt: (OPTIONS_KW | OPTION_KW) opt_package (opt_item | opt_extra)* (NL | eol)
               | (OPTIONS_KW | OPTION_KW) opt_item (opt_item | opt_extra)* (NL | eol)
               | (OPTIONS_KW | OPTION_KW) (NL | eol)
opt_package: SEP (OPT_PACKAGE_KW | WORD)
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) opt_package
OPT_PACKAGE_KW.4: /(?:device|diagnostic|timeint|nonlin-tran|nonlin-hb|nonlin|loca|linsol-hb|linsol-ac|linsol|output|restart|samples|embeddedsamples|pces|sensitivity|hbint|dist|fft|measure|parser)(?![^ \t\r\n;])/i

// An item is name=value, its name open (OPT_KEY, a letter or `_` and name characters, whose
// lookahead finds the `=`), blanks allowed around the `=`. A value is a number of the
// device-field reader, a word, an expression in braces or quotes, or a comma list of them (blanks
// after a comma allowed); the transformer refuses braces and quotes outside SAMPLES and
// EMBEDDEDSAMPLES. A field after an item that is not name=value (opt_extra) is recognised so that
// the transformer reads OUTPUT's and RESTART's `INITIAL_INTERVAL=i [t i]*` pairs, and refuses it
// anywhere else, as a bare word or value.
// spec: XY-OPT-002
opt_item: SEP OPT_KEY EQ _opt_value (CSEP _opt_value)*
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) opt_item
opt_extra: SEP _opt_value
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) opt_extra
_opt_value: NUMBER | WORD | BRACE_FORMULA | QUOTE_FORMULA
OPT_KEY.3: /[A-Za-z_]/ _XY_CHAR* /(?=[ \t]*=)/

// .IC and .DCVOLT, a synonym that builds the same node ([xyce-ref] §2.1.14 p48, §2.1.4 p29):
// `V(node)=value` conditions (blanks allowed around the `=`) or `node value` pairs, several on a
// line; the transformer refuses a line that mixes the two forms, a line with none, and a last
// node without its value (Xyce hangs on an odd count). A node is a NODE_WORD (a `:` path into an
// instance, a `$G` global); a value is a number of the device-field reader or an expression in
// braces or quotes. A current `I(...)`, `all=` and a differential `V(a,b)` are recognised with
// the rest of the line only to be refused (ic_refused). V_OPEN outranks NODE_WORD, so `v(` opens
// a condition while a node named `v` is a name.
// spec: XY-ICN-001
xy_ic_stmt: (IC_KW | DCVOLT_KW) _ic_conditions
_ic_conditions: (ic_voltage | node value)* (node? (NL | eol) | ic_refused)
ic_voltage: SEP V_OPEN NODE_WORD RPAR EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) ic_voltage
ic_refused: SEP (IC_CURRENT_OPEN | ALL_KW) REST_TEXT* NL
          | SEP V_OPEN NODE_WORD CSEP REST_TEXT* NL
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) ic_refused
DCVOLT_KW.4: ".dcvolt"i
%override V_OPEN.4: /[vV]\(/
IC_CURRENT_OPEN.4: /[iI]\(/
ALL_KW.4: /all(?=[ \t]*=)/i

// .NODESET: the forms of .IC ([xyce-ref] §2.1.22 p92).
// spec: XY-NOD-001
xy_nodeset_stmt: NODESET_KW _ic_conditions

// .PRINT ([xyce-ref] §2.1.31 p128; decision 0029 item 5), typed shallowly as `.MEASURE` is: a print
// type of the manual's closed list (PRINT_TYPE_KW: the analyses' types AC, AC_IC, DC, ES, HB,
// HB_FD, HB_IC, HB_STARTUP, HB_TD, NOISE, PCE and TRAN of its table, and HOMOTOPY, SENS and
// TRANADJOINT of §2.1.31.6 and §2.1.31.7), required, first, in any case, ending where its word
// ends; another field in its place, or none, is recognised with the rest of the line only to be
// refused. Then at least one field, kept as text (each a FIELD_TEXT), across `+` lines. Top level
// only: in a body Xyce silently ignores it (not_in_subckt).
// spec: XY-PRT-001
xy_print_stmt: XY_PRINT_KW print_type print_field+ (NL | eol)
             | XY_PRINT_KW print_bad_type
             | XY_PRINT_KW print_type (NL | eol) -> print_no_field
             | XY_PRINT_KW (NL | eol) -> print_no_type
print_type: SEP PRINT_TYPE_KW
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) print_type
print_bad_type: SEP FIELD_TEXT REST_TEXT* NL
              | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) print_bad_type
print_field: SEP FIELD_TEXT
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) print_field
XY_PRINT_KW.4: /\.print(?![^ \t\r\n;])/i
PRINT_TYPE_KW.4: /(?:ac_ic|ac|dc|es|hb_fd|hb_ic|hb_startup|hb_td|hb|noise|pce|tranadjoint|tran|homotopy|sens)(?![^ \t\r\n;])/i

// .MEASURE and .MEAS ([xyce-ref] §2.1.18 p54, §2.1.19 p78, §2.1.20 p84), typed shallowly as on the
// other dialects: a mode of the manual's closed list (TRAN, DC, AC, NOISE, FFT and their `_CONT`
// forms but FFT's), required, in any case (MEAS_MODE_KW, which ends where its word ends; another
// word in its place is recognised with the rest of the line only to be refused); the result name;
// then at least one field of the body, kept as text (each field a run of characters other than
// blanks and `;`), across `+` lines.
// spec: XY-MEA-001
xy_meas_stmt: (MEAS_KW | MEASURE_KW) meas_mode x_name meas_field+ (NL | eol)
            | (MEAS_KW | MEASURE_KW) meas_bad_mode
meas_mode: SEP MEAS_MODE_KW
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) meas_mode
meas_bad_mode: SEP WORD REST_TEXT* NL
             | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) meas_bad_mode
meas_field: SEP FIELD_TEXT
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) meas_field
MEAS_MODE_KW.4: /(?:tran_cont|dc_cont|ac_cont|noise_cont|tran|dc|ac|noise|fft)(?![^ \t\r\n;])/i

// .DATA name column... value... and .ENDDATA ([xyce-ref] §2.1.2 p26), a block read as opaque. The
// .DATA statement, continued by `+` lines (comment, blank and indented lines may stand between
// them), holds the table's name, its column names, then its values, read as a stream. A field is
// a NODE_WORD, since a column is a sweep target (a parameter, a device, `dev:param` or
// `model:param`, XY-STP-002), or a number, which outranks it. The transformer checks that the
// name is a name without `:` and the columns are sweep targets, that the values are plain numbers
// of the device-field reader (an expression in braces or quotes is recognised only to be
// refused), and that their count is a non-zero multiple of the columns. Comment, blank and
// indented lines may stand before `.ENDDATA`, which is required and bare (a name after it is
// recognised only to be refused). The statement ends with its own NL (data_open_end), never the
// shared eol, so the state after it offers only the block's lines. A `.ENDDATA` that closes no
// `.DATA` is recognised with the rest of its line only to be refused (stray_enddata).
// spec: XY-DAT-001
data_block: DATA_BLOCK_KW data_field+ data_open_end lead* data_close
data_field: SEP (NODE_WORD | NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) data_field
data_open_end: NL
             | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) data_open_end
data_close: ENDDATA_KW data_close_name? (NL | eol)
data_close_name: SEP WORD
               | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) data_close_name
stray_enddata: ENDDATA_KW REST_TEXT* NL
DATA_BLOCK_KW.4: ".data"i
ENDDATA_KW.4: ".enddata"i

// Numbers in a device field ([xyce-ug] Table 4-1 p42; decision 0027 item 8, observed on
// XyceNF 7.10.0): a number, then a scale factor (T, G, Meg, X, K, mil, m, u, n, p, f; `M` is
// milli), then a unit (a, amp, c, f, farad, h, henry, hertz, hy, hz, m, ohm, s, v, vdc, volt), in
// any case. A letter that begins a scale factor is the scale factor, as Xyce reads it: a unit
// without a scale factor may not begin with one, so `1farad` is femto followed by `arad`, refused,
// while `1pfarad` is a picofarad. The longer alternatives come first, and the lookahead makes the
// token end where its word ends, so a letter, digit or `.` after the closed lists is refused
// (`1kk`, `1keg`, `1e`, `2k7`, `µ`). The element lines of X-M1 B5 read their values with it.
// spec: XY-NUM-001
%override NUMBER.3: /[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:(?:meg|mil|[tgxkmunpf])(?:amp|farad|henry|hertz|ohm|vdc|volt|hy|hz|[acfhmsv])?|(?![tgxkmunpf])(?:amp|farad|henry|hertz|ohm|vdc|volt|hy|hz|[acfhmsv]))?(?![a-z0-9.])/i

// Numbers in an expression and a .PARAM value (decision 0027 item 8, observed): the same scale
// factors, then a unit of a, f, h, hz, m, s or v, then an optional `j`, the imaginary part
// ([xyce-ref] §2.2.1 p172). `1kohm` is refused here.
// spec: XY-NUM-002
EXPR_NUMBER.3: /[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:(?:meg|mil|[tgxkmunpf])(?:hz|[afhmsv])?|(?![tgxkmunpf])(?:hz|[afhmsv]))?j?(?![a-z0-9.])/i

// Expressions in braces or single quotes ([xyce-ref] §2.2 p164): the contents are not parsed here
// (formula_xyce.lark finds their names), and exclude only `{`, `}`, `;` and line ends (decision
// 0027 item 11), besides a quote's own delimiter.
// spec: XY-VAL-001
%override BRACE_FORMULA.3: /\{[^{};\r\n]+\}/
%override QUOTE_FORMULA.3: /'[^'{};\r\n]+'/

// A bare expression (decision X-D5, an exception to architecture §6.3 rule 10): in a .PARAM or
// .GLOBAL_PARAM value, an expression without blanks, which ends at a blank, a comma outside
// parentheses, `;` or the line end. Its lookahead refuses a word that begins like a number (a
// number, then letters, digits and dots, up to the end of the field), so a number stays
// EXPR_NUMBER and a number form the readers refuse (`1kohm`, `1kk`) is not taken as an expression.
// Parentheses nest three levels, and hold no blank either; non-ASCII is not an expression
// character. BLANK_TAIL is a blank inside a value, which is recognised only to be refused with a
// hint: blanks followed by something that is neither the next assignment, nor a comma, `;` or
// the line end.
// spec: XY-VAL-001
BARE_FORMULA.5: /(?![+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?[A-Za-z0-9.]*(?:[ \t\r\n,;]|$))(?:[<>!=]=|[^ \t\r\n=,;(){}'"\x80-\U0010ffff]|\((?:[^() \t\r\n;{}'"\x80-\U0010ffff]|\((?:[^() \t\r\n;{}'"\x80-\U0010ffff]|\([^() \t\r\n;{}'"\x80-\U0010ffff]*\))*\))*\))+/
BLANK_TAIL.12: /[ \t]+(?![ \t\r\n,;]|$)(?![A-Za-z_][A-Za-z0-9_.#@`]*(?:\([^()\r\n]*\))?[ \t]*=)(?:[^\r\n]|\r(?!\n))*/
blank_tail: BLANK_TAIL (NL | eol)

// .PARAM name=value, separated by blanks or commas (a comma may stand before a `+` line), and
// function assignments name(args)={body} ([xyce-ref] §2.1.26 p120, §2.1.10 p42). A value is a
// number (EXPR_NUMBER), a braced or quoted expression or a bare one; no strings. A reserved word,
// or a built-in function's name, is recognised only to be refused.
// spec: XY-PRM-001
param_stmt: PARAM_KW (param_def | func_def) (param_def | param_next | func_def | func_next)* _param_end
_param_end: NL | eol | blank_tail
_param_value: EXPR_NUMBER | BRACE_FORMULA | QUOTE_FORMULA | BARE_FORMULA
param_def: SEP PARAM_NAME EQ _param_value
         | SEP RESERVED_NAME EQ _param_value          -> reserved_def
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) param_def
param_next: CSEP PARAM_NAME EQ _param_value
          | CSEP RESERVED_NAME EQ _param_value        -> reserved_def
          | CSEP param_def
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) param_next

// Parameter names (decision 0027 item 9; point 27): a letter or `_`, then letters, digits, `_` and
// `.`. The reserved words ([xyce-ref] §2.1.26 p121, §2.1.10 p42) end where a name would.
// spec: XY-PRM-001
PARAM_NAME.2: /[A-Za-z_][A-Za-z0-9_.]*/
RESERVED_NAME.3: /(?:time|freq|hertz|vt|temp|temper|gmin|pi|exp)(?![A-Za-z0-9_.(])/i

// .GLOBAL_PARAM: as .PARAM, top level only, without functions (the transformer refuses one;
// [xyce-ref] §2.1.12 p45).
// spec: XY-PRM-002
global_param_stmt: GLOBAL_PARAM_KW (param_def | func_def) (param_def | param_next | func_def | func_next)* _param_end
GLOBAL_PARAM_KW.4: ".global_param"i

// A function: its name and `(`, one token, so no blank may stand between them; the arguments; then
// the body in braces or quotes. On .PARAM the `=` is required; on .FUNC it is optional, and
// one .FUNC defines one function ([xyce-ref] §2.1.10 p42–43). Function names may also hold `#`, `@`
// and the backtick. A built-in function or a reserved word ([xyce-ref] Tables 2-33 and 2-34
// p166–171) is recognised as BUILTIN_OPEN only to be refused, and so is a reserved word as an
// argument.
// spec: XY-FUN-001
func_stmt: FUNC_KW func_name func_args func_body (NL | eol)
func_name: SEP (FUNC_OPEN | BUILTIN_OPEN)
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) func_name
func_args: ((PARAM_NAME | RESERVED_NAME) (CSEP (PARAM_NAME | RESERVED_NAME))*)? RPAR
func_body: (BRACE_FORMULA | QUOTE_FORMULA)
         | EQ (BRACE_FORMULA | QUOTE_FORMULA)
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) func_body
func_def: SEP (FUNC_OPEN | BUILTIN_OPEN) func_args EQ (BRACE_FORMULA | QUOTE_FORMULA)
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) func_def
func_next: CSEP (FUNC_OPEN | BUILTIN_OPEN) func_args EQ (BRACE_FORMULA | QUOTE_FORMULA)
         | CSEP func_def
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) func_next
FUNC_KW.4: ".func"i
FUNC_OPEN.3: /[A-Za-z_][A-Za-z0-9_.#@`]*\(/
BUILTIN_OPEN.4: /(?:abs|ceil|ddt|ddx|floor|fmod|if|int|limit|m|min|max|nint|pwr|pow|pwrs|sdt|sgn|sign|stp|sqrt|uramp|table|fasttable|spline|akima|cubic|wodicka|bli|tablefile|db|img|ph|r|re|acos|acosh|arctan|asin|asinh|atan|atanh|atan2|cos|cosh|exp|ln|log|log10|sin|sinh|tan|tanh|agauss|gauss|aunif|unif|rand|spice_exp|spice_pulse|spice_sffm|spice_sin|time|freq|hertz|vt|temp|temper|gmin|pi)\(/i

// .SUBCKT name node+ [PARAMS:] [name=value]* ... .ENDS [name] ([xyce-ref] §2.1.37 p159–160;
// decision 0027 item 7). At least one port, never `0` (ZERO_PORT, re-typed from WORD, is
// recognised to be refused); `PARAMS:` is optional, the defaults take no comma and no bare value.
// A definition is a body statement, so definitions nest, and a nested one is local to its outer
// definition. The top-level-only statements are recognised in a body so that the transformer
// refuses them at their keyword (not_in_subckt). `.ENDS` may name a subcircuit, which Xyce does not
// check (the document layer reports a mismatch). A default's name is a parameter name
// (XY-PRM-001's class) whose lookahead finds the `=`, so a port is never read as one; a reserved
// word there is recognised only to be refused (RESERVED_DEFAULT), and a name outside the class
// (`1x=1`) is a syntax error, since Xyce stops on both (scoping.md S7).
// spec: XY-SBD-001
subckt_def: subckt_header subckt_item* ends_line
subckt_header: SUBCKT_KW x_name subckt_port+ params_marker? subckt_param* (NL | eol)
subckt_port: SEP (WORD | ZERO_PORT)
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) subckt_port
subckt_param: SEP DEFAULT_NAME EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
            | SEP RESERVED_DEFAULT EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA) -> reserved_default
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) subckt_param
?subckt_item: lead
            | body_statement
            | continuation_line
            | not_in_subckt

// The top statements in a body (decision 0028 item 2; xm2-tasks 5.1 point 5), each recognised
// with the rest of its line only to be refused at its keyword: Xyce stops on `.GLOBAL`,
// `.GLOBAL_PARAM` and `.END` there, and silently ignores the analyses, `.STEP`, `.OPTIONS`, `.MEAS`,
// `.DATA` and the closed list's untyped commands, which the refusal says. `.IC`, `.DCVOLT`,
// `.NODESET` and `.PREPROCESS` are body statements.
// spec: XY-DIR-003
not_in_subckt: (GLOBAL_KW | GLOBAL_PARAM_KW | END_KW) REST_TEXT* NL
             | (TRAN_KW | DOT_AC_KW | DOT_DC_KW | OP_KW | STEP_KW) REST_TEXT* NL
             | (OPTIONS_KW | OPTION_KW | MEAS_KW | MEASURE_KW | DATA_BLOCK_KW) REST_TEXT* NL
             | (DOT_NAME | XY_SAVE_KW | XY_PRINT_KW) REST_TEXT* NL

// `PARAMS:` is one token, above WORD, which holds no `:`.
// spec: XY-SBD-001
params_marker: SEP PARAMS_KW
             | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) params_marker
PARAMS_KW.3: "params:"i
// spec: XY-SBD-001
DEFAULT_NAME.3: /[A-Za-z_][A-Za-z0-9_.]*(?=[ \t]*=)/
RESERVED_DEFAULT.4: /(?:time|freq|hertz|vt|temp|temper|gmin|pi|exp)(?=[ \t]*=)/i

// .MODEL name type, then name=value parameters, without or within one pair of parentheses, with
// no comma ([xyce-ref] §2.1.21 p89; decision 0027 item 7). A value is a number of the device
// reader or an expression in braces or quotes. Binned names (`nch.1`, §2.1.21.2 p90) are names.
// The transformer refuses a parameter written twice, which stops Xyce.
// spec: XY-MOD-001
model_stmt: MODEL_KW x_name x_name param* (NL | eol)
          | MODEL_KW x_name x_name model_paren (NL | eol)
model_paren: LPAR (model_param_first param*)? rparen
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) model_paren
model_param_first: WORD EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
                 | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) model_param_first

// .INC, .INCL and .INCLUDE take one path, in single or double quotes or none ([xyce-ref] §2.1.15
// p49), and may be continued by `+` lines. The statement is kept as opaque text.
// spec: XY-INC-001
include_line: (INC_KW | INCL_KW | INCLUDE_KW) path_field (NL | eol)
path_field: SEP PATH_FIELD
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) path_field
INC_KW.4: ".inc"i
INCL_KW.4: ".incl"i
INCLUDE_KW.4: ".include"i
PATH_FIELD.2: /"[^"\r\n]*"|'[^'\r\n]*'|[^ \t\r\n;'"]+/

// .LIB ([xyce-ref] §2.1.16 p50–51; decision 0027 item 7): with two or more fields, a call (a file
// and its entries), kept as opaque text; with one field, a definition, which opens a block closed
// by `.ENDL` and the same name (the transformer checks the name). The block's lines are never
// read. The opening line ends with its own NL, never the shared eol, so the state after it offers
// only the block's terminals (architecture test of M18 A2-19), and so do the block's lines.
// spec: XY-LIB-001
lib_call: LIB_KW path_field path_field+ (NL | eol)
lib_section: lib_open lib_text* lib_close
lib_open: LIB_KW path_field lib_open_end
lib_open_end: NL
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) lib_open_end
lib_text: (BLOCK_DOT_NAME | BLOCK_TEXT) BLOCK_TEXT* NL
        | LINE_END
lib_close: ENDL_KW path_field? (NL | eol)
LIB_KW.4: ".lib"i
ENDL_KW.4: ".endl"i
BLOCK_DOT_NAME.4: /\.[a-z][a-z0-9_-]*/i
BLOCK_TEXT.2: /[^ \t\r\n](?:[^\r\n]|\r(?!\n))*/

// ---------------------------------------------------------------------------------------------
// Element lines (X-M1 B5; decision 0027 items 5 and 6). Fields follow core.lark's design: each
// field rule is "gap, then field", so its token is lexed in a state that offers only what may
// stand there. A designator is the letter and the name class without `:` (XY-NAM-001); a node
// field takes NODE_WORD, which also holds `:` (decision X-D2). A model or subcircuit name is a
// WORD, which holds no `:`; on X every name is a NODE_WORD until the parser knows which is last,
// so the transformer refuses a `:` in the subcircuit's name. No comma separates fields.
// spec: XY-ELM-001
node: SEP NODE_WORD
    | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) node

// An instance parameter name=value: the name is one token whose lookahead finds the `=`, above
// WORD and NODE_WORD, so a name written before `=` is never a model or a node. Its value is a
// number of the device reader, an expression in braces or quotes, or a bare expression without
// blanks (decision X-D5). X takes any name, since its parameters are the subcircuit's; R, C, L
// and D take only their letter's closed list below, where INST_KEY is a name outside the list.
// spec: XY-ELM-001
inst_param: SEP INST_KEY EQ _inst_value
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) inst_param
_inst_value: NUMBER | BRACE_FORMULA | QUOTE_FORMULA | BARE_FORMULA
INST_KEY.3: /[A-Za-z_]/ _XY_CHAR* /(?=[ \t]*=)/

// The closed instance-parameter lists (xm1-tasks 5.1 point 29), in any case: the names of each
// device's instance-parameter tables in the reference guide, for every level of the device, since
// the level is the model's and the grammar does not see it. R: Table 2-42 (level 1) and Table 2-44
// (level 2, the thermal resistor), §2.3.7 p203–205; C: Table 2-37, §2.3.4 p187; L: Table 2-39,
// §2.3.5 p193; D: Table 2-46 (levels 1 and 2), Table 2-48 (level 200) and Table 2-51 (level
// 2002), §2.3.8 p208–213, without `OFF`, which is d_flag. `TC=` on R, C and L is xy_tc_param,
// and the value keywords `R=`, `C=` and `L=` and the charge `Q=` are XY-RCL-001's. A
// name outside the list is recognised as INST_KEY, with the rest of its line, only to be refused
// (the `*_unlisted` rules), since Xyce stops on it ("Unrecognized parameter"). K, V and I take no
// instance parameter, so a `name=` there is a syntax error.
// spec: XY-IPN-001
r_param: SEP R_PARAM_KW EQ _inst_value
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) r_param
c_param: SEP C_PARAM_KW EQ _inst_value
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) c_param
l_param: SEP L_PARAM_KW EQ _inst_value
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) l_param
d_param: SEP D_PARAM_KW EQ _inst_value
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) d_param
r_unlisted: SEP INST_KEY REST_TEXT* NL
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) r_unlisted
c_unlisted: SEP INST_KEY REST_TEXT* NL
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) c_unlisted
l_unlisted: SEP INST_KEY REST_TEXT* NL
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) l_unlisted
d_unlisted: SEP INST_KEY REST_TEXT* NL
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) d_unlisted
R_PARAM_KW.4: /(?:a|density|dtemp|heatcapacity|l|m|outputintvars|resistivity|tc1|tc2|tce|temp|thermal_a|thermal_heatcapacity|thermal_l|w)(?=[ \t]*=)/i
C_PARAM_KW.4: /(?:age|d|dtemp|ic|l|m|tc1|tc2|temp|w)(?=[ \t]*=)/i
L_PARAM_KW.4: /(?:dtemp|ic|m|tc1|tc2|temp)(?=[ \t]*=)/i
D_PARAM_KW.4: /(?:ab|area|dtemp|ic|lg|ls|m|mult|perim|pj|temp)(?=[ \t]*=)/i

// R, C and L ([xyce-ref] §2.3.7 p201, §2.3.4 p186, §2.3.5 p191; decision 0027 item 5): the nodes,
// the model if any, then the value, then parameters. A word after the nodes is the model, and a
// number is the value (decision 0024 item 7). A word after the value is the ngspice order,
// recognised only to be refused (late_model). `TC=a,b` takes one or two values ([xyce-ref]
// §2.3.7 p202). The value may instead be written as its parameter, `R=`, `C=` or `L=` (Tables
// 2-42, 2-37 and 2-39), and a C's charge as `Q=`: each has its own keyword terminal and rule, so
// the transformer tells them from the other parameters by rule, not by name. Which value forms
// each letter requires (the geometry forms), and that no keyword or parameter is written twice,
// is checked by the transformer.
// spec: XY-RCL-001
resistor: R_NAME node node _r_body
capacitor: C_NAME node node _c_body
inductor: L_NAME node node _l_body
_r_body: model? value? (r_param | r_keyword | xy_tc_param)* (r_unlisted | NL | eol)
       | value late_model
_c_body: model? value? (c_param | c_keyword | q_charge | xy_tc_param)* (c_unlisted | NL | eol)
       | value late_model
_l_body: model? value? (l_param | l_keyword | xy_tc_param)* (l_unlisted | NL | eol)
       | value late_model
xy_tc_param: SEP TC_KW EQ _inst_value (CSEP _inst_value)?
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xy_tc_param
late_model: SEP WORD REST_TEXT* NL
r_keyword: SEP R_VALUE_KW EQ _inst_value
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) r_keyword
c_keyword: SEP C_VALUE_KW EQ _inst_value
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) c_keyword
l_keyword: SEP L_VALUE_KW EQ _inst_value
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) l_keyword
q_charge: SEP Q_KW EQ _inst_value
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) q_charge
R_VALUE_KW.4: /r(?=[ \t]*=)/i
C_VALUE_KW.4: /c(?=[ \t]*=)/i
L_VALUE_KW.4: /l(?=[ \t]*=)/i
Q_KW.4: /q(?=[ \t]*=)/i
TC_KW.4: /tc(?=[ \t]*=)/i
R_NAME.4: /[Rr]/ _XY_CHAR*
C_NAME.4: /[Cc]/ _XY_CHAR*
L_NAME.4: /[Ll]/ _XY_CHAR*

// K ([xyce-ref] §2.3.6 p194; decision 0027 item 6): one or more inductors, the coupling, then an
// optional CORE model. The transformer requires the model for one inductor.
// spec: XY-MUT-001
mutual_coupling: K_NAME inductor_ref+ value model? (NL | eol)
inductor_ref: SEP L_REF
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) inductor_ref
K_NAME.4: /[Kk]/ _XY_CHAR*
L_REF.4: /[Ll]/ _XY_CHAR*

// D ([xyce-ref] §2.3.8 p207): the model, an optional positional area, then flags (`OFF`, or
// `OFF=` and a value) and parameters.
// spec: XY-DIO-001
diode: D_NAME node node model value? (d_param | d_flag)* (d_unlisted | NL | eol)
d_flag: SEP OFF_KW
      | SEP OFF_VALUE_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
      | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) d_flag
OFF_VALUE_KW.4: /off(?=[ \t]*=)/i
D_NAME.4: /[Dd]/ _XY_CHAR*

// Transistor lines (decision 0014 item 1; decision 0031 items 1 to 4): fixed nodes, then names, the
// last of which is the model, then an optional positional area, then flags and parameters. Each
// rule spells out the name sequences its node counts allow, so the parser classifies a name only
// once it sees what follows it, as for X. A name field is a NODE_WORD, so `[s]` and `X1:n` are
// nodes; the transformer refuses a `:` in the model's place. A field written as a number is a
// node before the model and the area after it (xt_number); the transformer tells which. Right
// after the fixed nodes only a name may follow, so `off` there is a node (5.1 point 4); after a
// name, where a flag may also stand, `off` is the flag OFF_KW, as on ngspice. A number or `off`
// in the model's place is refused by the transformer. A positional area after a flag or parameter
// is recognised only to be refused (xt_late_area).
// spec: XY-XTR-001
xt_name: SEP NODE_WORD
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xt_name
xt_number: SEP NUMBER
         | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xt_number
xt_area: SEP (BRACE_FORMULA | QUOTE_FORMULA)
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xt_area
xt_late_area: SEP (NUMBER | BRACE_FORMULA | QUOTE_FORMULA) REST_TEXT* NL
            | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xt_late_area

// Q ([xyce-ref] §2.3.17 p241–243): 3 to 5 nodes (substrate, VBIC's and HICUM's thermal node), the
// model, an optional area, then `OFF` or `OFF=`, `IC=` (a comma list, at most two values, checked
// by the transformer) and the closed list: Tables 2-67 (level 1), 2-69 and 2-71 (VBIC), 2-73 (FBH),
// 2-75 (HICUM L0), 2-80 and 2-83 (MEXTRAM), §2.3.17 p247–279, without `OFF` (q_flag) and with the
// vector `IC` of IC1 and IC2.
// spec: XY-BJT-001
bjt: Q_NAME node node node xt_name _q_tail
   | Q_NAME node node node (xt_name | xt_number) xt_name _q_tail
   | Q_NAME node node node (xt_name | xt_number) (xt_name | xt_number) xt_name _q_tail
   | Q_NAME node node node xt_name (xt_number | xt_area) _q_tail
   | Q_NAME node node node (xt_name | xt_number) xt_name (xt_number | xt_area) _q_tail
   | Q_NAME node node node (xt_name | xt_number) (xt_name | xt_number) xt_name (xt_number | xt_area) _q_tail
_q_tail: (q_param | q_flag | q_ic_param)* (q_unlisted | NL | eol)
       | (q_param | q_flag | q_ic_param)+ xt_late_area
q_param: SEP Q_PARAM_KW EQ _inst_value
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) q_param
q_flag: SEP OFF_KW
      | SEP OFF_VALUE_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
      | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) q_flag
q_ic_param: SEP Q_IC_KW EQ _inst_value (CSEP _inst_value)*
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) q_ic_param
q_unlisted: SEP INST_KEY REST_TEXT* NL
          | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) q_unlisted
Q_PARAM_KW.4: /(?:area|dt|dta|dtemp|ic1|ic2|l|m|mult|n|sw_et|sw_noise|temp|trise|w)(?=[ \t]*=)/i
Q_IC_KW.4: /ic(?=[ \t]*=)/i
Q_NAME.4: /[Qq]/ _XY_CHAR*

// J and Z ([xyce-ref] §2.3.18 p286, §2.3.19 p290): exactly 3 nodes, the model, an optional area,
// then the closed list of Tables 2-86 and 2-88 (J, levels 1 and 2, p287–288) and Table 2-90 (Z,
// p291). No flag: `OFF` is recognised only to be refused (jz_off). The tail is shared with Z.
// spec: XY-JFT-001
jfet: J_NAME node node node xt_name (xt_number | xt_area)? _jz_tail
J_NAME.4: /[Jj]/ _XY_CHAR*
_jz_tail: jz_param* (jz_unlisted | jz_off | NL | eol)
        | jz_param+ xt_late_area
jz_param: SEP JZ_PARAM_KW EQ _inst_value
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) jz_param
jz_unlisted: SEP INST_KEY REST_TEXT* NL
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) jz_unlisted
jz_off: SEP OFF_KW REST_TEXT* NL
      | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) jz_off
JZ_PARAM_KW.4: /(?:area|dtemp|temp)(?=[ \t]*=)/i

// Z ([xyce-ref] §2.3.19 p290): J's line, with J's tail.
// spec: XY-MES-001
mesfet: Z_NAME node node node xt_name (xt_number | xt_area)? _jz_tail
Z_NAME.4: /[Zz]/ _XY_CHAR*

// V and I, their DC and AC parts ([xyce-ref] §2.3.10 p226, §2.3.9 p221; decision 0027 item 6):
// `[DC] value`, then `AC magnitude [phase]`, then at most one transient function (decision 0030
// item 1), in that order, with no comma and no parameter. A bare `AC` is recognised only to be
// refused (ac_bare).
// spec: XY-SRC-001
voltage_source: V_NAME node node _xsrc
current_source: I_NAME node node _xsrc
_xsrc: dc_spec? _xsrc_ac
_xsrc_ac: ac_spec value? _xsrc_end
        | ac_bare
        | _xsrc_end
_xsrc_end: _xfn | NL | eol
ac_bare: SEP AC_KW (NL | eol)
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) ac_bare
V_NAME.4: /[Vv]/ _XY_CHAR*
I_NAME.4: /[Ii]/ _XY_CHAR*

// P, the port ([xyce-ref] §2.3.11 p231, Table 2-35 p178; [xyce-ug] §7.11.2 p136; decision 0030
// item 6): V's DC part, then `port=` and `Z0=` in either order, then V's AC part and function.
// Both need their `=`, with blanks allowed around it, and take a number of the device-field
// reader or an expression in braces or quotes. The transformer requires `port=` once and `Z0=` at
// most once (a line without `port=`, which Xyce runs as a plain V source, and a repeat each have
// their own message), and the port number to be an integer literal of 1 or more. No other
// parameter, and exactly two nodes. The line is right-linear, as V's.
// spec: XY-POR-001
port_source: P_NAME node node _p0
_p0: dc_spec _p1 | _p1
_p1: p_port _p1 | p_z0 _p1 | _xsrc_ac
p_port: SEP PORT_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
      | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) p_port
p_z0: SEP Z0_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
    | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) p_z0
PORT_KW.4: /port(?=[ \t]*=)/i
Z0_KW.4: /z0(?=[ \t]*=)/i
P_NAME.4: /[Pp]/ _XY_CHAR*

// The transient functions ([xyce-ref] §2.3.10 p226–230, §2.3.9 p221–225; decision 0030 items 2
// to 5): PULSE, SIN, EXP and SFFM (xfn_name), PAT and PWL, the last field of the line. The name
// folds case and ends at a blank, `(`, `;` or the line end, so `SINE` is no name. The argument
// list stands in one pair of parentheses or in none; each argument is a number of the device-field
// reader, a braced or a quoted expression, with blanks between them (a `+` line may continue the
// list). A comma (xfn_comma) and a `name=` argument (xfn_key, xfn_key_first) are recognised only
// to be refused. After the list, outside the parentheses, PWL takes `TD=` and `R=`, and PAT takes
// `R=`; any other `name=` there is xfn_key, refused. The fields are flat in the line's rule and
// right-linear, so that nothing reduces before the line ends: the transformer gathers them into one
// SourceSpec, and checks each function's argument count, PAT's bit string in the seventh place,
// PWL's pairs and that `TD=` and `R=` stand at most once each. Without parentheses a `name=`
// field may be followed by an argument, so that the transformer refuses it at the name.
// spec: XY-SRC-002
_xfn: xfn_name _xfn_bare
    | xfn_name xfn_open xfn_first? _xfn_in
    | xfn_name xfn_open xfn_key_first _xfn_in
    | pat_name _pat_bare
    | pat_name xfn_open pat_first? _pat_in
    | pat_name xfn_open xfn_key_first _pat_in
    | pwl_name _pwl_bare
    | pwl_name xfn_open xfn_first? _pwl_in
    | pwl_name xfn_open xfn_key_first _pwl_in
    | pwl_name xpwl_file _pwl_tail
_xfn_bare: xfn_arg _xfn_bare | xfn_comma _xfn_bare | xfn_key _xfn_bare | NL | eol
_xfn_in: xfn_arg _xfn_in | xfn_comma _xfn_in | xfn_key _xfn_in | rparen _xfn_tail
_xfn_tail: xfn_key _xfn_tail | NL | eol
xfn_name: SEP XFN_KW
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xfn_name
xfn_open: LPAR
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xfn_open
xfn_first: NUMBER | BRACE_FORMULA | QUOTE_FORMULA
xfn_arg: SEP (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xfn_arg
xfn_comma: CSEP (NUMBER | BRACE_FORMULA | QUOTE_FORMULA | PAT_BITS)
xfn_key_first: INST_KEY EQ _xfn_key_value
xfn_key: SEP INST_KEY EQ _xfn_key_value
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xfn_key
_xfn_key_value: NUMBER | BRACE_FORMULA | QUOTE_FORMULA | PAT_BITS | STRING_VALUE | PWL_PATH
XFN_KW.3: /(?:pulse|sin|exp|sffm)(?![^ \t\r\n;(])/i

// PAT ([xyce-ref] §2.3.10 p227–228): its DATA, `b` or `B` and a string of 0s and 1s (PAT_BITS, held
// as an Identifier), stands where an argument may; the transformer requires it in the seventh
// place, and refuses a positional eighth argument with the hint `R=` (decision 0030 item 4).
// spec: XY-SRC-003
_pat_bare: pat_arg _pat_bare | xfn_comma _pat_bare | xfn_r _pat_bare | xfn_key _pat_bare | NL | eol
_pat_in: pat_arg _pat_in | xfn_comma _pat_in | xfn_key _pat_in | rparen _pat_tail
_pat_tail: xfn_r _pat_tail | xfn_key _pat_tail | NL | eol
pat_name: SEP PAT_KW
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pat_name
pat_first: NUMBER | BRACE_FORMULA | QUOTE_FORMULA | PAT_BITS
pat_arg: SEP (NUMBER | BRACE_FORMULA | QUOTE_FORMULA | PAT_BITS)
       | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pat_arg
xfn_r: SEP R_VALUE_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
     | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xfn_r
PAT_KW.3: /pat(?![^ \t\r\n;(])/i
PAT_BITS.4: /[bB][01]+(?![^ \t\r\n;)])/

// PWL ([xyce-ref] §2.3.10 p228–229, §6.1.12 p846): time-value pairs, or `FILE` (any case) and a
// double-quoted or bare path, held as a `FILE` parameter and never read (decision 0030 item 5);
// then `TD=` and `R=` in either order. `FILE=` is xfn_key, refused; a path in single quotes is
// recognised only to be refused with a hint; one in parentheses or followed by another field
// matches no rule.
// spec: XY-SRC-004
_pwl_bare: xfn_arg _pwl_bare | xfn_comma _pwl_bare | xfn_td _pwl_bare | xfn_r _pwl_bare
         | xfn_key _pwl_bare | NL | eol
_pwl_in: xfn_arg _pwl_in | xfn_comma _pwl_in | xfn_key _pwl_in | rparen _pwl_tail
_pwl_tail: xfn_td _pwl_tail | xfn_r _pwl_tail | xfn_key _pwl_tail | NL | eol
pwl_name: SEP PWL_NAME_KW
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) pwl_name
xpwl_file: SEP PWL_FILE_KW xpwl_path
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xpwl_file
xpwl_path: SEP (STRING_VALUE | PWL_PATH | QUOTE_FORMULA)
        | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xpwl_path
xfn_td: SEP TD_KW EQ (NUMBER | BRACE_FORMULA | QUOTE_FORMULA)
      | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) xfn_td
PWL_NAME_KW.3: /pwl(?![^ \t\r\n;(])/i
PWL_FILE_KW.4: /file(?![^ \t\r\n;])/i
PWL_PATH.2: /[^ \t\r\n;'"(){}=,]+/
TD_KW.4: /td(?=[ \t]*=)/i

// X ([xyce-ref] §2.3.33 p803; decision 0027 item 6): nodes, the subcircuit, then `PARAMS:`
// (optional) and parameters, with no comma; `M=` is an ordinary parameter. The name list is right-recursive,
// as in core.lark, so a name is classified once the parser sees what follows it.
// spec: XY-SUB-001
subckt_instance: X_NAME node (x_node | x_last)
x_node: x_name_node (x_node | x_last)
x_last: x_name_node params_marker? inst_param* (NL | eol)
x_name_node: SEP NODE_WORD
           | (SEP | TRAILING_COMMENT | INDENTED_TRAILING) x_name_node
X_NAME.4: /[Xx]/ _XY_CHAR*
