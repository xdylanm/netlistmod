  "date": "2026-11-01",
  "notes": "Expected bytes after each case's steps (tests/edits/golden.py explains the step format). Expected files were generated by the library and every diff was reviewed by hand.",
  "fixtures": {
    "set_value.expected.net": "4822cbca97e523070428885271d8c28b48a57d4e7b65e42087b0bd6a865ff577",
    "set_value_micro.expected.net": "e64b55446df2c059abfc51c32827be670dae486192d7468af3b6fc0d48c4b16f",
    "set_rser.expected.net": "c49c805f6ab8aae56c031c737eefd186b70236d00f5e586318c9c83e0a8cc6f8",
    "change_step.expected.net": "fd5096abcf8d3ba43e050a2b1223b93b42651f13646ce809f180599e9bb73b92",
    "add_step.expected.net": "088231d584d948c1e913373178c009e74257786274a2c2bf3bba6890afe03e37",
    "add_param.expected.net": "e18fc181644e37ad40b9cde5edd2d88cfc499a5d89dea5b3a86b15fdde955169",
    "set_instance_param.expected.net": "733ed19fbe5b88a40868c5960c1f60837e88b11b8196f6a8a11a9faab1110287",
    "batch.expected.net": "3a0e5a49236c55f0f4aafa86590efdb17d98b6d7499dc1e2a84ae2cf146d8fe7",
    "set_part_parameters.expected.net": "7046db0665045a4f8276a5285bc09740ee9747e942c4168dce4d1de2fe3aa412"
  },
  "cases": {
    "set_value": {
      "input": "r_divider.net",
      "steps": [
        [
          "set_value",
          "R2",
          "4k7"
        ]
      ],
      "expected": "set_value.expected.net"
    },
    "set_value_micro": {
      "input": "rc_lowpass.net",
      "steps": [
        [
          "set_value",
          "C1",
          "2u2"
        ]
      ],
      "expected": "set_value_micro.expected.net"
    },
    "set_rser": {
      "input": "simple_transformer.net",
      "steps": [
        [
          "set_param",
          "L1",
          "Rser",
          "2m"
        ]
      ],
      "expected": "set_rser.expected.net"
    },
    "change_step": {
      "input": "r_divider_sweep.net",
      "steps": [
        [
          "directives.set",
          ".step param x list 1k 2k2 4k7"
        ]
      ],
      "expected": "change_step.expected.net"
    },
    "add_step": {
      "input": "r_divider_sweep.net",
      "steps": [
        [
          "directives.set",
          ".step temp 0 50 25"
        ]
      ],
      "expected": "add_step.expected.net"
    },
    "add_param": {
      "input": "r_divider.net",
      "steps": [
        [
          "params.set",
          "rx",
          "2k2"
        ]
      ],
      "expected": "add_param.expected.net"
    },
    "set_instance_param": {
      "input": "r_divider_subckt.net",
      "steps": [
        [
          "set_instance_param",
          "X§U2",
          "rval",
          "2k2"
        ]
      ],
      "expected": "set_instance_param.expected.net"
    },
    "batch": {
      "input": "r_divider_sweep.net",
      "steps": [
        [
          "batch",
          [
            [
              "params.set",
              "x",
              "2k"
            ],
            [
              "set_value",
              "R2",
              "2k2"
            ],
            [
              "directives.set",
              ".tran 1m"
            ]
          ]
        ]
      ],
      "expected": "batch.expected.net"
    },
    "set_part_parameters": {
      "input": "LC_filter_mfg_components.net",
      "steps": [
        [
          "set_param",
          "C1",
          "Rser",
          "0.1"
        ],
        [
          "set_param",
          "L1",
          "Ipk",
          "120"
        ]
      ],
      "expected": "set_part_parameters.expected.net"
    }
  }
}
