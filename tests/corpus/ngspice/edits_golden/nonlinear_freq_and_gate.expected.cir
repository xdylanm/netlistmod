nonlinear edits (M15b)
V1 in 0 2
R1 in vx 1k
R2 vx 0 2k
Vs vx vs 0 ; sense
R3 vs 0 1k
.param k=2
E1 eo 0 TABLE {v(vx)} = (0,0) (2,4)
R4 eo 0 1k
E2 ep 0 TABLE {v(vx)} = (0 0) (2 4) (3 6)
R5 ep 0 1k
E3 eq 0 vx 0 TABLE = (0,0,2,4)
R6 eq 0 1k
G1 0 gt TABLE {v(vx)} = (0,0) (2,4m) m=2
R7 gt 0 1k
E4 er 0 FREQ {2*v(vs)}= DB (1, 6.02, 0) (1e6, 6.02, 0) (1e9, 3, 0) ; freq
R8 er 0 1k
E5 es 0 and(2) vx 0 vx 0 (0.4, 0) (0.8, 3) ; gate
R9 es 0 1k
E6 et 0 POLY(1) vx 0 0 2
R10 et 0 1k
F1 0 fp POLY(2) Vs Vs 0 1 1 m=2 ; two sources
R11 fp 0 1k
H1 hp 0 POLY(1) Vs 0 2k
R12 hp 0 1k
.op
.end
